{
  "mcpServers": {
    "tuiwright": {
      "command": "tuiwright",
      "args": ["--config", "tuiwright.toml"]
    },
    "figma": {
      "type": "http",
      "url": "https://mcp.figma.com/mcp"
    },
    "design-data": {
      "command": "npx",
      "args": ["-y", "@adobe/design-data-agent-mcp"],
      "env": {
        "DESIGN_DATA_ROOT": ".",
        "DESIGN_DATA_BIN": "sdk/target/release/design-data",
        "DESIGN_DATA_PATH": "packages/design-data/tokens",
        "DESIGN_DATA_COMPONENTS": "packages/design-data/components",
        "DESIGN_DATA_FIELDS": "packages/design-data/fields"
      }
    },
    "scout": {
      "command": "scout",
      "args": ["mcp"]
    },
    "ferrograph": {
      "command": "/bin/sh",
      "args": ["-c", "cd sdk && exec ferrograph mcp"],
      "env": {
        "FERROGRAPH_DB": ".ferrograph"
      }
    },
    "corp-jira": {
      "command": "node",
      "args": [
        "/Users/garthdb/Projects/adobe-mcp-servers/src/corp-jira/dist/index.js"
      ]
    }
  }
}
