{
  "contract": {
    "component": "axes-fixture",
    "extends": ["range"],
    "state": [
      "isDisabled",
      "xValue",
      "xMin",
      "xMax",
      "yValue",
      "yMin",
      "yMax",
      "step"
    ],
    "ranges": {
      "x": {
        "value": "xValue",
        "min": "xMin",
        "max": "xMax",
        "step": "step",
        "page": {
          "fraction": 0.1
        },
        "wrap": true
      },
      "y": {
        "value": "yValue",
        "min": "yMin",
        "max": "yMax",
        "step": "step",
        "page": {
          "fraction": 0.1
        }
      }
    },
    "parts": {
      "thumb": {
        "role": "slider",
        "focus": "tab-stop"
      }
    }
  },
  "vectors": [
    {
      "name": "an x step leaves y alone and a y step leaves x alone",
      "start": {
        "xMin": 0,
        "xMax": 360,
        "yMin": 0,
        "yMax": 100,
        "step": 1,
        "xValue": 10,
        "yValue": 20
      },
      "steps": [
        {
          "intent": "increment",
          "axis": "x"
        },
        {
          "intent": "increment",
          "axis": "y"
        },
        {
          "intent": "decrement",
          "axis": "x"
        },
        {
          "intent": "decrement",
          "axis": "y"
        }
      ],
      "expect": [
        {
          "after": 1,
          "emit": [
            {
              "change": {
                "xValue": 11
              }
            }
          ]
        },
        {
          "after": 2,
          "emit": [
            {
              "change": {
                "yValue": 21
              }
            }
          ]
        },
        {
          "after": 3,
          "emit": [
            {
              "change": {
                "xValue": 10
              }
            }
          ]
        },
        {
          "after": 4,
          "emit": [
            {
              "change": {
                "yValue": 20
              }
            }
          ]
        }
      ]
    },
    {
      "name": "each axis has its own page and bounds",
      "start": {
        "xMin": 0,
        "xMax": 360,
        "yMin": 0,
        "yMax": 10,
        "step": 1,
        "xValue": 10,
        "yValue": 20
      },
      "steps": [
        {
          "intent": "increment-page",
          "axis": "y"
        },
        {
          "intent": "increment-page",
          "axis": "x"
        },
        {
          "intent": "decrement-page",
          "axis": "y"
        }
      ],
      "expect": [
        {
          "after": 1,
          "emit": [
            {
              "change": {
                "yValue": 10
              }
            }
          ]
        },
        {
          "after": 2,
          "emit": [
            {
              "change": {
                "xValue": 46
              }
            }
          ]
        },
        {
          "after": 3,
          "emit": [
            {
              "change": {
                "yValue": 9
              }
            }
          ]
        }
      ]
    },
    {
      "name": "each axis has its own min and set-min set-max",
      "start": {
        "xMin": 20,
        "xMax": 360,
        "yMin": 30,
        "yMax": 100,
        "step": 1,
        "xValue": 100,
        "yValue": 50
      },
      "steps": [
        {
          "intent": "set-min",
          "axis": "x"
        },
        {
          "intent": "set-min",
          "axis": "y"
        },
        {
          "intent": "set-max",
          "axis": "y"
        },
        {
          "intent": "set-max",
          "axis": "x"
        }
      ],
      "expect": [
        {
          "after": 1,
          "emit": [
            {
              "change": {
                "xValue": 20
              }
            }
          ]
        },
        {
          "after": 2,
          "emit": [
            {
              "change": {
                "yValue": 30
              }
            }
          ]
        },
        {
          "after": 3,
          "emit": [
            {
              "change": {
                "yValue": 100
              }
            }
          ]
        },
        {
          "after": 4,
          "emit": [
            {
              "change": {
                "xValue": 360
              }
            }
          ]
        }
      ]
    },
    {
      "name": "a move names an axis and a position",
      "start": {
        "xMin": 0,
        "xMax": 360,
        "yMin": 0,
        "yMax": 100,
        "step": 1,
        "xValue": 10,
        "yValue": 10
      },
      "steps": [
        {
          "intent": "move",
          "axis": "x",
          "position": 0.5
        },
        {
          "intent": "move",
          "axis": "y",
          "position": 0.25
        },
        {
          "intent": "move",
          "axis": "x",
          "position": 0.25
        },
        {
          "intent": "move",
          "axis": "y",
          "position": 1
        }
      ],
      "expect": [
        {
          "after": 1,
          "emit": [
            {
              "change": {
                "xValue": 180
