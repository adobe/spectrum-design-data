        {
          "after": 4,
          "emit": [
            {
              "change": {
                "xValue": 0
              }
            }
          ]
        },
        {
          "after": 5,
          "emit": [
            {
              "change": {
                "xValue": 359
              }
            }
          ]
        }
      ]
    },
