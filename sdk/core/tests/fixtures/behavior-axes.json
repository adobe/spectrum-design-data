            }
          ]
        },
        {
          "after": 3,
          "emit": [
            {
              "change": {
                "xValue": 90
              }
            }
          ]
        },
        {
          "after": 4,
          "emit": [
            {
              "change": {
                "yValue": 100
              }
            }
          ]
        }
      ]
    },
    {
      "name": "a move to the same place, or at a clamp, raises nothing",
      "start": {
        "xMin": 0,
        "xMax": 360,
        "yMin": 0,
        "yMax": 100,
        "step": 1,
        "xValue": 180,
        "yValue": 100
