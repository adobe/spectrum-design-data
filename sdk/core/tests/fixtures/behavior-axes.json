          "intent": "increment",
          "axis": "y"
        },
        {
          "intent": "increment-page",
          "axis": "y"
        },
        {
          "intent": "set-max",
          "axis": "y"
        }
      ],
      "expect": [
        {
          "after": 1,
          "emit": []
