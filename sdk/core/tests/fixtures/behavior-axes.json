        {
          "intent": "decrement",
          "axis": "x"
        },
        {
          "intent": "decrement",
          "axis": "y"
        },
        {
          "intent": "increment",
          "axis": "x"
        },
        {
          "intent": "decrement",
          "axis": "x"
        }
      ],
      "expect": [
        {
          "after": 1,
          "emit": [
            {
              "change": {
                "xValue": 0
              }
            }
