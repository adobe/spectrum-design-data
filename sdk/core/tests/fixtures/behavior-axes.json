        {
          "after": 3,
          "emit": []
        },
        {
          "after": 4,
          "emit": []
        },
        {
          "after": 5,
          "emit": []
        }
      ]
    },
    {
      "name": "a wrapping axis steps past max to min and past min to max",
      "start": {
        "xMin": 0,
        "xMax": 360,
        "yMin": 0,
        "yMax": 100,
        "step": 1,
        "xValue": 359,
        "yValue": 0
