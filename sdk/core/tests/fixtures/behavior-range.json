{
  "contract": {
    "component": "range-fixture",
    "extends": ["range"],
    "state": [
      "isDisabled",
      "value",
      "minValue",
      "maxValue",
      "step",
      "direction"
    ],
    "range": {
      "value": "value",
      "min": "minValue",
      "max": "maxValue",
      "step": "step",
      "page": {
        "fraction": 0.1
      },
      "mirror": {
        "facet": "arrowOrder",
        "is": "mirrored"
      }
    },
    "facets": {
      "arrowOrder": {
        "from": "direction",
        "values": {
          "mirrored": "rtl",
          "natural": "ltr"
        }
      }
    },
    "parts": {
      "thumb": {
        "role": "slider",
        "focus": "tab-stop"
      }
    },
    "semantics": {
      "thumb": {
        "value": {
          "ariaState": "aria-valuenow",
          "copy": true
        }
      }
    }
  },
  "vectors": [
    {
      "name": "a whole number stays whole",
      "start": {
        "minValue": 0,
        "maxValue": 100,
        "step": 1,
        "value": 40.0
      },
      "steps": [
        {
          "input": {
            "key": "ArrowRight",
            "phase": "down"
          }
        }
      ],
      "expect": [
        {
          "after": 1,
          "emit": [
            {
              "change": {
                "value": 41.0
              }
            }
          ],
          "aria": {
            "aria-valuenow": "41"
          }
        }
      ]
    },
