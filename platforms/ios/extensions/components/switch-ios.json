{
  "$schema": "https://opensource.adobe.com/spectrum-design-data/schemas/v0/component.schema.json",
  "$id": "https://opensource.adobe.com/spectrum-design-data/schemas/v0/components/switch-ios.json",
  "specVersion": "1.0.0-draft",
  "name": "switch-ios",
  "displayName": "Switch (iOS)",
  "description": "A switch in a list row (SPSwitchRow): the label leads and the native iOS switch trails, tinted with the accent color when on. The row hugs its content here; in a list it fills the row width.",
  "meta": {
    "category": "inputs",
    "documentationUrl": "https://spectrum.adobe.com/page/switch/"
  },
  "options": {
    "label": {
      "type": "string"
    },
    "isSelected": {
      "type": "boolean",
      "default": false
    },
    "isDisabled": {
      "type": "boolean",
      "default": false
    }
  },
  "anatomy": [
    {
      "name": "container",
      "description": "List row that holds the label and the track.",
      "required": true,
      "contains": ["label", "track"]
    },
    {
      "name": "label",
      "description": "Row title, leading.",
      "required": true
    },
    {
      "name": "track",
      "description": "Capsule that is filled with the accent color when on. Holds the handle.",
      "required": true,
      "contains": ["handle"]
    },
    {
      "name": "handle",
      "description": "White knob at the start of the track when off and at the end when on.",
      "required": true
    }
  ],
  "lifecycle": {
    "introduced": "1.0.0-draft"
  },
  "accessibility": {
    "role": "switch",
    "intents": ["choose"],
    "focusable": true,
    "keyboardIntents": ["activate"],
    "wcag": [
      {
        "criterion": "2.1.1",
        "level": "A",
        "title": "Keyboard"
      },
      {
        "criterion": "4.1.2",
        "level": "A",
        "title": "Name, Role, Value"
      }
    ]
  }
}
