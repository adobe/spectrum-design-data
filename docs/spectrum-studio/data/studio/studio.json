        "$file": "foundations/opacity.json"
      },
      "color": {
        "$file": "foundations/color.json"
      },
      "spacing": {
        "$file": "foundations/spacing.json"
      },
      "size": {
        "$file": "foundations/size.json"
      },
      "radius": {
        "$file": "foundations/radius.json"
      },
      "elevation": {
        "$file": "foundations/elevation.json"
      },
      "typography": {
        "$file": "foundations/typography.json"
      },
      "icons": {
        "$file": "foundations/icons.json"
      }
    },
    "modeSets": {
      "$file": "modes/mode-sets.json"
    },
    "platforms": {
      "$file": "modes/platforms.json"
    },
    "adaptiveClaims": {},
    "tokenOverrides": {},
    "interpolations": {
      "$file": "formulas/interpolations.json"
    },
    "rules": {
      "$file": "rules/rules.json"
    },
    "components": {
      "schemaVersion": 2,
      "components": {
        "$file": "components/components.json"
      }
    },
    "scaleTypes": {
      "$file": "formulas/scale-types.json"
    },
    "browserTokenEdits": {
      "$file": "tokens/browser-token-edits.json"
    },
    "aliases": {
      "$file": "tokens/aliases.json"
    }
