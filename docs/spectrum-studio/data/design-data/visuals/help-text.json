{
  "$schema": "https://opensource.adobe.com/spectrum-design-data/schemas/v0/component-visual.schema.json",
  "specVersion": "1.0.0-draft",
  "component": "help-text",
  "root": "container",
  "sizeScale": {
    "s": 75,
    "m": 100,
    "l": 200,
    "xl": 300
  },
  "parts": {
    "container": {
      "kind": "box",
      "children": ["icon", "text"],
      "props": {
        "direction": {
          "value": "row"
        },
        "align": {
          "value": "start"
        },
        "gap": {
          "relationship": {
            "property": "space-between",
            "context": "Spacing (alert icon to text)"
          }
        }
      }
    },
    "icon": {
      "kind": "icon",
      "icon": {
        "set": "workflow",
        "name": "alert-triangle"
      },
      "visibleWhen": {
        "options": {
          "variant": "negative",
          "hideIcon": false
        }
      },
      "props": {
        "width": {
          "relationship": {
            "property": "workflow-icon-size-{sizeIndex}",
            "context": "Icon size"
          }
        },
        "height": {
          "relationship": {
            "property": "workflow-icon-size-{sizeIndex}",
            "context": "Icon size"
          }
        },
        "color": [
          {
            "relationship": {
              "property": "content-color",
              "context": "Text and alert icon (warning)"
            }
          },
          {
            "when": {
              "options": {
                "isDisabled": true
              }
            },
            "relationship": {
              "property": "content-color",
              "context": "Text and alert icon"
            }
          }
        ]
      }
    },
    "text": {
      "kind": "text",
      "props": {
        "fontSize": {
          "relationship": {
            "property": "font-size-{sizeIndex}",
            "context": "Text"
          }
        },
        "lineHeight": {
          "relationship": {
            "property": "line-height-100",
            "context": "Text"
          }
        },
        "fontWeight": {
          "relationship": {
            "property": "font-weight",
            "context": "Text"
          }
        },
        "color": [
          {
            "relationship": {
              "property": "content-color",
              "context": "Text"
            }
          },
          {
            "when": {
              "options": {
                "variant": "negative"
              }
            },
            "relationship": {
              "property": "content-color",
              "context": "Text and alert icon (warning)"
            }
          },
          {
            "when": {
              "options": {
                "isDisabled": true
              }
            },
            "relationship": {
              "property": "content-color",
              "context": "Text and alert icon"
            }
          }
        ]
      },
      "text": {
        "option": "text"
      }
    }
  }
}
