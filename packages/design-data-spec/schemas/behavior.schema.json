{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://opensource.adobe.com/spectrum-design-data/schemas/v0/behavior.schema.json",
  "title": "Component behavior contract",
  "description": "Layer 1 structural schema for a platform-agnostic behavior contract, `behaviors/<component>.json` (spec/behavior-contract.md, proposal 022). Semantic rules (options, facets, parts, intents and capabilities resolve) are Layer 2 (SPEC-118..120).",
  "type": "object",
  "required": ["component"],
  "properties": {
    "$schema": { "type": "string" },
    "$id": { "type": "string" },
    "specVersion": { "type": "string", "const": "1.0.0-draft" },
    "component": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*$",
      "description": "Name of the component declaration this contract describes."
    },
    "extends": {
      "type": "array",
      "items": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
      "uniqueItems": true,
      "description": "Shared base contracts: names of pattern files in `behaviors/patterns/` (for example `interactive`, which publishes the interaction facets)."
    },
    "state": {
      "type": "array",
      "items": { "$ref": "#/$defs/name" },
      "uniqueItems": true,
      "description": "Option ids of the component this contract owns. The option stays the source; the contract does not redeclare it."
    },
    "facets": {
      "type": "object",
      "propertyNames": { "$ref": "#/$defs/name" },
      "additionalProperties": { "$ref": "#/$defs/facet" },
      "description": "What the appearance layer may read, each derived from state, keyed by facet id (registry/facets.json)."
    },
    "parts": {
      "type": "object",
      "propertyNames": { "$ref": "#/$defs/name" },
      "additionalProperties": { "$ref": "#/$defs/part" },
      "description": "Per anatomy part: role, focus model and press behavior. Keys are anatomy part names."
    },
    "transitions": {
      "type": "array",
      "items": { "$ref": "#/$defs/transition" },
      "description": "What each intent does to state: a guarded table, never a DOM event."
    },
    "semantics": {
      "type": "object",
      "propertyNames": { "$ref": "#/$defs/name" },
      "additionalProperties": {
        "type": "object",
        "propertyNames": { "$ref": "#/$defs/name" },
        "additionalProperties": { "$ref": "#/$defs/semantic" }
      },
      "description": "Per anatomy part, facet id to the accessibility state it exposes."
    },
    "wcag": { "$ref": "#/$defs/wcag" },
    "vectors": {
      "type": "array",
      "items": { "$ref": "#/$defs/vector" },
      "description": "Conformance vectors: start state, intents, expected facets and events."
    }
  },
  "additionalProperties": false,
  "$defs": {
    "name": { "type": "string", "pattern": "^[a-zA-Z][a-zA-Z0-9-]*$" },
    "intent": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
    "capability": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
    "needs": {
      "type": "array",
      "items": { "$ref": "#/$defs/capability" },
      "uniqueItems": true,
      "description": "Capabilities (registry/capabilities.json) the platform must have for this to apply."
    },
    "wcagEntry": {
      "type": "object",
      "required": ["criterion", "level"],
      "properties": {
        "criterion": {
          "type": "string",
          "pattern": "^[1-4]\\.[0-9]+\\.[0-9]+$"
        },
        "level": { "type": "string", "enum": ["A", "AA", "AAA"] },
        "title": { "type": "string" }
      },
      "additionalProperties": false
    },
    "wcag": {
      "type": "array",
      "items": { "$ref": "#/$defs/wcagEntry" },
      "uniqueItems": true,
      "description": "Applicable WCAG 2.x success criteria, for the contract, a facet or a part."
    },
    "facet": {
      "type": "object",
      "required": ["from", "values"],
      "properties": {
        "from": {
          "oneOf": [
            { "$ref": "#/$defs/name" },
            {
              "type": "array",
              "items": { "$ref": "#/$defs/name" },
              "minItems": 1,
              "uniqueItems": true
            }
          ],
          "description": "The option id, or ids, the facet derives from."
        },
        "values": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {
            "type": ["boolean", "string", "number", "object"],
            "description": "Single source option: the option value that selects the facet value. Several: an object of option values that must all match."
          },
          "description": "Facet value id to the option value (one source) or option-to-value match (several sources) that selects it."
        },
        "order": { "const": "first match wins" },
        "wcag": { "$ref": "#/$defs/wcag" }
      },
      "additionalProperties": false
    },
    "part": {
      "type": "object",
      "properties": {
        "role": {
          "type": "string",
          "minLength": 1,
          "description": "Semantic role (spec/accessibility.md role vocabulary)."
        },
        "focus": {
          "enum": ["tab-stop", "roving", "none"],
          "description": "tab-stop: in the tab order. roving: one peer is the tab stop at a time. none: not focusable."
        },
        "press": { "$ref": "#/$defs/intent" },
        "handles": {
          "type": "array",
          "items": { "$ref": "#/$defs/intent" },
          "uniqueItems": true,
          "description": "Intents the part handles that change no state (for example `navigate-items`, `increment`). Intents that change state are `transitions`."
        },
        "wcag": { "$ref": "#/$defs/wcag" }
      },
      "additionalProperties": false
    },
    "guard": {
      "oneOf": [
        {
          "type": "object",
          "required": ["facet", "is"],
          "properties": {
            "facet": { "$ref": "#/$defs/name" },
            "is": { "type": "string" }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": ["all"],
          "properties": {
            "all": {
              "type": "array",
              "items": { "$ref": "#/$defs/guard" },
              "minItems": 1
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": ["any"],
          "properties": {
            "any": {
              "type": "array",
              "items": { "$ref": "#/$defs/guard" },
              "minItems": 1
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": ["not"],
          "properties": { "not": { "$ref": "#/$defs/guard" } },
          "additionalProperties": false
        }
      ]
    },
    "action": {
      "type": "object",
      "minProperties": 1,
      "properties": {
        "toggle": { "$ref": "#/$defs/name" },
        "raise": {
          "const": "press",
          "description": "After the transition, fire the `press` intent of the first part that declares one (`press-end` in the interactive pattern)."
        },
        "set": {
          "type": "object",
          "propertyNames": { "$ref": "#/$defs/name" },
          "additionalProperties": {
            "oneOf": [
              { "type": ["boolean", "string", "number"] },
              {
                "type": "object",
                "required": ["not"],
                "properties": { "not": { "$ref": "#/$defs/guard" } },
                "additionalProperties": false
              }
            ]
          }
        }
      },
      "additionalProperties": false
    },
    "transition": {
      "type": "object",
      "required": ["on", "do"],
      "properties": {
        "on": { "$ref": "#/$defs/intent" },
        "needs": { "$ref": "#/$defs/needs" },
        "via": {
          "enum": ["keyboard", "pointer", "programmatic"],
          "description": "The event's `via` this transition applies to (for example `keyboard` on `focus`). Absent: any."
        },
        "guard": { "$ref": "#/$defs/guard" },
        "do": { "$ref": "#/$defs/action" },
        "emit": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "semantic": {
      "type": "object",
      "required": ["ariaState", "map"],
      "properties": {
        "ariaState": { "type": "string", "minLength": 1 },
        "map": {
          "type": "object",
          "additionalProperties": { "type": "string" }
        }
      },
      "additionalProperties": false
    },
    "vector": {
      "type": "object",
      "required": ["name", "start", "steps", "expect"],
      "properties": {
        "component": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
        "name": { "type": "string", "minLength": 1 },
        "needs": { "$ref": "#/$defs/needs" },
        "start": {
          "type": "object",
          "description": "Start values of options, plus start properties such as `orientation`."
        },
        "steps": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["intent"],
            "properties": {
              "intent": { "$ref": "#/$defs/intent" },
              "via": { "enum": ["keyboard", "pointer", "programmatic"] }
            },
            "additionalProperties": false
          }
        },
        "expect": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["after"],
            "properties": {
              "after": { "type": "integer", "minimum": 1 },
              "facets": {
                "type": "object",
                "additionalProperties": { "type": ["string", "boolean"] }
              },
              "emit": {
                "type": "array",
                "items": { "type": "object", "minProperties": 1 }
              }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    }
  }
}
