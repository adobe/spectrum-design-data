{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://opensource.adobe.com/spectrum-design-data/schemas/v0/component-spec-sheet.schema.json",
  "title": "Component spec sheet (draft)",
  "description": "Draft model of a per-component spec sheet generated by `design-data spec-sheet`: pages of blocks, one block per relationship context. Renderers draw each block's scene and add no layout of their own.",
  "type": "object",
  "required": ["specVersion", "component", "size", "block", "pages"],
  "properties": {
    "$schema": { "type": "string" },
    "specVersion": { "type": "string" },
    "component": { "type": "string" },
    "displayName": { "type": "string" },
    "size": {
      "description": "Size key every block visual renders at.",
      "type": "string"
    },
    "block": {
      "description": "Block visual size in px.",
      "type": "object",
      "required": ["width", "height"],
      "properties": {
        "width": { "type": "number" },
        "height": { "type": "number" }
      },
      "additionalProperties": false
    },
    "pages": {
      "type": "array",
      "items": { "$ref": "#/$defs/page" }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "page": {
      "type": "object",
      "required": ["title", "blocks"],
      "properties": {
        "title": { "type": "string" },
        "blocks": { "type": "array", "items": { "$ref": "#/$defs/block" } }
      },
      "additionalProperties": false
    },
    "block": {
      "type": "object",
      "required": [
        "id",
        "page",
        "title",
        "render",
        "rows",
        "notes",
        "changes",
        "badges"
      ],
      "properties": {
        "id": { "type": "string" },
        "page": { "type": "string" },
        "title": {
          "description": "The relationship context string the block documents.",
          "type": "string"
        },
        "render": { "$ref": "#/$defs/render" },
        "rows": { "type": "array", "items": { "$ref": "#/$defs/row" } },
        "notes": { "type": "array", "items": { "type": "string" } },
        "changes": {
          "description": "Ids of changelog entries whose relationship context equals the title.",
          "type": "array",
          "items": { "type": "string" }
        },
        "badges": {
          "description": "Badges to show, for example \"Values updated\".",
          "type": "array",
          "items": { "type": "string" }
        }
      },
      "additionalProperties": false
    },
    "render": {
      "type": "object",
      "required": [
        "view",
        "request",
        "scene",
        "highlight",
        "markers",
        "measurements"
      ],
      "properties": {
        "view": {
          "description": "Fit of the scene into the block visual: scene px to block px scale, and the offset of the scene's origin in the block.",
          "type": "object",
          "required": ["scale", "x", "y"],
          "properties": {
            "scale": { "type": "number" },
            "x": { "type": "number" },
            "y": { "type": "number" }
          },
          "additionalProperties": false
        },
        "request": {
          "description": "The render request the scene was solved from.",
          "type": "object",
          "required": ["component", "size", "states", "options", "mode"],
          "properties": {
            "component": { "type": "string" },
            "size": { "type": "string" },
            "states": { "type": "array", "items": { "type": "string" } },
            "options": { "type": "object" },
            "mode": {
              "type": "object",
              "additionalProperties": { "type": "string" }
            }
          },
          "additionalProperties": false
        },
        "scene": {
          "description": "The resolved scene graph (`design-data render --format scene`).",
          "type": "object",
          "required": ["component", "width", "height", "nodes"]
        },
        "highlight": {
          "description": "Recipe part and prop pairs bound to the block's relationship context.",
          "type": "array",
          "items": {
            "type": "object",
            "required": ["part", "prop"],
            "properties": {
              "part": { "type": "string" },
              "prop": { "type": "string" }
            },
            "additionalProperties": false
          }
        },
        "markers": {
          "description": "Numbered markers, one per highlighted part.",
          "type": "array",
          "items": {
            "type": "object",
            "required": ["n", "part"],
            "properties": {
              "n": { "type": "integer", "minimum": 1 },
              "part": { "type": "string" }
            },
            "additionalProperties": false
          }
        },
        "measurements": {
          "description": "Scene measurements the block shows: those whose relationship context is the block title. `index` points into scene.measurements and `label` is the relationship property.",
          "type": "array",
          "items": {
            "type": "object",
            "required": ["index", "prop", "kind", "label"],
            "properties": {
              "index": { "type": "integer", "minimum": 0 },
              "prop": { "type": "string" },
              "kind": { "type": "string" },
              "label": { "type": "string" },
              "relationship": { "type": ["string", "null"] }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },
    "row": {
      "type": "object",
      "required": ["conditions", "marker", "items"],
      "properties": {
        "conditions": {
          "description": "Scalar component options the relationship records pin for this row.",
          "type": "object"
        },
        "marker": {
          "description": "Marker number the row belongs to, or null when the block has more than one marker.",
          "type": ["integer", "null"]
        },
        "items": { "type": "array", "items": { "$ref": "#/$defs/item" } }
      },
      "additionalProperties": false
    },
    "item": {
      "type": "object",
      "required": ["label", "size", "states", "token", "values"],
      "properties": {
        "label": {
          "description": "Option label from component options or the registry.",
          "type": "string"
        },
        "size": { "type": ["string", "null"] },
        "states": { "type": "array", "items": { "type": "string" } },
        "token": {
          "type": "object",
          "required": ["name", "uuid", "property"],
          "properties": {
            "name": { "type": "string" },
            "uuid": { "type": ["string", "null"] },
            "property": { "type": "string" }
          },
          "additionalProperties": false
        },
        "values": {
          "description": "Token value per scale (`desktop`, `mobile`), or `value` when the token has no scale. An alias shows as {\"alias\": name}.",
          "type": "object"
        }
      },
      "additionalProperties": false
    }
  }
}
