{
  "tokens": [],
  "components": [
    {
      "$id": "https://opensource.adobe.com/spectrum-design-data/schemas/v0/components/checkbox.json",
      "name": "checkbox",
      "displayName": "Checkbox",
      "meta": {
        "category": "inputs",
        "documentationUrl": "https://spectrum.adobe.com/page/checkbox/"
      },
      "options": {
        "isSelected": {
          "type": "boolean",
          "default": false
        },
        "isIndeterminate": {
          "type": "boolean",
          "default": false
        },
        "isDisabled": {
          "type": "boolean",
          "default": false
        }
      },
      "anatomy": [
        {
          "name": "box",
          "description": "The box.",
          "required": true
        }
      ]
    }
  ],
  "behaviors": [
    {
      "component": "checkbox",
      "extends": ["interactive"],
      "state": ["isSelected", "isIndeterminate", "isDisabled", "isGhost"],
      "facets": {
        "checked": {
          "from": ["isSelected", "isIndeterminate"],
          "values": {
            "indeterminate": {
              "isIndeterminate": true
            },
            "checked": {
              "isIndeterminate": false,
              "isSelected": true
            },
            "unchecked": {
              "isIndeterminate": false,
              "isSelected": false
            }
          },
          "order": "first match wins"
        },
        "disabled": {
          "from": "isDisabled",
          "values": {
            "false": false,
            "true": true
          }
        }
      },
      "parts": {
        "box": {
          "role": "checkbox",
          "focus": "tab-stop",
          "press": "activate",
          "wcag": [
            {
              "criterion": "4.1.2",
              "level": "A",
              "title": "Name, Role, Value"
            }
          ]
        },
        "ghost": {
          "role": "checkbox"
        }
      },
      "transitions": [
        {
          "on": "activate",
          "guard": {
            "facet": "disabled",
            "is": "false"
          },
          "do": {
            "set": {
              "isIndeterminate": false,
              "isSelected": {
                "not": {
                  "facet": "checked",
                  "is": "checked"
                }
              }
            }
          },
          "emit": "change"
        }
      ],
      "semantics": {
        "box": {
          "checked": {
            "ariaState": "aria-checked",
            "map": {
              "unchecked": "false",
              "checked": "true",
              "indeterminate": "mixed"
            }
          }
        }
      }
    }
  ],
  "behaviorPatterns": [
    {
      "pattern": "interactive",
      "publishes": ["hovered", "pressed", "focusVisible"]
    }
  ],
  "visuals": [
    {
      "component": "checkbox",
      "root": "box",
      "parts": {
        "box": {
          "kind": "box",
          "props": {
            "fill": [
              {
                "when": {
                  "facets": {
                    "checked": "indeterminate"
                  }
                },
                "value": "green"
              },
              {
                "when": {
                  "facets": {
                    "checked": "mixed"
                  }
                },
                "value": "red"
              }
            ]
          }
        }
      }
    }
  ]
}
