{
  "components": [
    {
      "$id": "https://opensource.adobe.com/spectrum-design-data/schemas/v0/components/button.json",
      "name": "button",
      "displayName": "Button",
      "meta": {
        "category": "actions"
      },
      "options": {
        "variant": {
          "type": "string",
          "values": [
            {
              "value": "primary"
            },
            {
              "value": "accent"
            }
          ]
        },
        "style": {
          "type": "string",
          "values": [
            {
              "value": "fill"
            },
            {
              "value": "outline"
            }
          ]
        },
        "isLabelHidden": {
          "type": "boolean"
        },
        "icon": {
          "type": "string"
        }
      },
      "constraints": [
        {
          "when": {
            "shape": "round"
          },
          "require": {
            "variant": ["primary", "electric"]
          },
          "severity": "error"
        }
      ]
    }
  ]
}
