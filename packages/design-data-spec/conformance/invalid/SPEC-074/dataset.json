{
  "tokens": [],
  "components": [
    {
      "$id": "https://opensource.adobe.com/spectrum-design-data/schemas/v0/components/button.json",
      "name": "button",
      "displayName": "Button",
      "meta": {
        "category": "actions",
        "documentationUrl": "https://spectrum.adobe.com/page/button/"
      },
      "states": [
        {
          "name": "hover",
          "trigger": "interaction"
        },
        {
          "name": "down",
          "trigger": "interaction"
        }
      ],
      "anatomy": [
        {
          "name": "container",
          "description": "Background.",
          "required": true
        },
        {
          "name": "focus-indicator",
          "description": "Outline drawn outside the container for keyboard focus.",
          "presentWhen": {
            "states": ["focus"]
          }
        },
        {
          "name": "checkmark",
          "description": "Mark drawn while selected.",
          "presentWhen": {
            "options": {
              "isSelected": "yes",
              "tone": true
            }
          }
        }
      ],
      "options": {
        "isSelected": {
          "type": "boolean"
        },
        "variant": {
          "type": "string",
          "values": ["accent", "negative"]
