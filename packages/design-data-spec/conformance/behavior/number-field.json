{
  "$schema": "https://opensource.adobe.com/spectrum-design-data/schemas/v0/behavior.schema.json",
  "component": "number-field",
  "pins": {
    "state": ["isDisabled", "value", "minValue", "maxValue", "step"],
    "wcag": [
      {
        "criterion": "1.3.1",
        "level": "A",
        "title": "Info and Relationships"
      },
      {
        "criterion": "2.1.1",
        "level": "A",
        "title": "Keyboard"
      },
      {
        "criterion": "4.1.2",
        "level": "A",
        "title": "Name, Role, Value"
      }
    ],
    "parts": {
      "field": {
        "role": "spinbutton",
        "focus": "tab-stop"
      },
      "in-field-button": {
        "focus": "none"
      }
    }
  },
  "vectors": [
    {
      "name": "a disabled control reads as disabled",
      "start": {
        "minValue": 0,
        "maxValue": 100,
        "step": 1,
        "value": 50,
        "isDisabled": true
      },
      "steps": [
        {
          "intent": "blur"
        }
      ],
      "expect": [
        {
          "after": 1,
          "facets": {
            "disabled": true
          }
        }
      ]
    },
    {
      "name": "an enabled control reads as enabled",
      "start": {
        "minValue": 0,
        "maxValue": 100,
        "step": 1,
        "value": 50,
        "isDisabled": false
      },
      "steps": [
        {
          "intent": "blur"
        }
      ],
      "expect": [
        {
          "after": 1,
          "facets": {
            "disabled": false
          }
        }
      ]
    },
    {
      "name": "increment and decrement step by one",
      "start": {
        "minValue": 0,
        "maxValue": 100,
        "step": 1,
        "value": 50
      },
      "steps": [
        {
          "intent": "increment"
        },
        {
          "intent": "decrement"
        },
        {
          "intent": "decrement"
        }
      ],
      "expect": [
        {
          "after": 1,
          "emit": [
            {
              "change": {
                "value": 51
              }
            }
          ]
        },
        {
          "after": 2,
          "emit": [
            {
              "change": {
                "value": 50
              }
            }
          ]
        },
        {
          "after": 3,
          "emit": [
            {
              "change": {
                "value": 49
              }
            }
          ]
        }
      ]
    },
    {
      "name": "set-min and set-max go to the bounds",
      "start": {
        "minValue": 0,
        "maxValue": 100,
        "step": 1,
        "value": 50
      },
      "steps": [
        {
          "intent": "set-min"
        },
        {
          "intent": "set-max"
        }
      ],
      "expect": [
        {
          "after": 1,
          "emit": [
            {
              "change": {
                "value": 0
              }
            }
          ]
        },
        {
          "after": 2,
          "emit": [
            {
              "change": {
                "value": 100
              }
            }
          ]
        }
      ]
    },
    {
      "name": "increment at the maximum clamps without a change",
      "start": {
        "minValue": 0,
        "maxValue": 100,
        "step": 1,
        "value": 100
      },
      "steps": [
        {
          "intent": "increment"
        },
        {
          "intent": "set-max"
        }
      ],
      "expect": [
        {
          "after": 2,
          "emit": []
        }
      ]
    },
    {
      "name": "decrement at the minimum clamps without a change",
      "start": {
        "minValue": 0,
        "maxValue": 100,
        "step": 1,
        "value": 0
      },
      "steps": [
        {
          "intent": "decrement"
        },
        {
          "intent": "set-min"
        }
      ],
      "expect": [
        {
          "after": 2,
          "emit": []
        }
      ]
    },
    {
      "name": "every value intent is ignored while disabled",
      "start": {
        "minValue": 0,
        "maxValue": 100,
        "step": 1,
        "value": 50,
        "isDisabled": true
      },
      "steps": [
        {
          "intent": "increment"
        },
        {
          "intent": "decrement"
        },
        {
          "intent": "set-min"
        },
        {
          "intent": "set-max"
        }
      ],
      "expect": [
        {
          "after": 4,
          "emit": []
        }
      ]
    },
    {
      "name": "focus follows the keyboard and loses the ring on blur",
      "start": {
        "minValue": 0,
        "maxValue": 100,
        "step": 1,
        "value": 50
      },
      "steps": [
        {
          "intent": "focus",
          "via": "keyboard"
        },
        {
          "intent": "blur"
        }
      ],
      "expect": [
        {
          "after": 1,
          "facets": {
            "focusVisible": true
          }
        },
        {
          "after": 2,
          "facets": {
            "focusVisible": false
          }
        }
      ]
    },
    {
      "name": "the value and bounds are exposed",
      "start": {
        "minValue": 0,
        "maxValue": 100,
        "step": 1,
        "value": 40
      },
      "steps": [
        {
          "intent": "blur"
        }
      ],
      "expect": [
        {
          "after": 1,
          "aria": {
            "aria-valuenow": "40",
            "aria-valuemin": "0",
            "aria-valuemax": "100"
          }
        }
      ]
    },
    {
      "name": "custom bounds are exposed",
      "start": {
        "minValue": -50,
        "maxValue": 50,
        "step": 5,
        "value": 10
      },
      "steps": [
        {
          "intent": "blur"
        }
      ],
      "expect": [
        {
          "after": 1,
          "aria": {
            "aria-valuenow": "10",
            "aria-valuemin": "-50",
            "aria-valuemax": "50"
          }
        }
      ]
    },
    {
      "name": "a keyboard step moves the exposed value",
      "start": {
        "minValue": 0,
        "maxValue": 100,
        "step": 1,
        "value": 50
      },
      "steps": [
        {
          "intent": "increment"
        }
      ],
      "expect": [
        {
          "after": 1,
          "emit": [
            {
              "change": {
                "value": 51
              }
            }
          ],
          "aria": {
            "aria-valuenow": "51"
          }
        }
      ]
    },
    {
      "name": "a step of 5 snaps and clamps",
      "start": {
        "minValue": 0,
        "maxValue": 100,
        "step": 5,
        "value": 98
      },
      "steps": [
        {
          "intent": "increment"
        },
        {
          "intent": "decrement"
        }
      ],
      "expect": [
        {
          "after": 1,
          "emit": [
            {
              "change": {
                "value": 100
              }
            }
          ]
        },
        {
          "after": 2,
          "emit": [
            {
              "change": {
                "value": 95
              }
            }
          ]
        }
      ]
    },
    {
      "name": "a larger step moves by that step",
      "start": {
        "minValue": 0,
        "maxValue": 100,
        "step": 10,
        "value": 20
      },
      "steps": [
        {
          "intent": "increment"
        },
        {
          "intent": "decrement"
        },
        {
          "intent": "decrement"
        }
      ],
      "expect": [
        {
          "after": 1,
          "emit": [
            {
              "change": {
                "value": 30
              }
            }
          ]
        },
        {
          "after": 2,
          "emit": [
            {
              "change": {
                "value": 20
              }
            }
          ]
        },
        {
          "after": 3,
          "emit": [
            {
              "change": {
                "value": 10
              }
            }
          ]
        }
      ]
    },
    {
      "name": "snapping counts from a non-zero minimum",
      "start": {
        "minValue": -50,
        "maxValue": 50,
        "step": 10,
        "value": -10
      },
      "steps": [
        {
          "intent": "increment"
        }
      ],
      "expect": [
        {
          "after": 1,
          "emit": [
            {
              "change": {
                "value": 0
              }
            }
          ]
        }
      ]
    },
    {
      "name": "a decimal step has no float noise",
      "start": {
        "minValue": 0,
        "maxValue": 1,
        "step": 0.1,
        "value": 0.2
      },
      "steps": [
        {
          "intent": "increment"
        }
      ],
      "expect": [
        {
          "after": 1,
          "emit": [
            {
              "change": {
                "value": 0.3
              }
            }
          ]
        }
      ]
    },
    {
      "name": "an unset value exposes no aria-valuenow",
      "start": {
        "minValue": 0,
        "maxValue": 100,
        "step": 1
      },
      "steps": [
        {
          "intent": "blur"
        }
      ],
      "expect": [
        {
          "after": 1,
          "aria": {
            "aria-valuenow": null
          }
        }
      ]
    },
    {
      "name": "an unset minValue is unbounded, so decrement below 0 does not clamp",
      "start": {
        "maxValue": 100,
        "step": 1,
        "value": 0
      },
      "steps": [
        {
          "intent": "decrement"
        }
      ],
      "expect": [
        {
          "after": 1,
          "emit": [
            {
              "change": {
                "value": -1
              }
            }
          ]
        }
      ]
    },
    {
      "name": "an unset minValue is unbounded, so a negative value steps up by one",
      "start": {
        "maxValue": 100,
        "step": 1,
        "value": -5
      },
      "steps": [
        {
          "intent": "increment"
        }
      ],
      "expect": [
        {
          "after": 1,
          "emit": [
            {
              "change": {
                "value": -4
              }
            }
          ]
        }
      ]
    },
    {
      "name": "an unset minValue has nothing to go to, so set-min changes nothing",
      "start": {
        "maxValue": 100,
        "step": 1,
        "value": 7
      },
      "steps": [
        {
          "intent": "set-min"
        }
      ],
      "expect": [
        {
          "after": 1,
          "emit": []
        }
      ]
    },
    {
      "name": "an unset maxValue is unbounded, so increment above 100 does not clamp",
      "start": {
        "minValue": 0,
        "step": 1,
        "value": 100
      },
      "steps": [
        {
          "intent": "increment"
        }
      ],
      "expect": [
        {
          "after": 1,
          "emit": [
            {
              "change": {
                "value": 101
              }
            }
          ]
        }
      ]
    },
    {
      "name": "an unset maxValue is unbounded, so a value of 500 steps up to 501",
      "start": {
        "minValue": 0,
        "step": 1,
        "value": 500
      },
      "steps": [
        {
          "intent": "increment"
        }
      ],
      "expect": [
        {
          "after": 1,
          "emit": [
            {
              "change": {
                "value": 501
              }
            }
          ]
        }
      ]
    },
    {
      "name": "an unset maxValue has nothing to go to, so set-max changes nothing",
      "start": {
        "minValue": 0,
        "step": 1,
        "value": 50
      },
      "steps": [
        {
          "intent": "set-max"
        }
      ],
      "expect": [
        {
          "after": 1,
          "emit": []
        }
      ]
    },
    {
      "name": "with both bounds unset a step snaps from 0",
      "start": {
        "step": 5,
        "value": 3
      },
      "steps": [
        {
          "intent": "increment"
        }
      ],
      "expect": [
        {
          "after": 1,
          "emit": [
            {
              "change": {
                "value": 10
              }
            }
          ]
        }
      ]
    },
    {
      "name": "with min set and max unset a step snaps from the minimum",
      "start": {
        "minValue": 2,
        "step": 5,
        "value": 2
      },
      "steps": [
        {
          "intent": "increment"
        }
      ],
      "expect": [
        {
          "after": 1,
          "emit": [
            {
              "change": {
                "value": 7
              }
            }
          ]
        }
      ]
    },
    {
      "name": "an unset minValue still clamps at a set maxValue",
      "start": {
        "maxValue": 10,
        "step": 1,
        "value": 10
      },
      "steps": [
        {
          "intent": "increment"
        }
      ],
      "expect": [
        {
          "after": 1,
          "emit": []
        }
      ]
    },
    {
      "name": "an unset value goes to the minimum on increment",
      "start": {
        "minValue": 5,
        "maxValue": 100,
        "step": 1
      },
      "steps": [
        {
          "intent": "increment"
        }
      ],
      "expect": [
        {
          "after": 1,
          "emit": [
            {
              "change": {
                "value": 5
              }
            }
          ]
        }
      ]
    },
    {
      "name": "an unset value goes to 0 on increment without a minimum",
      "start": {
        "maxValue": 100,
        "step": 1
      },
      "steps": [
        {
          "intent": "increment"
        }
      ],
      "expect": [
        {
          "after": 1,
          "emit": [
            {
              "change": {
                "value": 0
              }
            }
          ]
        }
      ]
    },
    {
      "name": "an unset value goes to the maximum on decrement",
      "start": {
        "minValue": 0,
        "maxValue": 100,
        "step": 1
      },
      "steps": [
        {
          "intent": "decrement"
        }
      ],
      "expect": [
        {
          "after": 1,
          "emit": [
            {
              "change": {
                "value": 100
              }
            }
          ]
        }
      ]
    },
    {
      "name": "an unset value goes to 0 on decrement without a maximum",
      "start": {
        "minValue": 0,
        "step": 1
      },
      "steps": [
        {
          "intent": "decrement"
        }
      ],
      "expect": [
        {
          "after": 1,
          "emit": [
            {
              "change": {
                "value": 0
              }
            }
          ]
        }
      ]
    },
    {
      "name": "an unset value with only a minimum goes no lower than it on decrement",
      "start": {
        "minValue": 5,
        "step": 1
      },
      "steps": [
        {
          "intent": "decrement"
        }
      ],
      "expect": [
        {
          "after": 1,
          "emit": [
            {
              "change": {
                "value": 5
              }
            }
          ]
        }
      ]
    },
    {
      "name": "an unset value with only a maximum goes no higher than it on increment",
      "start": {
        "maxValue": -5,
        "step": 1
      },
      "steps": [
        {
          "intent": "increment"
        }
      ],
      "expect": [
        {
          "after": 1,
          "emit": [
            {
              "change": {
                "value": -5
              }
            }
          ]
        }
      ]
    },
    {
      "name": "an unset value snaps the maximum to the step on decrement",
      "start": {
        "minValue": 5,
        "maxValue": 100,
        "step": 3
      },
      "steps": [
        {
          "intent": "decrement"
        }
      ],
      "expect": [
        {
          "after": 1,
          "emit": [
            {
              "change": {
                "value": 98
              }
            }
          ]
        }
      ]
    },
    {
      "name": "an unset value goes to the minimum on increment with a step",
      "start": {
        "minValue": 5,
        "maxValue": 100,
        "step": 3
      },
      "steps": [
        {
          "intent": "increment"
        }
      ],
      "expect": [
        {
          "after": 1,
          "emit": [
            {
              "change": {
                "value": 5
              }
            }
          ]
        }
      ]
    },
    {
      "name": "an unset value snaps a decimal step on decrement",
      "start": {
        "minValue": 0,
        "maxValue": 1,
        "step": 0.3
      },
      "steps": [
        {
          "intent": "decrement"
        }
      ],
      "expect": [
        {
          "after": 1,
          "emit": [
            {
              "change": {
                "value": 0.9
              }
            }
          ]
        }
      ]
    },
    {
      "name": "an unset value with an off-step minimum stays on it on increment",
      "start": {
        "minValue": 2.5,
        "maxValue": 10,
        "step": 2
      },
      "steps": [
        {
          "intent": "increment"
        }
      ],
      "expect": [
        {
          "after": 1,
          "emit": [
            {
              "change": {
                "value": 2.5
              }
            }
          ]
        }
      ]
    },
    {
      "name": "an unset value with only an off-step maximum steps inside it on increment",
      "start": {
        "maxValue": -4,
        "step": 3
      },
      "steps": [
        {
          "intent": "increment"
        }
      ],
      "expect": [
        {
          "after": 1,
          "emit": [
            {
              "change": {
                "value": -6
              }
            }
          ]
        }
      ]
    },
    {
      "name": "an unset value leaves set-min with no change",
      "start": {
        "minValue": 0,
        "maxValue": 100,
        "step": 1
      },
      "steps": [
        {
          "intent": "set-min"
        }
      ],
      "expect": [
        {
          "after": 1,
          "emit": []
        }
      ]
    },
    {
      "name": "an unset value goes to the maximum on set-max",
      "start": {
        "minValue": 0,
        "maxValue": 100,
        "step": 1
      },
      "steps": [
        {
          "intent": "set-max"
        }
      ],
      "expect": [
        {
          "after": 1,
          "emit": [
            {
              "change": {
                "value": 100
              }
            }
          ]
        }
      ]
    }
  ]
}
