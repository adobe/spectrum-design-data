  "vectors": [
    {
      "name": "the group raises no event of its own: focus, press and pointer steps emit nothing",
      "start": {},
      "steps": [
        {
          "intent": "focus",
          "via": "keyboard"
        },
        {
          "intent": "press-start"
        },
        {
          "intent": "press-end"
        },
        {
          "intent": "pointer-enter"
        },
        {
          "intent": "blur"
        }
      ],
      "expect": [
        {
          "after": 1,
          "emit": []
        },
        {
          "after": 2,
          "emit": []
        },
        {
          "after": 3,
          "emit": []
        },
        {
          "after": 4,
          "emit": []
        },
        {
          "after": 5,
          "emit": []
        }
      ]
    },
    {
      "name": "single, empty not allowed: activating another swatch moves the selection",
      "start": {
        "enableSelection": true,
        "selectionMode": "single",
        "items": [
          {
            "isSelected": true
          },
          {
            "isSelected": false
          },
          {
            "isSelected": false
          }
        ]
      },
      "steps": [
        {
          "item": 2,
          "intent": "activate"
        }
      ],
      "expect": [
        {
          "items": [
            {
              "selected": "unselected"
            },
            {
              "selected": "unselected"
            },
            {
              "selected": "selected"
            }
          ],
          "emit": [
            {
              "change": {
                "isSelected": [2]
              }
            }
          ],
          "after": 1
        }
      ]
    },
