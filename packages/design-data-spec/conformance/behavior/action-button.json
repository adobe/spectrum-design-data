{
  "$schema": "https://opensource.adobe.com/spectrum-design-data/schemas/v0/behavior.schema.json",
  "component": "action-button",
  "pins": {
    "state": ["isDisabled", "isSelected", "isPending"],
    "wcag": [
      {
        "criterion": "2.1.1",
        "level": "A",
        "title": "Keyboard"
      },
      {
        "criterion": "4.1.2",
        "level": "A",
        "title": "Name, Role, Value"
      }
    ],
    "parts": {
      "container": {
        "role": "button",
        "focus": "tab-stop",
        "press": "activate"
      }
    }
  },
  "vectors": [
    {
      "name": "activate raises press",
      "start": {},
      "steps": [
        {
          "intent": "activate"
        }
      ],
      "expect": [
        {
          "after": 1,
          "facets": {
            "disabled": false
          },
          "emit": [
            {
              "press": {
                "isSelected": true
              }
            }
          ]
        }
      ]
    },
    {
      "name": "disabled ignores activation",
      "start": {
        "isDisabled": true
      },
      "steps": [
        {
          "intent": "activate"
        }
      ],
      "expect": [
        {
          "after": 1,
          "facets": {
            "disabled": true
          },
          "emit": []
        }
      ]
    },
    {
      "name": "a completed press raises press",
      "start": {},
      "steps": [
        {
          "intent": "press-start"
        },
        {
          "intent": "press-end"
        }
      ],
      "expect": [
        {
          "after": 1,
          "facets": {
            "pressed": true
          },
          "emit": []
        },
        {
          "after": 2,
          "facets": {
            "pressed": false
          },
          "emit": [
            {
              "press": {
                "isSelected": true
              }
            }
          ]
        }
      ]
    },
    {
      "name": "a cancelled press raises nothing",
      "start": {},
      "steps": [
        {
          "intent": "press-start"
        },
        {
          "intent": "press-cancel"
        }
      ],
      "expect": [
        {
          "after": 2,
          "facets": {
            "pressed": false
          },
          "emit": []
        }
      ]
    },
    {
      "name": "press-end without press-start raises nothing",
      "start": {},
      "steps": [
        {
          "intent": "press-end"
        }
      ],
      "expect": [
        {
          "after": 1,
          "facets": {
            "pressed": false
          },
          "emit": []
        }
      ]
    },
    {
      "name": "press-end after press-cancel raises nothing",
      "start": {},
      "steps": [
        {
          "intent": "press-start"
        },
        {
          "intent": "press-cancel"
        },
        {
          "intent": "press-end"
        }
      ],
      "expect": [
        {
          "after": 3,
          "facets": {
            "pressed": false
          },
          "emit": []
        }
      ]
    },
    {
      "name": "keyboard focus shows focus-visible",
      "needs": ["keyboard"],
      "start": {},
      "steps": [
        {
          "intent": "focus",
          "via": "keyboard"
        }
      ],
      "expect": [
        {
          "after": 1,
          "facets": {
            "focusVisible": true
          }
        }
      ]
    },
    {
      "name": "pointer focus does not show focus-visible",
      "start": {},
      "steps": [
        {
          "intent": "focus",
          "via": "pointer"
        }
      ],
      "expect": [
        {
          "after": 1,
          "facets": {
            "focusVisible": false
          }
        }
      ]
    },
    {
      "name": "hover follows the pointer",
      "needs": ["pointer-hover"],
      "start": {},
      "steps": [
        {
          "intent": "pointer-enter"
        },
        {
          "intent": "pointer-leave"
        }
      ],
      "expect": [
        {
          "after": 1,
          "facets": {
            "hovered": true
          }
        },
        {
          "after": 2,
          "facets": {
            "hovered": false
          }
        }
      ]
    },
    {
      "name": "disabled takes no focus",
      "needs": ["keyboard"],
      "start": {
        "isDisabled": true
      },
      "steps": [
        {
          "intent": "focus",
          "via": "keyboard"
        }
      ],
      "expect": [
        {
          "after": 1,
          "facets": {
            "focusVisible": false,
            "disabled": true
          }
        }
      ]
    },
    {
      "name": "disabled takes no press",
      "start": {
        "isDisabled": true
      },
      "steps": [
        {
          "intent": "press-start"
        },
        {
          "intent": "press-end"
        }
      ],
      "expect": [
        {
          "after": 2,
          "facets": {
            "pressed": false
          },
          "emit": []
        }
      ]
    },
    {
      "name": "disabled takes no hover",
      "needs": ["pointer-hover"],
      "start": {
        "isDisabled": true
      },
      "steps": [
        {
          "intent": "pointer-enter"
        }
      ],
      "expect": [
        {
          "after": 1,
          "facets": {
            "hovered": false
          }
        }
      ]
    },
    {
      "name": "activate selects an unselected button",
      "start": {
        "isSelected": false
      },
      "steps": [
        {
          "intent": "activate"
        }
      ],
      "expect": [
        {
          "after": 1,
          "facets": {
            "selected": "selected"
          },
          "emit": [
            {
              "press": {
                "isSelected": true
              }
            }
          ]
        }
      ]
    },
    {
      "name": "activate deselects a selected button",
      "start": {
        "isSelected": true
      },
      "steps": [
        {
          "intent": "activate"
        }
      ],
      "expect": [
        {
          "after": 1,
          "facets": {
            "selected": "unselected"
          },
          "emit": [
            {
              "press": {
                "isSelected": false
              }
            }
          ]
        }
      ]
    },
    {
      "name": "a completed press toggles selection",
      "start": {
        "isSelected": false
      },
      "steps": [
        {
          "intent": "press-start"
        },
        {
          "intent": "press-end"
        }
      ],
      "expect": [
        {
          "after": 1,
          "facets": {
            "pressed": true,
            "selected": "unselected"
          },
          "emit": []
        },
        {
          "after": 2,
          "facets": {
            "pressed": false,
            "selected": "selected"
          },
          "emit": [
            {
              "press": {
                "isSelected": true
              }
            }
          ]
        }
      ]
    },
    {
      "name": "pressing a selected button deselects it",
      "start": {
        "isSelected": true
      },
      "steps": [
        {
          "intent": "press-start"
        },
        {
          "intent": "press-end"
        }
      ],
      "expect": [
        {
          "after": 1,
          "facets": {
            "pressed": true,
            "selected": "selected"
          },
          "emit": []
        },
        {
          "after": 2,
          "facets": {
            "pressed": false,
            "selected": "unselected"
          },
          "emit": [
            {
              "press": {
                "isSelected": false
              }
            }
          ]
        }
      ]
    },
    {
      "name": "a cancelled press leaves selection",
      "start": {
        "isSelected": true
      },
      "steps": [
        {
          "intent": "press-start"
        },
        {
          "intent": "press-cancel"
        }
      ],
      "expect": [
        {
          "after": 2,
          "facets": {
            "pressed": false,
            "selected": "selected"
          },
          "emit": []
        }
      ]
    },
    {
      "name": "disabled keeps a selected button selected",
      "start": {
        "isDisabled": true,
        "isSelected": true
      },
      "steps": [
        {
          "intent": "activate"
        }
      ],
      "expect": [
        {
          "after": 1,
          "facets": {
            "disabled": true,
            "selected": "selected"
          },
          "emit": []
        }
      ]
    },
    {
      "name": "pending blocks activation",
      "start": {
        "isPending": true
      },
      "steps": [
        {
          "intent": "activate"
        }
      ],
      "expect": [
        {
          "after": 1,
          "facets": {
            "pending": true,
            "selected": "unselected"
          },
          "emit": []
        }
      ]
    },
    {
      "name": "pending blocks a completed press",
      "start": {
        "isPending": true
      },
      "steps": [
        {
          "intent": "press-start"
        },
        {
          "intent": "press-end"
        }
      ],
      "expect": [
        {
          "after": 2,
          "facets": {
            "pending": true,
            "pressed": false
          },
          "emit": []
        }
      ]
    },
    {
      "name": "pending keeps a selected button selected",
      "start": {
        "isPending": true,
        "isSelected": true
      },
      "steps": [
        {
          "intent": "activate"
        }
      ],
      "expect": [
        {
          "after": 1,
          "facets": {
            "pending": true,
            "selected": "selected"
          },
          "emit": []
        }
      ]
    },
    {
      "name": "activation works again once pending ends",
      "start": {
        "isPending": false
      },
      "steps": [
        {
          "intent": "activate"
        }
      ],
      "expect": [
        {
          "after": 1,
          "facets": {
            "pending": false,
            "selected": "selected"
          },
          "emit": [
            {
              "press": {
                "isSelected": true
              }
            }
          ]
        }
      ]
    }
  ]
}
