{
  "$schema": "https://opensource.adobe.com/spectrum-design-data/schemas/v0/behavior.schema.json",
  "component": "link",
  "pins": {
    "state": [],
    "parts": {
      "container": {
        "role": "link",
        "focus": "tab-stop",
        "press": "activate"
      }
    }
  },
  "vectors": [
    {
      "name": "activate raises press",
      "start": {},
      "steps": [
        {
          "intent": "activate"
        }
      ],
      "expect": [
        {
          "after": 1,
          "facets": {},
          "emit": [
            {
              "press": {}
            }
          ]
        }
      ]
    },
    {
      "name": "a completed press raises press",
      "start": {},
      "steps": [
        {
          "intent": "press-start"
        },
        {
          "intent": "press-end"
        }
      ],
      "expect": [
        {
          "after": 1,
          "facets": {
            "pressed": true
          },
          "emit": []
        },
        {
          "after": 2,
          "facets": {
            "pressed": false
          },
          "emit": [
            {
              "press": {}
            }
          ]
        }
      ]
    },
    {
      "name": "a cancelled press raises nothing",
      "start": {},
      "steps": [
        {
          "intent": "press-start"
        },
        {
          "intent": "press-cancel"
        }
      ],
      "expect": [
        {
          "after": 2,
          "facets": {
            "pressed": false
          },
          "emit": []
        }
      ]
    },
    {
      "name": "press-end without press-start raises nothing",
      "start": {},
      "steps": [
        {
          "intent": "press-end"
        }
      ],
      "expect": [
        {
          "after": 1,
          "facets": {
            "pressed": false
          },
          "emit": []
        }
      ]
    },
    {
      "name": "press-end after press-cancel raises nothing",
      "start": {},
      "steps": [
        {
          "intent": "press-start"
        },
        {
          "intent": "press-cancel"
        },
        {
          "intent": "press-end"
        }
      ],
      "expect": [
        {
          "after": 3,
          "facets": {
            "pressed": false
          },
          "emit": []
        }
      ]
    },
    {
      "name": "keyboard focus shows focus-visible",
      "needs": ["keyboard"],
      "start": {},
      "steps": [
        {
          "intent": "focus",
          "via": "keyboard"
        }
      ],
      "expect": [
        {
          "after": 1,
          "facets": {
            "focusVisible": true
          }
        }
      ]
    },
    {
      "name": "pointer focus does not show focus-visible",
      "start": {},
      "steps": [
        {
          "intent": "focus",
          "via": "pointer"
        }
      ],
      "expect": [
        {
          "after": 1,
          "facets": {
            "focusVisible": false
          }
        }
      ]
    },
    {
      "name": "hover follows the pointer",
      "needs": ["pointer-hover"],
      "start": {},
      "steps": [
        {
          "intent": "pointer-enter"
        },
        {
          "intent": "pointer-leave"
        }
      ],
      "expect": [
        {
          "after": 1,
          "facets": {
            "hovered": true
          }
        },
        {
          "after": 2,
          "facets": {
            "hovered": false
          }
        }
      ]
    }
  ]
}
