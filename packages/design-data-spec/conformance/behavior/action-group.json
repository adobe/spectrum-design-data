  "vectors": [
    {
      "name": "the group raises no event of its own: focus, press and pointer steps emit nothing",
      "start": {},
      "steps": [
        {
          "intent": "focus",
          "via": "keyboard"
        },
        {
          "intent": "press-start"
        },
        {
          "intent": "press-end"
        },
        {
          "intent": "pointer-enter"
        },
        {
          "intent": "blur"
        }
      ],
      "expect": [
        {
          "after": 1,
          "emit": []
        },
        {
          "after": 2,
          "emit": []
        },
        {
          "after": 3,
          "emit": []
        },
        {
          "after": 4,
          "emit": []
        },
        {
          "after": 5,
          "emit": []
        }
      ]
    },
    {
      "name": "a horizontal group exposes aria-orientation horizontal (the default option value is the adapter's)",
      "start": {
        "orientation": "horizontal"
      },
      "steps": [
        {
          "intent": "blur"
        }
      ],
      "expect": [
        {
          "after": 1,
          "facets": {
            "orientation": "horizontal",
            "arrowOrder": "natural"
          },
          "aria": {
            "aria-orientation": "horizontal"
          }
        }
      ]
    },
