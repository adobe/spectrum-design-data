{
  "$schema": "https://opensource.adobe.com/spectrum-design-data/schemas/v0/behavior.schema.json",
  "component": "switch",
  "pins": {
    "state": ["isSelected", "isDisabled", "isReadOnly"],
    "wcag": [
      {
        "criterion": "2.1.1",
        "level": "A",
        "title": "Keyboard"
      },
      {
        "criterion": "4.1.2",
        "level": "A",
        "title": "Name, Role, Value"
      }
    ],
    "parts": {
      "track": {
        "role": "switch",
        "focus": "tab-stop",
        "press": "activate"
      }
    }
  },
  "vectors": [
    {
      "name": "activate turns it on",
      "start": {
        "isSelected": false
      },
      "steps": [
        {
          "intent": "activate"
        }
      ],
      "expect": [
        {
          "after": 1,
          "facets": {
            "checked": "checked"
          },
          "emit": [
            {
              "change": {
                "isSelected": true
              }
            }
          ]
        }
      ]
    },
    {
      "name": "activate turns it off",
      "start": {
        "isSelected": true
      },
      "steps": [
        {
          "intent": "activate"
        }
      ],
      "expect": [
        {
          "after": 1,
          "facets": {
            "checked": "unchecked"
          },
          "emit": [
            {
              "change": {
                "isSelected": false
              }
            }
          ]
        }
      ]
    },
    {
      "name": "keyboard focus shows focus-visible",
      "needs": ["keyboard"],
      "start": {
        "isSelected": false
      },
      "steps": [
        {
          "intent": "focus",
          "via": "keyboard"
        }
      ],
      "expect": [
        {
          "after": 1,
          "facets": {
            "focusVisible": true,
            "checked": "unchecked"
          }
        }
      ]
    },
    {
      "name": "pointer focus does not show focus-visible",
      "start": {
        "isSelected": false
      },
      "steps": [
        {
          "intent": "focus",
          "via": "pointer"
        }
      ],
      "expect": [
        {
          "after": 1,
          "facets": {
            "focusVisible": false
          }
        }
      ]
    },
    {
      "name": "activate after keyboard focus toggles",
      "needs": ["keyboard"],
      "start": {
        "isSelected": false
      },
      "steps": [
        {
          "intent": "focus",
          "via": "keyboard"
        },
        {
          "intent": "activate"
        }
      ],
      "expect": [
        {
          "after": 1,
          "facets": {
            "focusVisible": true,
            "checked": "unchecked"
          }
        },
        {
          "after": 2,
          "facets": {
            "checked": "checked"
          },
          "emit": [
            {
              "change": {
                "isSelected": true
              }
            }
          ]
        }
      ]
    },
    {
      "name": "a completed press toggles",
      "start": {
        "isSelected": false
      },
      "steps": [
        {
          "intent": "press-start"
        },
        {
          "intent": "press-end"
        }
      ],
      "expect": [
        {
          "after": 1,
          "facets": {
            "pressed": true,
            "checked": "unchecked"
          }
        },
        {
          "after": 2,
          "facets": {
            "pressed": false,
            "checked": "checked"
          },
          "emit": [
            {
              "change": {
                "isSelected": true
              }
            }
          ]
        }
      ]
    },
    {
      "name": "a cancelled press does not toggle",
      "start": {
        "isSelected": false
      },
      "steps": [
        {
          "intent": "press-start"
        },
        {
          "intent": "press-cancel"
        }
      ],
      "expect": [
        {
          "after": 2,
          "facets": {
            "pressed": false,
            "checked": "unchecked"
          },
          "emit": []
        }
      ]
    },
    {
      "name": "hover follows the pointer",
      "needs": ["pointer-hover"],
      "start": {
        "isSelected": false
      },
      "steps": [
        {
          "intent": "pointer-enter"
        },
        {
          "intent": "pointer-leave"
        }
      ],
      "expect": [
        {
          "after": 1,
          "facets": {
            "hovered": true
          }
        },
        {
          "after": 2,
          "facets": {
            "hovered": false
          }
        }
      ]
    },
    {
      "name": "disabled ignores activation",
      "start": {
        "isSelected": false,
        "isDisabled": true
      },
      "steps": [
        {
          "intent": "activate"
        }
      ],
      "expect": [
        {
          "after": 1,
          "facets": {
            "checked": "unchecked",
            "disabled": true
          },
          "emit": []
        }
      ]
    },
    {
      "name": "disabled takes no focus",
      "needs": ["keyboard"],
      "start": {
        "isSelected": false,
        "isDisabled": true
      },
      "steps": [
        {
          "intent": "focus",
          "via": "keyboard"
        }
      ],
      "expect": [
        {
          "after": 1,
          "facets": {
            "focusVisible": false,
            "disabled": true
          }
        }
      ]
    },
    {
      "name": "read-only keeps focus and ignores activation",
      "needs": ["keyboard"],
      "start": {
        "isSelected": false,
        "isReadOnly": true
      },
      "steps": [
        {
          "intent": "focus",
          "via": "keyboard"
        },
        {
          "intent": "activate"
        }
      ],
      "expect": [
        {
          "after": 1,
          "facets": {
            "focusVisible": true,
            "readOnly": true
          }
        },
        {
          "after": 2,
          "facets": {
            "checked": "unchecked"
          },
          "emit": []
        }
      ]
    },
    {
      "name": "read-only still shows pressed on press-start",
      "start": {
        "isSelected": false,
        "isReadOnly": true
      },
      "steps": [
        {
          "intent": "press-start"
        },
        {
          "intent": "press-end"
        }
      ],
      "expect": [
        {
          "after": 1,
          "facets": {
            "pressed": true,
            "readOnly": true,
            "checked": "unchecked"
          },
          "emit": []
        },
        {
          "after": 2,
          "facets": {
            "pressed": false,
            "checked": "unchecked"
          },
          "emit": []
        }
      ]
    },
    {
      "name": "read-only still shows hover",
      "needs": ["pointer-hover"],
      "start": {
        "isSelected": false,
        "isReadOnly": true
      },
      "steps": [
        {
          "intent": "pointer-enter"
        }
      ],
      "expect": [
        {
          "after": 1,
          "facets": {
            "hovered": true
          }
        }
      ]
    },
    {
      "name": "press-end without press-start does not activate",
      "start": {
        "isSelected": false
      },
      "steps": [
        {
          "intent": "press-end"
        }
      ],
      "expect": [
        {
          "after": 1,
          "facets": {
            "pressed": "false",
            "checked": "unchecked"
          },
          "emit": []
        }
      ]
    },
    {
      "name": "press-end after press-cancel does not activate",
      "start": {
        "isSelected": false
      },
      "steps": [
        {
          "intent": "press-start"
        },
        {
          "intent": "press-cancel"
        },
        {
          "intent": "press-end"
        }
      ],
      "expect": [
        {
          "after": 2,
          "facets": {
            "pressed": "false"
          }
        },
        {
          "after": 3,
          "facets": {
            "pressed": "false",
            "checked": "unchecked"
          },
          "emit": []
        }
      ]
    }
  ]
}
