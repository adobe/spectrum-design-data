  "vectors": [
    {
      "name": "Enter presses on key down",
      "needs": ["keyboard"],
      "start": {},
      "steps": [
        {
          "input": {
            "key": "Enter",
            "phase": "down"
          }
        },
        {
          "input": {
            "key": "Enter",
            "phase": "up"
          }
        }
      ],
      "expect": [
        {
          "after": 1,
          "facets": {
            "pressed": false
          },
          "emit": [
            {
              "press": {}
            }
          ]
        },
        {
          "after": 2,
          "facets": {},
          "emit": []
        }
      ],
      "emitOptions": "listed"
    },
