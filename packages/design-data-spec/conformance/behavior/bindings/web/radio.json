{
  "platform": "web",
  "role": "radio",
  "vectors": [
    {
      "name": "Space selects on key up, not on key down",
      "needs": ["keyboard"],
      "start": {
        "isSelected": false
      },
      "steps": [
        {
          "input": {
            "key": "Space",
            "phase": "down"
          }
        },
        {
          "input": {
            "key": "Space",
            "phase": "up"
          }
        }
      ],
      "expect": [
        {
          "after": 1,
          "facets": {
            "checked": "unchecked",
            "pressed": true
          },
          "emit": []
        },
        {
          "after": 2,
          "facets": {
            "checked": "checked"
          },
          "emit": [
            {
              "change": {
                "isSelected": true
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Space on a selected radio changes nothing",
      "needs": ["keyboard"],
      "start": {
        "isSelected": true
      },
      "steps": [
        {
          "input": {
            "key": "Space",
            "phase": "down"
          }
        },
        {
          "input": {
            "key": "Space",
            "phase": "up"
          }
        }
      ],
      "expect": [
        {
          "after": 2,
          "facets": {
            "checked": "checked"
          },
          "emit": []
        }
      ]
    },
    {
      "name": "Space ignores a disabled radio",
      "needs": ["keyboard"],
      "start": {
        "isSelected": false,
        "isDisabled": true
      },
      "steps": [
        {
          "input": {
            "key": "Space",
            "phase": "down"
          }
        },
        {
          "input": {
            "key": "Space",
            "phase": "up"
          }
        }
      ],
      "expect": [
        {
          "after": 2,
          "facets": {
            "checked": "unchecked"
          },
          "emit": []
        }
      ]
    },
    {
      "name": "Enter does not select",
      "needs": ["keyboard"],
      "start": {
        "isSelected": false
      },
      "steps": [
        {
          "input": {
            "key": "Enter",
            "phase": "down"
          }
        },
        {
          "input": {
            "key": "Enter",
            "phase": "up"
          }
        }
      ],
      "expect": [
        {
          "after": 2,
          "facets": {
            "checked": "unchecked"
          },
          "emit": []
        }
      ]
    },
    {
      "name": "Home does not move selection",
      "needs": ["keyboard"],
      "start": {
        "isSelected": false
      },
      "steps": [
        {
          "input": {
            "key": "Home",
            "phase": "down"
          }
        }
      ],
      "expect": [
        {
          "after": 1,
          "facets": {
            "checked": "unchecked"
          },
          "emit": []
        }
      ]
    },
    {
      "name": "End does not move selection",
      "needs": ["keyboard"],
      "start": {
        "isSelected": false
      },
      "steps": [
        {
          "input": {
            "key": "End",
            "phase": "down"
          }
        }
      ],
      "expect": [
        {
          "after": 1,
          "facets": {
            "checked": "unchecked"
          },
          "emit": []
        }
      ]
    }
  ]
}
