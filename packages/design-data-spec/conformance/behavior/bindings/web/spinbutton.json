    },
    {
      "name": "End sets the value to 100",
      "needs": ["keyboard"],
      "start": {
        "minValue": 0,
        "maxValue": 100,
        "step": 1,
        "value": 50
      },
      "steps": [
        {
          "input": {
            "key": "End",
