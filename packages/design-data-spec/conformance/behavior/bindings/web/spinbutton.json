{
  "platform": "web",
  "role": "spinbutton",
  "vectors": [
    {
      "name": "ArrowUp sets the value to 51",
      "needs": ["keyboard"],
      "start": {
        "minValue": 0,
        "maxValue": 100,
        "step": 1,
        "value": 50
      },
      "steps": [
        {
          "input": {
            "key": "ArrowUp",
            "phase": "down"
          }
        }
      ],
      "expect": [
        {
          "after": 1,
          "emit": [
            {
              "change": {
                "value": 51
              }
            }
          ]
        }
      ]
    },
    {
      "name": "ArrowDown sets the value to 49",
      "needs": ["keyboard"],
      "start": {
        "minValue": 0,
        "maxValue": 100,
        "step": 1,
        "value": 50
      },
      "steps": [
        {
          "input": {
            "key": "ArrowDown",
            "phase": "down"
          }
        }
      ],
      "expect": [
        {
          "after": 1,
          "emit": [
            {
              "change": {
                "value": 49
              }
            }
          ]
        }
      ]
    },
    {
      "name": "PageUp steps by one, not by a page",
