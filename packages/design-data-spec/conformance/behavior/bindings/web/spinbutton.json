              }
            }
          ]
        }
      ]
    },
    {
      "name": "Home and End read the bounds from the options",
      "needs": ["keyboard"],
      "start": {
        "minValue": -20,
        "maxValue": 40,
        "step": 1,
        "value": 0
      },
      "steps": [
        {
          "input": {
            "key": "Home",
            "phase": "down"
          }
        },
        {
          "input": {
            "key": "End",
            "phase": "down"
          }
        }
      ],
      "expect": [
        {
          "after": 1,
          "emit": [
            {
              "change": {
                "value": -20
              }
            }
          ]
        },
        {
          "after": 2,
          "emit": [
            {
              "change": {
                "value": 40
              }
            }
          ]
        }
      ]
    },
    {
      "name": "a key up changes nothing",
      "needs": ["keyboard"],
      "start": {
        "minValue": 0,
        "maxValue": 100,
        "step": 1,
        "value": 50
      },
      "steps": [
        {
          "input": {
            "key": "ArrowUp",
            "phase": "up"
          }
        }
      ],
      "expect": [
        {
          "after": 1,
          "emit": []
        }
      ]
    },
    {
      "name": "an unbound key changes nothing",
      "needs": ["keyboard"],
      "start": {
        "minValue": 0,
