        "value": 50
      },
      "steps": [
        {
          "input": {
            "key": "Enter",
            "phase": "down"
          }
        }
      ],
      "expect": [
        {
          "after": 1,
          "emit": []
        }
      ]
    },
    {
      "name": "ArrowRight and ArrowLeft are not bound (they move the caret)",
      "needs": ["keyboard"],
      "start": {
        "minValue": 0,
