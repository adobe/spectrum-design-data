            "phase": "down"
          }
        },
        {
          "input": {
            "key": "ArrowLeft",
            "phase": "down"
          }
        }
      ],
      "expect": [
        {
          "after": 1,
          "emit": []
        },
        {
          "after": 2,
          "emit": []
        }
      ]
    },
