{
  "platform": "web",
  "role": "radiogroup",
  "vectors": [
    {
      "name": "ArrowDown skips a disabled radio and selects the next",
      "needs": ["keyboard"],
      "start": {
        "orientation": "vertical",
        "items": [
          {
            "isSelected": true
          },
          {
            "isDisabled": true
          },
          {}
        ],
        "focused": 0
      },
      "steps": [
        {
          "input": {
            "key": "ArrowDown",
            "phase": "down"
          }
        }
      ],
      "expect": [
        {
          "after": 1,
          "items": [
            {
              "checked": "unchecked"
            },
            {
              "checked": "unchecked"
            },
            {
              "checked": "checked"
            }
          ],
          "focused": 2,
          "emit": [
            {
              "change": {
                "isSelected": [2]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "ArrowDown on the last radio wraps to the first",
      "needs": ["keyboard"],
