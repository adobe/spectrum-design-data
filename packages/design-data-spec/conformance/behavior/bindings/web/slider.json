{
  "platform": "web",
  "role": "slider",
  "vectors": [
    {
      "name": "ArrowRight sets the value to 51",
      "needs": ["keyboard"],
      "start": {
        "minValue": 0,
        "maxValue": 100,
        "step": 1,
        "value": 50
      },
      "steps": [
        {
          "input": {
            "key": "ArrowRight",
            "phase": "down"
          }
        }
      ],
      "expect": [
        {
          "after": 1,
          "emit": [
            {
              "change": {
                "value": 51
              }
            }
          ]
        }
      ]
    },
