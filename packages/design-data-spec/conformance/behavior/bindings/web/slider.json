              "change": {
                "value": 51
              }
            }
          ]
        },
        {
          "after": 2,
          "emit": [
            {
              "change": {
                "value": 50
              }
            }
          ]
        }
      ]
    },
    {
      "name": "right to left keeps Home, End and the page keys",
      "needs": ["keyboard"],
      "start": {
        "minValue": 0,
        "maxValue": 100,
        "step": 1,
        "value": 50,
        "direction": "rtl"
      },
      "steps": [
        {
          "input": {
            "key": "Home",
            "phase": "down"
          }
        },
        {
          "input": {
            "key": "End",
            "phase": "down"
          }
        },
        {
          "input": {
            "key": "PageDown",
            "phase": "down"
          }
