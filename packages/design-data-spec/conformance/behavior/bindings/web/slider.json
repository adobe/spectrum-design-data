    {
      "name": "right to left swaps ArrowRight and ArrowLeft",
      "needs": ["keyboard"],
      "start": {
        "minValue": 0,
        "maxValue": 100,
        "step": 1,
        "value": 50,
        "direction": "rtl"
      },
      "steps": [
        {
          "input": {
            "key": "ArrowRight",
            "phase": "down"
          }
        },
        {
          "input": {
            "key": "ArrowLeft",
            "phase": "down"
          }
        }
      ],
      "expect": [
        {
          "after": 1,
          "emit": [
            {
              "change": {
                "value": 49
              }
            }
          ]
        },
        {
          "after": 2,
          "emit": [
            {
              "change": {
                "value": 50
              }
            }
          ]
        }
      ]
    },
    {
      "name": "right to left keeps ArrowUp and ArrowDown",
      "needs": ["keyboard"],
      "start": {
        "minValue": 0,
        "maxValue": 100,
        "step": 1,
        "value": 50,
        "direction": "rtl"
