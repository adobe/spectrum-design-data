{
  "platform": "web",
  "role": "searchbox",
  "vectors": [
    {
      "name": "Escape clears a value",
      "needs": ["keyboard"],
      "start": {
        "value": "abc"
      },
      "steps": [
        {
          "input": {
            "key": "Escape",
            "phase": "down"
          }
        }
      ],
      "expect": [
        {
          "after": 1,
          "emit": [
            {
              "change": {
                "value": ""
              }
            }
          ],
          "facets": {
            "hasValue": "false"
          }
        }
      ]
    },
    {
      "name": "Escape on an empty string does nothing",
      "needs": ["keyboard"],
