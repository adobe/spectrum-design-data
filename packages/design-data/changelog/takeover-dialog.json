          "entries": [
            {"id":"ec3376fa-0","kind":"document-block","change":"updated","class":"documentation","bump":"patch","indirect":false,"contexts":[],"record":"takeover-dialog/documentBlocks/0","name":"guideline: Title text overflow.\n\nWhen the title is too long","fields":[{"path":"content","before":"Takeover dialogs are full-screen modals used for complex or immersive workflows. They block access to the rest of the interface and are typically used when multiple steps or tools need focused attention. Use when the task requires the entire screen and shouldn’t be interrupted.","after":"Title text overflow.\n\nWhen the title is too long for the available horizontal space, it wraps to form another line."}]},
            {"id":"ec3376fa-1","kind":"document-block","change":"updated","class":"documentation","bump":"patch","indirect":false,"contexts":[],"record":"takeover-dialog/documentBlocks/1","name":"guideline: Header content overflow.\n\nTakeover dialogs can o","fields":[{"path":"content","before":"The takeover dialog supports two slots—one in the header and one in the body—where other components can be inserted.","after":"Header content overflow.\n\nTakeover dialogs can optionally include additional elements in the header custom content area. When horizontal space is limited, the header custom content will be displayed underneath the title."}]},
            {"id":"ec3376fa-2","kind":"document-block","change":"updated","class":"documentation","bump":"patch","indirect":false,"contexts":[],"record":"takeover-dialog/documentBlocks/2","name":"guideline: Use similar language for dialog titles and actio","fields":[{"path":"content","before":"Takeover dialogs support two layout variants: dialog and full-screen.","after":"Use similar language for dialog titles and actions.\n\nMost dialog titles should communicate the primary action of the dialog. When possible, the button label should use the same language as the action mentioned in the title. For example, if the title is \"Delete conversation,\" the primary action button label should be \"Delete."}]},
            {"id":"ec3376fa-3","kind":"document-block","change":"removed","class":"documentation","bump":"patch","indirect":false,"contexts":[],"record":"takeover-dialog/documentBlocks/3","name":"guideline: All takeover dialogs must include a title. The t","fields":[],"before":{"type":"guideline","content":"All takeover dialogs must include a title. The title appears at the top of the dialog and should briefly describe the expected outcome if the user proceeds with the primary action."}},
            {"id":"ec3376fa-4","kind":"document-block","change":"removed","class":"documentation","bump":"patch","indirect":false,"contexts":[],"record":"takeover-dialog/documentBlocks/4","name":"guideline: A takeover dialog must include at least one butt","fields":[],"before":{"type":"guideline","content":"A takeover dialog must include at least one button. The primary action label refers to the rightmost button in the dialog footer for languages that read left to right. It should use a short, actionable phrase that clearly communicates the result of selecting the action—whether that means taking action, progressing through a workflow, or dismissing the dialog."}},
            {"id":"ec3376fa-5","kind":"document-block","change":"removed","class":"documentation","bump":"patch","indirect":false,"contexts":[],"record":"takeover-dialog/documentBlocks/5","name":"guideline: Takeover dialogs can include up to three buttons","fields":[],"before":{"type":"guideline","content":"Takeover dialogs can include up to three buttons if a secondary outline button label is defined. If no label is defined, the button won’t appear. The secondary outline button should use a short, actionable phrase that clearly communicates the result of selecting the action—typically describing the previous step or an alternative choice."}},
            {"id":"ec3376fa-6","kind":"document-block","change":"removed","class":"documentation","bump":"patch","indirect":false,"contexts":[],"record":"takeover-dialog/documentBlocks/6","name":"guideline: By default, a takeover dialog that includes a bu","fields":[],"before":{"type":"guideline","content":"By default, a takeover dialog that includes a button to cancel or go back will be labeled “Cancel.”"}},
            {"id":"ec3376fa-7","kind":"document-block","change":"removed","class":"documentation","bump":"patch","indirect":false,"contexts":[],"record":"takeover-dialog/documentBlocks/7","name":"guideline: When the title is too long for the available hor","fields":[],"before":{"type":"guideline","content":"When the title is too long for the available horizontal space, it wraps to form another line."}},
            {"id":"ec3376fa-8","kind":"document-block","change":"removed","class":"documentation","bump":"patch","indirect":false,"contexts":[],"record":"takeover-dialog/documentBlocks/8","name":"guideline: Takeover dialogs can optionally include addition","fields":[],"before":{"type":"guideline","content":"Takeover dialogs can optionally include additional elements in the header custom content area. When horizontal space is limited, the header custom content will be displayed underneath the title."}},
            {"id":"ec3376fa-9","kind":"document-block","change":"removed","class":"documentation","bump":"patch","indirect":false,"contexts":[],"record":"takeover-dialog/documentBlocks/9","name":"guideline: Most dialog titles should communicate the primar","fields":[],"before":{"type":"guideline","content":"Most dialog titles should communicate the primary action of the dialog. When possible, the button label should use the same language as the action mentioned in the title. For example, if the title is “Delete conversation,” the primary action button label should be “Delete.”"}}
