          "entries": [
            {"id":"ec3376fa-0","kind":"document-block","change":"updated","class":"documentation","bump":"patch","indirect":false,"contexts":[],"record":"color-area/documentBlocks/0","name":"guideline: Keyboard focus.\n\nA color area can be navigated u","fields":[{"path":"content","before":"A color area enables visual selection of two color properties at once. It's often paired with a color slider or color wheel.","after":"Keyboard focus.\n\nA color area can be navigated using a keyboard. The keyboard focus state enlarges the handle to become twice as large."}]},
            {"id":"ec3376fa-1","kind":"document-block","change":"updated","class":"documentation","bump":"patch","indirect":false,"contexts":[],"record":"color-area/documentBlocks/1","name":"guideline: Handle behavior.\n\nThe color area's handle can sl","fields":[{"path":"content","before":"A color area in a disabled state shows that an input exists, but is not available in that circumstance. This can be used to maintain layout continuity and communicate that the area may become available later.","after":"Handle behavior.\n\nThe color area's handle can slide all the way over the edge of the area. It always displays the selected color inside the handle and never gets cut off by the border or any container."}]},
            {"id":"ec3376fa-2","kind":"document-block","change":"updated","class":"documentation","bump":"patch","indirect":false,"contexts":[],"record":"color-area/documentBlocks/2","name":"guideline: Minimum width and height.\n\nMinimum sizing ensure","fields":[{"path":"content","before":"A color area’s height and width can be customized appropriately for its context.","after":"Minimum width and height.\n\nMinimum sizing ensures that the component remains clear, usable, and visually consistent, even in flexible or responsive layouts."}]},
            {"id":"ec3376fa-3","kind":"document-block","change":"updated","class":"documentation","bump":"patch","indirect":false,"contexts":[],"record":"color-area/documentBlocks/3","name":"guideline: Display color selection.\n\nWhen using color areas","fields":[{"path":"content","before":"The step refers to the increment by which these values increase or decrease. A step value of 1 (default) allows a user to only select whole numbers within the min and max range.","after":"Display color selection.\n\nWhen using color areas, it's important to clearly display the color selection in real time. This can be in a color swatch, directly on the canvas, or both."}]},
            {"id":"ec3376fa-4","kind":"document-block","change":"updated","class":"documentation","bump":"patch","indirect":false,"contexts":[],"record":"color-area/documentBlocks/4","name":"guideline: Color loupe on down/touch states.\n\nThe color lou","fields":[{"path":"content","before":"The x and y values are the numbers selected within the color area’s horizontal and vertical axes, respectively.","after":"Color loupe on down/touch states.\n\nThe color loupe component can be used above the handle to show the selected color that would otherwise be covered by a mouse, stylus, or finger on the down/touch state. This can be customized to appear only on finger-input, or always appear regardless of input type."}]},
            {"id":"ec3376fa-5","kind":"document-block","change":"removed","class":"documentation","bump":"patch","indirect":false,"contexts":[],"record":"color-area/documentBlocks/5","name":"guideline: The x/y min and max values also can be customize","fields":[],"before":{"type":"guideline","content":"The x/y min and max values also can be customized appropriately for what the color area is being used for. By default, the min value starts at 0 and max value is set to 100."}},
            {"id":"ec3376fa-6","kind":"document-block","change":"removed","class":"documentation","bump":"patch","indirect":false,"contexts":[],"record":"color-area/documentBlocks/6","name":"guideline: A color area can be navigated using a keyboard. ","fields":[],"before":{"type":"guideline","content":"A color area can be navigated using a keyboard. The keyboard focus state enlarges the handle to become twice as large."}},
            {"id":"ec3376fa-7","kind":"document-block","change":"removed","class":"documentation","bump":"patch","indirect":false,"contexts":[],"record":"color-area/documentBlocks/7","name":"guideline: The color area’s handle can slide all the way ov","fields":[],"before":{"type":"guideline","content":"The color area’s handle can slide all the way over the edge of the area. It always displays the selected color inside the handle and never gets cut off by the border or any container."}},
