            {"id":"ec3376fa-0","kind":"document-block","change":"updated","class":"documentation","bump":"patch","indirect":false,"contexts":[],"record":"in-line-alert/documentBlocks/0","name":"guideline: Text overflow.\n\nWhen the title of an in-line ale","fields":[{"path":"content","before":"In-line alerts display non-modal messages connected to elements in a view. They’re often used in forms to show validation feedback across multiple fields.","after":"Text overflow.\n\nWhen the title of an in-line alert is too long for the available horizontal space, it wraps to form another line. The optional icon in the top-right corner stays aligned to the top."}]},
