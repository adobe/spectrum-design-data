          "entries": [
            {"id":"ec3376fa-0","kind":"document-block","change":"updated","class":"documentation","bump":"patch","indirect":false,"contexts":[],"record":"standard-dialog/documentBlocks/0","name":"guideline: Placement.\n\nStandard dialogs appear in the cente","fields":[{"path":"content","before":"Standard dialogs are containers that appear over the interface to present contextual information, tasks, or workflows. They’re centered on the screen and used for moderately complex actions that require focused attention. Interactions outside the dialog are blocked until it's dismissed or completed.","after":"Placement.\n\nStandard dialogs appear in the center of the screen."}]},
            {"id":"ec3376fa-1","kind":"document-block","change":"updated","class":"documentation","bump":"patch","indirect":false,"contexts":[],"record":"standard-dialog/documentBlocks/1","name":"guideline: Text overflow.\n\nWhen the title and description t","fields":[{"path":"content","before":"By default, an alert dialog that includes a button to cancel or go back will be labeled “Cancel.”","after":"Text overflow.\n\nWhen the title and description text are too long for the available horizontal space, they wrap to form another line."}]},
            {"id":"ec3376fa-2","kind":"document-block","change":"updated","class":"documentation","bump":"patch","indirect":false,"contexts":[],"record":"standard-dialog/documentBlocks/2","name":"guideline: Button group overflow.\n\nStandard dialogs can inc","fields":[{"path":"content","before":"Standard dialogs can include up to three buttons if a secondary outline button label is defined. If no label is defined, the button won’t appear. The secondary outline button should use a short, actionable phrase that clearly communicates the result of selecting the action—typically describing the previous step or an alternative choice.","after":"Button group overflow.\n\nStandard dialogs can include up to three buttons. When horizontal space is limited, the buttons stack vertically. Buttons should be ordered by ascending importance, with the most critical action placed at the end or bottom of the stack."}]},
            {"id":"ec3376fa-3","kind":"document-block","change":"updated","class":"documentation","bump":"patch","indirect":false,"contexts":[],"record":"standard-dialog/documentBlocks/3","name":"guideline: Dismissible or not?\n\nWhether a dialog is dismiss","fields":[{"path":"content","before":"The primary action label refers to the rightmost button in the dialog footer for languages that read left to right. It should use a short, actionable phrase that clearly communicates the result of selecting the action—whether that means moving forward or dismissing the dialog.","after":"Dismissible or not?\n\nWhether a dialog is dismissible is controlled by the hideCloseButton prop. A dialog with a close button can be dismissed by clicking the button or the background overlay. Avoid using a dismissible dialog when the user needs to confirm an action or make a decision. Instead, use a dismissible dialog for information that is optional or nice to know—content that can be quickly dismissed without requiring user action."}]},
            {"id":"ec3376fa-4","kind":"document-block","change":"updated","class":"documentation","bump":"patch","indirect":false,"contexts":[],"record":"standard-dialog/documentBlocks/4","name":"guideline: Use similar language for dialog titles and actio","fields":[{"path":"content","before":"The presence of a close button determines whether a dialog is dismissible.","after":"Use similar language for dialog titles and actions.\n\nMost dialog titles should communicate the primary action of the dialog. When possible, the button label should use the same language as the action mentioned in the title. For example, if the title is \"Delete conversation,\" the primary action button label should be \"Delete."}]},
            {"id":"ec3376fa-5","kind":"document-block","change":"removed","class":"documentation","bump":"patch","indirect":false,"contexts":[],"record":"standard-dialog/documentBlocks/5","name":"guideline: In both cases, pressing the Escape key should cl","fields":[],"before":{"type":"guideline","content":"In both cases, pressing the Escape key should close the dialog and return the page to its previous state. This action should behave the same as clicking a close or cancel button."}},
            {"id":"ec3376fa-6","kind":"document-block","change":"removed","class":"documentation","bump":"patch","indirect":false,"contexts":[],"record":"standard-dialog/documentBlocks/6","name":"guideline: Standard dialogs are available in three widths:","fields":[],"before":{"type":"guideline","content":"Standard dialogs are available in three widths:"}},
            {"id":"ec3376fa-7","kind":"document-block","change":"removed","class":"documentation","bump":"patch","indirect":false,"contexts":[],"record":"standard-dialog/documentBlocks/7","name":"guideline: Dialogs automatically scale down to 90% of the s","fields":[],"before":{"type":"guideline","content":"Dialogs automatically scale down to 90% of the screen width on smaller viewports. Height is flexible and adjusts to fit the content."}},
            {"id":"ec3376fa-8","kind":"document-block","change":"removed","class":"documentation","bump":"patch","indirect":false,"contexts":[],"record":"standard-dialog/documentBlocks/8","name":"guideline: Standard dialogs can include a full-bleed cover ","fields":[],"before":{"type":"guideline","content":"Standard dialogs can include a full-bleed cover image at the top. Dialogs with a cover image should not be dismissible and rely on buttons in the footer area to close the dialog."}},
            {"id":"ec3376fa-9","kind":"document-block","change":"removed","class":"documentation","bump":"patch","indirect":false,"contexts":[],"record":"standard-dialog/documentBlocks/9","name":"guideline: Standard dialogs can include an optional descrip","fields":[],"before":{"type":"guideline","content":"Standard dialogs can include an optional description. Use the description to briefly provide additional context or information that helps users make an informed decision based on the available actions."}},
            {"id":"ec3376fa-10","kind":"document-block","change":"removed","class":"documentation","bump":"patch","indirect":false,"contexts":[],"record":"standard-dialog/documentBlocks/10","name":"guideline: All standard dialogs must include a title. The t","fields":[],"before":{"type":"guideline","content":"All standard dialogs must include a title. The title appears at the top of the dialog and should briefly describe the expected outcome if the user proceeds with the primary action. If a cover image is shown, the title will appear below it."}},
            {"id":"ec3376fa-11","kind":"document-block","change":"removed","class":"documentation","bump":"patch","indirect":false,"contexts":[],"record":"standard-dialog/documentBlocks/11","name":"guideline: Standard dialogs appear in the center of the scr","fields":[],"before":{"type":"guideline","content":"Standard dialogs appear in the center of the screen."}},
            {"id":"ec3376fa-12","kind":"document-block","change":"removed","class":"documentation","bump":"patch","indirect":false,"contexts":[],"record":"standard-dialog/documentBlocks/12","name":"guideline: When the title and description text are too long","fields":[],"before":{"type":"guideline","content":"When the title and description text are too long for the available horizontal space, they wrap to form another line."}},
            {"id":"ec3376fa-13","kind":"document-block","change":"removed","class":"documentation","bump":"patch","indirect":false,"contexts":[],"record":"standard-dialog/documentBlocks/13","name":"guideline: Standard dialogs can include up to three buttons","fields":[],"before":{"type":"guideline","content":"Standard dialogs can include up to three buttons. When horizontal space is limited, the buttons stack vertically. Buttons should be ordered by ascending importance, with the most critical action placed at the end or bottom of the stack."}},
            {"id":"ec3376fa-14","kind":"document-block","change":"removed","class":"documentation","bump":"patch","indirect":false,"contexts":[],"record":"standard-dialog/documentBlocks/14","name":"guideline: Avoid using a dismissible dialog when the user n","fields":[],"before":{"type":"guideline","content":"Avoid using a dismissible dialog when the user needs to confirm an action or make a decision. Instead, use a dismissible dialog for information that is optional or nice to know—content that can be quickly dismissed without requiring user action."}},
            {"id":"ec3376fa-15","kind":"document-block","change":"removed","class":"documentation","bump":"patch","indirect":false,"contexts":[],"record":"standard-dialog/documentBlocks/15","name":"guideline: A dismissible dialog should not include buttons ","fields":[],"before":{"type":"guideline","content":"A dismissible dialog should not include buttons in the footer. Instead, the dialog is dismissed by clicking the close button or the background overlay."}},
            {"id":"ec3376fa-16","kind":"document-block","change":"removed","class":"documentation","bump":"patch","indirect":false,"contexts":[],"record":"standard-dialog/documentBlocks/16","name":"guideline: Most dialog titles should communicate the primar","fields":[],"before":{"type":"guideline","content":"Most dialog titles should communicate the primary action of the dialog. When possible, the button label should use the same language as the action mentioned in the title. For example, if the title is “Delete conversation,” the primary action button label should be “Delete.”"}},
            {"id":"ec3376fa-17","kind":"document-block","change":"added","class":"documentation","bump":"minor","indirect":false,"contexts":[],"record":"standard-dialog/documentBlocks/17","name":"do-dont: Don't include buttons when dismissible","fields":[],"after":{"type":"do-dont","content":"Don't include buttons when dismissible","dont":"A dismissible dialog should not include buttons in the footer. Instead, the dialog is dismissed by clicking the close button or the background overlay."}}
          ]
