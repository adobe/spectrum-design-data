{
  "$schema": "https://opensource.adobe.com/spectrum-design-data/schemas/v0/behavior.schema.json",
  "component": "rating",
  "extends": ["range"],
  "state": ["isDisabled", "value", "maxValue", "direction"],
  "range": {
    "value": "value",
    "max": "maxValue",
    "page": {
      "fraction": 0.1
    },
    "mirror": {
      "facet": "arrowOrder",
      "is": "mirrored"
    }
  },
  "facets": {
    "arrowOrder": {
      "from": "direction",
      "values": {
        "mirrored": "rtl",
        "natural": "ltr"
      }
    }
  },
  "parts": {
    "container": {
      "role": "slider",
      "focus": "tab-stop"
    }
  },
  "semantics": {
    "container": {
      "value": {
        "ariaState": "aria-valuenow",
        "copy": true
      },
      "maxValue": {
        "ariaState": "aria-valuemax",
        "copy": true
      }
    }
  },
  "wcag": [
    {
      "criterion": "1.3.1",
      "level": "A",
      "title": "Info and Relationships"
    },
    {
      "criterion": "2.1.1",
      "level": "A",
      "title": "Keyboard"
    },
    {
      "criterion": "4.1.2",
      "level": "A",
      "title": "Name, Role, Value"
    }
  ]
}
