{
  "$schema": "https://opensource.adobe.com/spectrum-design-data/schemas/v0/behavior.schema.json",
  "component": "radio-group",
  "state": ["orientation", "direction", "isDisabled"],
  "facets": {
    "orientation": {
      "from": "orientation",
      "values": { "horizontal": "horizontal", "vertical": "vertical" }
    },
    "arrowOrder": {
      "from": ["orientation", "direction"],
      "values": {
        "mirrored": { "orientation": "horizontal", "direction": "rtl" },
        "natural": {}
      },
      "order": "first match wins"
    },
    "disabled": {
      "from": "isDisabled",
      "values": { "false": false, "true": true }
    }
  },
  "parts": {
    "container": {
      "focus": "none"
    }
  },
  "semantics": {
    "container": {
      "orientation": {
        "ariaState": "aria-orientation",
        "map": { "horizontal": "horizontal", "vertical": "vertical" }
      }
    }
  },
  "wcag": [
    { "criterion": "1.3.1", "level": "A", "title": "Info and Relationships" },
    { "criterion": "4.1.2", "level": "A", "title": "Name, Role, Value" }
  ]
}
