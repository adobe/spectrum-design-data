{
  "$schema": "https://opensource.adobe.com/spectrum-design-data/schemas/v0/behavior.schema.json",
  "component": "swatch-group",
  "state": ["enableSelection", "selectionMode", "allowsEmptySelection"],
  "facets": {
    "selection": {
      "from": ["enableSelection", "selectionMode"],
      "values": {
        "none": {
          "enableSelection": false
        },
        "multiple": {
          "selectionMode": "multiple"
        },
        "single": {}
      },
      "order": "first match wins"
    },
    "allowsEmpty": {
      "from": "allowsEmptySelection",
      "values": {
        "false": false,
        "true": true
      }
    }
  },
  "parts": {
    "container": {
      "role": "group",
      "focus": "none"
    }
  },
  "collection": {
    "slot": "default",
    "item": "swatch",
    "choose": {
      "mode": {
        "facet": "selection"
      },
      "allowsEmpty": {
        "facet": "allowsEmpty"
      }
    },
    "traversal": {
      "wrap": false,
      "skip": {
        "facet": "disabled",
        "is": "true"
      },
      "selectOnMove": false,
      "focus": "roving"
    }
  },
  "wcag": [
    {
      "criterion": "4.1.2",
      "level": "A",
      "title": "Name, Role, Value"
    }
  ]
}
