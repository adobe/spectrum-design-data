{
  "$schema": "https://opensource.adobe.com/spectrum-design-data/schemas/v0/behavior.schema.json",
  "component": "search-field",
  "extends": ["text"],
  "state": ["isDisabled", "value", "label", "hideLabel"],
  "parts": {
    "field": {
      "role": "searchbox",
      "focus": "tab-stop"
    },
    "in-field-button": {
      "focus": "none"
    }
  },
  "semantics": {
    "field": {
      "label": {
        "ariaState": "aria-label",
        "copy": true,
        "absentWhen": {
          "hideLabel": false
        }
      }
    }
  },
  "wcag": [
    {
      "criterion": "1.3.1",
      "level": "A",
      "title": "Info and Relationships"
    },
    {
      "criterion": "1.3.5",
      "level": "AA",
      "title": "Identify Input Purpose"
    },
    {
      "criterion": "2.1.1",
      "level": "A",
      "title": "Keyboard"
    },
    {
      "criterion": "4.1.2",
      "level": "A",
      "title": "Name, Role, Value"
    }
  ]
}
