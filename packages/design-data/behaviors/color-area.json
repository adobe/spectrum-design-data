{
  "$schema": "https://opensource.adobe.com/spectrum-design-data/schemas/v0/behavior.schema.json",
  "component": "color-area",
  "extends": ["range"],
  "state": [
    "isDisabled",
    "x-value",
    "x-minValue",
    "x-maxValue",
    "y-value",
    "y-minValue",
    "y-maxValue",
    "step"
  ],
  "ranges": {
    "x": {
      "value": "x-value",
      "min": "x-minValue",
      "max": "x-maxValue",
      "step": "step"
    },
    "y": {
      "value": "y-value",
      "min": "y-minValue",
      "max": "y-maxValue",
      "step": "step"
    }
  },
  "parts": {
    "color-handle": {
      "focus": "tab-stop"
    }
  },
  "semantics": {
    "color-handle": {
      "x-value": {
        "ariaState": "aria-valuenow",
        "copy": true,
        "axis": "x"
      },
      "x-minValue": {
        "ariaState": "aria-valuemin",
        "copy": true,
        "axis": "x"
      },
      "x-maxValue": {
        "ariaState": "aria-valuemax",
        "copy": true,
        "axis": "x"
      },
      "y-value": {
        "ariaState": "aria-valuenow",
        "copy": true,
        "axis": "y"
      },
      "y-minValue": {
        "ariaState": "aria-valuemin",
        "copy": true,
        "axis": "y"
      },
      "y-maxValue": {
        "ariaState": "aria-valuemax",
        "copy": true,
        "axis": "y"
      }
    }
  },
  "wcag": [
    {
      "criterion": "1.3.1",
      "level": "A",
      "title": "Info and Relationships"
    },
    {
      "criterion": "2.1.1",
      "level": "A",
      "title": "Keyboard"
    },
    {
      "criterion": "4.1.2",
      "level": "A",
      "title": "Name, Role, Value"
    }
  ]
}
