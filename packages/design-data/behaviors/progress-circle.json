{
  "$schema": "https://opensource.adobe.com/spectrum-design-data/schemas/v0/behavior.schema.json",
  "component": "progress-circle",
  "state": ["value", "minValue", "maxValue", "isIndeterminate"],
  "parts": {
    "track": {
      "role": "progressbar",
      "focus": "none"
    }
  },
  "semantics": {
    "track": {
      "value": {
        "ariaState": "aria-valuenow",
        "copy": true,
        "absentWhen": {
          "isIndeterminate": true
        }
      },
      "minValue": {
        "ariaState": "aria-valuemin",
        "copy": true,
        "absentWhen": {
          "isIndeterminate": true
        }
      },
      "maxValue": {
        "ariaState": "aria-valuemax",
        "copy": true,
        "absentWhen": {
          "isIndeterminate": true
        }
      }
    }
  },
  "wcag": [
    {
      "criterion": "4.1.2",
      "level": "A",
      "title": "Name, Role, Value"
    },
    {
      "criterion": "4.1.3",
      "level": "AA",
      "title": "Status Messages"
    }
  ]
}
