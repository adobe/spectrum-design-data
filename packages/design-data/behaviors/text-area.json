{
  "$schema": "https://opensource.adobe.com/spectrum-design-data/schemas/v0/behavior.schema.json",
  "component": "text-area",
  "extends": ["text"],
  "state": [
    "isDisabled",
    "value",
    "isError",
    "isRequired",
    "label",
    "hideLabel"
  ],
  "parts": {
    "field": {
      "role": "textbox",
      "focus": "tab-stop"
    }
  },
  "semantics": {
    "field": {
      "isError": {
        "ariaState": "aria-invalid",
        "copy": true,
        "absentWhen": {
          "isError": false
        }
      },
      "isRequired": {
        "ariaState": "aria-required",
        "copy": true,
        "absentWhen": {
          "isRequired": false
        }
      },
      "label": {
        "ariaState": "aria-label",
        "copy": true,
        "absentWhen": {
          "hideLabel": false
        }
      }
    }
  },
  "wcag": [
    {
      "criterion": "1.3.1",
      "level": "A",
      "title": "Info and Relationships"
    },
    {
      "criterion": "1.3.5",
      "level": "AA",
      "title": "Identify Input Purpose"
    },
    {
      "criterion": "2.1.1",
      "level": "A",
      "title": "Keyboard"
    },
    {
      "criterion": "4.1.2",
      "level": "A",
      "title": "Name, Role, Value"
    }
  ]
}
