{
  "$schema": "https://opensource.adobe.com/spectrum-design-data/schemas/v0/behavior.schema.json",
  "component": "switch",
  "extends": ["toggle"],
  "state": ["isSelected", "isDisabled", "isReadOnly"],
  "parts": {
    "track": {
      "role": "switch",
      "focus": "tab-stop",
      "press": "activate"
    }
  },
  "semantics": {
    "track": {
      "checked": {
        "ariaState": "aria-checked",
        "map": {
          "unchecked": "false",
          "checked": "true"
        }
      },
      "readOnly": {
        "ariaState": "aria-readonly",
        "map": {
          "false": "false",
          "true": "true"
        }
      }
    }
  },
  "wcag": [
    {
      "criterion": "2.1.1",
      "level": "A",
      "title": "Keyboard"
    },
    {
      "criterion": "4.1.2",
      "level": "A",
      "title": "Name, Role, Value"
    }
  ]
}
