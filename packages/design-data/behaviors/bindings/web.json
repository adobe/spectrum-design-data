{
  "$schema": "https://opensource.adobe.com/spectrum-design-data/schemas/v0/behavior-bindings.schema.json",
  "platform": "web",
  "capabilities": ["pointer-hover", "keyboard", "assistive-activation"],
  "roles": {
    "switch": {
      "keyboard": [{ "key": "Space", "down": "press-start", "up": "press-end" }]
    },
    "checkbox": {
      "keyboard": [{ "key": "Space", "down": "press-start", "up": "press-end" }]
    },
    "button": {
      "keyboard": [
        { "key": "Enter", "down": ["press-start", "press-end"] },
        { "key": "Space", "down": "press-start", "up": "press-end" }
      ]
    },
    "link": {
      "keyboard": [{ "key": "Enter", "down": ["press-start", "press-end"] }]
    },
    "radio": {
      "keyboard": [{ "key": "Space", "down": "press-start", "up": "press-end" }]
    },
    "radiogroup": {
      "keyboard": [
        { "key": "ArrowDown", "down": "navigate-next" },
        { "key": "ArrowRight", "down": "navigate-next" },
        { "key": "ArrowUp", "down": "navigate-previous" },
        { "key": "ArrowLeft", "down": "navigate-previous" }
      ]
    },
    "slider": {
      "keyboard": [
        { "key": "ArrowRight", "down": "increment" },
        { "key": "ArrowUp", "down": "increment" },
        { "key": "ArrowLeft", "down": "decrement" },
        { "key": "ArrowDown", "down": "decrement" },
        { "key": "PageUp", "down": "increment-page" },
        { "key": "PageDown", "down": "decrement-page" },
        { "key": "Home", "down": "set-min" },
        { "key": "End", "down": "set-max" }
      ]
    },
    "spinbutton": {
      "keyboard": [
        { "key": "ArrowUp", "down": "increment" },
        { "key": "ArrowDown", "down": "decrement" },
        { "key": "PageUp", "down": "increment" },
        { "key": "PageDown", "down": "decrement" },
        { "key": "Home", "down": "set-min" },
        { "key": "End", "down": "set-max" }
      ]
    },
    "tooltip": {
      "keyboard": [{ "key": "Escape", "down": "dismiss" }]
    },
    "searchbox": {
      "keyboard": [
        { "key": "Escape", "down": "clear" },
        { "key": "Enter", "down": "submit" }
      ]
    },
    "textbox": { "keyboard": [] }
  }
}
