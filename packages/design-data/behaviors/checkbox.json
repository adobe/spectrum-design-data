{
  "$schema": "https://opensource.adobe.com/spectrum-design-data/schemas/v0/behavior.schema.json",
  "component": "checkbox",
  "extends": ["toggle"],
  "state": ["isSelected", "isIndeterminate", "isDisabled", "isReadOnly"],
  "facets": {
    "checked": {
      "from": ["isSelected", "isIndeterminate"],
      "values": {
        "indeterminate": {
          "isIndeterminate": true
        },
        "checked": {
          "isIndeterminate": false,
          "isSelected": true
        },
        "unchecked": {
          "isIndeterminate": false,
          "isSelected": false
        }
      },
      "order": "first match wins"
    }
  },
  "parts": {
    "box": {
      "role": "checkbox",
      "focus": "tab-stop",
      "press": "activate"
    }
  },
  "transitions": [
    {
      "on": "activate",
      "guard": {
        "all": [
          {
            "facet": "disabled",
            "is": "false"
          },
          {
            "facet": "readOnly",
            "is": "false"
          }
        ]
      },
      "do": {
        "toggle": "isSelected",
        "set": {
          "isIndeterminate": false
        }
      },
      "emit": "change"
    }
  ],
  "semantics": {
    "box": {
      "checked": {
        "ariaState": "aria-checked",
        "map": {
          "unchecked": "false",
          "checked": "true",
          "indeterminate": "mixed"
        }
      },
      "readOnly": {
        "ariaState": "aria-readonly",
        "map": {
          "false": "false",
          "true": "true"
        }
      }
    }
  },
  "wcag": [
    {
      "criterion": "1.3.1",
      "level": "A",
      "title": "Info and Relationships"
    },
    {
      "criterion": "2.1.1",
      "level": "A",
      "title": "Keyboard"
    },
    {
      "criterion": "4.1.2",
      "level": "A",
      "title": "Name, Role, Value"
    }
  ]
}
