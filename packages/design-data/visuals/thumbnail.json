{
  "$schema": "https://opensource.adobe.com/spectrum-design-data/schemas/v0/component-visual.schema.json",
  "specVersion": "1.0.0-draft",
  "component": "thumbnail",
  "root": "container",
  "sizeScale": {
    "50": 50,
    "75": 75,
    "100": 100,
    "200": 200,
    "300": 300,
    "400": 400,
    "500": 500,
    "600": 600,
    "700": 700,
    "800": 800,
    "900": 900,
    "1000": 1000
  },
  "notVisual": ["showImage"],
  "parts": {
    "container": {
      "kind": "box",
      "children": ["opacity-checkerboard"],
      "props": {
        "width": {
          "relationship": {
            "property": "size",
            "context": "Size"
          }
        },
        "height": {
          "relationship": {
            "property": "size",
            "context": "Size"
          }
        },
        "opacity": {
          "when": {
            "options": {
              "isDisabled": true
            }
          },
          "relationship": {
            "property": "opacity",
            "context": "Disabled"
          }
        }
      }
    },
    "opacity-checkerboard": {
      "kind": "box",
      "props": {
        "width": {
          "relationship": {
            "property": "size",
            "context": "Size"
          }
        },
        "height": {
          "relationship": {
            "property": "size",
            "context": "Size"
          }
        },
        "cornerRadius": {
          "relationship": {
            "property": "corner-radius",
            "context": "Rounding"
          }
        },
        "fill": {
          "relationship": {
            "property": "square-light",
            "context": "Checkerboard colors"
          }
        },
        "patternFill": {
          "relationship": {
            "property": "square-dark",
            "context": "Checkerboard colors"
          }
        },
        "patternSize": {
          "relationship": {
            "property": "opacity-checkerboard-size",
            "context": "Opacity Checkerboard"
          }
        },
        "stroke": {
          "relationship": {
            "property": "color",
            "context": "Border"
          }
        },
        "strokeOpacity": {
          "relationship": {
            "property": "opacity",
            "context": "Border"
          }
        },
        "strokeWidth": {
          "relationship": {
            "property": "border-width",
            "context": "Border"
          }
        }
      }
    }
  }
}
