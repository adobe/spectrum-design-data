{
  "$schema": "https://opensource.adobe.com/spectrum-design-data/schemas/v0/component-visual.schema.json",
  "specVersion": "1.0.0-draft",
  "component": "segmented-control",
  "root": "container",
  "sizeScale": {
    "s": 75,
    "m": 100,
    "l": 200,
    "xl": 300
  },
  "notVisual": ["isFluid", "alignment", "keyboardActivation", "selectedItem"],
  "parts": {
    "container": {
      "kind": "box",
      "children": ["item"],
      "repeat": {
        "slot": "default",
        "label": "label",
        "with": {
          "isSelected": "isSelected",
          "isDisabled": "isDisabled"
        }
      },
      "props": {
        "direction": [
          {
            "value": "row"
          },
          {
            "when": {
              "options": {
                "orientation": "vertical"
              }
            },
            "value": "column"
          }
        ],
        "align": {
          "value": "start"
        },
        "cornerRadius": [
          {
            "relationship": {
              "property": "corner-radius",
              "part": "item"
            },
            "when": {
              "options": {
                "size": "m"
              }
            }
          }
        ],
        "fill": [
          {
            "when": {
              "options": {
                "hideTracker": false
              }
            },
            "relationship": {
              "property": "color",
              "attribute": "background",
              "part": "container"
            }
          }
        ]
      }
    },
    "item": {
      "kind": "box",
      "children": ["icon", "label"],
      "props": {
        "direction": {
          "value": "row"
        },
        "align": {
          "value": "center"
        },
        "paddingInlineStart": [
          {
            "relationship": {
              "property": "space-between",
              "part": "item",
              "between": {
                "from": "start-edge",
                "to": "label"
              }
            },
            "when": {
              "options": {
                "size": "m"
              }
            }
          }
        ],
        "paddingInlineEnd": [
          {
            "relationship": {
              "property": "space-between",
              "part": "item",
              "between": {
                "from": "label",
                "to": "end-edge"
              }
            },
            "when": {
              "options": {
                "size": "m"
              }
            }
          }
        ],
        "gap": [
          {
            "relationship": {
              "property": "space-between",
              "part": "item",
              "between": {
                "from": "icon",
                "to": "label"
              }
            },
            "when": {
              "options": {
                "size": "m"
              }
            }
          }
        ],
        "justify": {
          "value": "center"
        },
        "cornerRadius": [
          {
            "relationship": {
              "property": "corner-radius",
              "part": "item"
            },
            "when": {
              "options": {
                "size": "m"
              }
            }
          }
        ],
        "fill": [
          {
            "when": {
              "options": {
                "isSelected": true
              }
            },
            "relationship": {
              "property": "color",
              "attribute": "background",
              "part": "selection-indicator"
            }
          }
        ],
        "strokeWidth": [
          {
            "when": {
              "options": {
                "isSelected": true,
                "hideTracker": true
              }
            },
            "relationship": {
              "property": "border-width",
              "part": "selection-indicator"
            }
          }
        ],
        "stroke": [
          {
            "when": {
              "options": {
                "isSelected": true,
                "hideTracker": true
              }
            },
            "relationship": {
              "property": "color",
              "attribute": "border",
              "part": "selection-indicator"
            }
          }
        ]
      }
    },
    "icon": {
      "kind": "icon",
      "icon": {
        "set": "workflow",
        "name": "add",
        "content": true,
        "optional": true
      },
      "props": {
        "width": [
          {
            "relationship": {
              "property": "size",
              "part": "icon"
            },
            "when": {
              "options": {
                "size": "m"
              }
            }
          }
        ],
        "height": [
          {
            "relationship": {
              "property": "size",
              "part": "icon"
            },
            "when": {
              "options": {
                "size": "m"
              }
            }
          }
        ],
        "color": [
          {
            "relationship": {
              "property": "content-color",
              "part": "item"
            }
          },
          {
            "when": {
              "options": {
                "isDisabled": true
              }
            },
            "relationship": {
              "property": "content-color",
              "part": "label"
            },
            "priority": 10
          }
        ]
      }
    },
    "label": {
      "kind": "text",
      "props": {
        "overflow": {
          "value": "truncate"
        },
        "fontFamily": {
          "relationship": {
            "property": "font-family",
            "part": "label"
          }
        },
        "fontSize": [
          {
            "relationship": {
              "property": "font-size",
              "part": "label"
            },
            "when": {
              "options": {
                "size": "m"
              }
            }
          }
        ],
        "fontWeight": {
          "relationship": {
            "property": "font-weight",
            "part": "label"
          }
        },
        "lineHeight": {
          "relationship": {
            "property": "line-height",
            "part": "label"
          }
        },
        "color": [
          {
            "relationship": {
              "property": "content-color",
              "part": "item"
            }
          },
          {
            "when": {
              "options": {
                "isDisabled": true
              }
            },
            "relationship": {
              "property": "content-color",
              "part": "label"
            },
            "priority": 10
          }
        ]
      }
    }
  }
}
