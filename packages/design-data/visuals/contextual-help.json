{
  "$schema": "https://opensource.adobe.com/spectrum-design-data/schemas/v0/component-visual.schema.json",
  "specVersion": "1.0.0-draft",
  "component": "contextual-help",
  "root": "container",
  "sizeScale": {
    "m": 100
  },
  "notVisual": [
    "icon",
    "popoverPlacement",
    "popoverCrossOffset",
    "containerPadding",
    "href"
  ],
  "parts": {
    "container": {
      "kind": "box",
      "children": ["action-button"],
      "props": {
        "direction": {
          "value": "row"
        }
      }
    },
    "action-button": {
      "kind": "component",
      "sizeMap": {
        "m": "xs"
      },
      "with": {
        "isQuiet": true,
        "hideLabel": true
      }
    },
    "popover": {
      "kind": "box",
      "floating": {
        "side": "bottom",
        "align": "start",
        "offset": {
          "dimension": "popoverOffset"
        }
      },
      "children": ["title", "description", "link"],
      "props": {
        "direction": {
          "value": "column"
        },
        "minWidth": {
          "relationship": {
            "property": "minimum-width",
            "part": "popover"
          }
        },
        "paddingInlineStart": {
          "relationship": {
            "property": "padding",
            "part": "popover"
          }
        },
        "paddingInlineEnd": {
          "relationship": {
            "property": "padding",
            "part": "popover"
          }
        },
        "paddingBlockStart": {
          "relationship": {
            "property": "padding",
            "part": "popover"
          }
        },
        "paddingBlockEnd": {
          "relationship": {
            "property": "padding",
            "part": "popover"
          }
        },
        "gap": {
          "token": {
            "property": "gap",
            "structure": "container",
            "size": "xs"
          }
        },
        "fill": {
          "token": {
            "property": "color",
            "object": "background",
            "variant": "layer",
            "scaleIndex": 2
          }
        },
        "cornerRadius": {
          "token": {
            "property": "corner-radius",
            "state": "default",
            "size": "l"
          }
        },
        "shadow": {
          "shadow": [
            {
              "x": {
                "token": {
                  "structure": "drop-shadow",
                  "variant": "elevated",
                  "property": "x"
                }
              },
              "y": {
                "token": {
                  "structure": "drop-shadow",
                  "variant": "elevated",
                  "property": "y"
                }
              },
              "blur": {
                "token": {
                  "structure": "drop-shadow",
                  "variant": "elevated",
                  "property": "blur"
                }
              },
              "color": {
                "token": {
                  "structure": "drop-shadow",
                  "variant": "elevated",
                  "property": "color"
                }
              }
            }
          ]
        },
        "align": {
          "value": "start"
        },
        "width": {
          "relationship": {
            "property": "minimum-width",
            "part": "popover"
          }
        }
      }
    },
    "title": {
      "kind": "text",
      "props": {
        "fontFamily": {
          "token": {
            "property": "font-family",
            "family": "sans-serif"
          }
        },
        "fontSize": [
          {
            "when": {
              "modes": {
                "scale": "desktop"
              }
            },
            "token": {
              "property": "font-size-200"
            }
          },
          {
            "when": {
              "modes": {
                "scale": "mobile"
              }
            },
            "token": {
              "property": "font-size-100"
            }
          }
        ],
        "fontWeight": {
          "token": {
            "property": "font-weight",
            "weight": "bold"
          }
        },
        "lineHeight": {
          "token": {
            "property": "line-height",
            "referenceScaleIndex": 100
          }
        },
        "color": {
          "relationship": {
            "property": "color",
            "part": "title",
            "attribute": "background"
          }
        },
        "overflow": {
          "value": "wrap"
        }
      },
      "text": {
        "option": "title"
      }
    },
    "description": {
      "kind": "text",
      "props": {
        "fontFamily": {
          "relationship": {
            "property": "font-family",
            "part": "description"
          }
        },
        "fontSize": {
          "relationship": {
            "property": "font-size",
            "part": "description"
          }
        },
        "fontWeight": {
          "relationship": {
            "property": "font-weight",
            "part": "description"
          }
        },
        "lineHeight": {
          "relationship": {
            "property": "line-height",
            "part": "description"
          }
        },
        "color": {
          "relationship": {
            "property": "color",
            "part": "description",
            "attribute": "background"
          }
        },
        "overflow": {
          "value": "wrap"
        }
      },
      "text": {
        "option": "description"
      }
    },
    "link": {
      "kind": "component",
      "sizeMap": {
        "m": "m"
      },
      "with": {
        "label": {
          "option": "linkLabel"
        }
      }
    }
  }
}
