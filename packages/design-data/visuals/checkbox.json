{
  "$schema": "https://opensource.adobe.com/spectrum-design-data/schemas/v0/component-visual.schema.json",
  "specVersion": "1.0.0-draft",
  "component": "checkbox",
  "root": "container",
  "sizeScale": {
    "s": 75,
    "m": 100,
    "l": 200,
    "xl": 300
  },
  "derived": [
    {
      "context": "Spacing (top edge to control)",
      "property": "space-between",
      "part": "box",
      "from": "(height - label.lineHeight) / 2"
    },
    {
      "context": "Spacing (top/bottom edge to label)",
      "property": "component-top-to-text-{sizeIndex}",
      "part": "label",
      "from": "(height - label.lineHeight) / 2"
    },
    {
      "context": "Spacing (top/bottom edge to label)",
      "property": "component-bottom-to-text-{sizeIndex}",
      "part": "label",
      "edge": "bottom",
      "from": "(height - label.lineHeight) / 2"
    }
  ],
  "parts": {
    "container": {
      "kind": "box",
      "children": ["box", "label"],
      "props": {
        "direction": {
          "value": "row"
        },
        "align": {
          "value": "center"
        },
        "justify": {
          "value": "start"
        },
        "minHeight": {
          "relationship": { "property": "component-height-{sizeIndex}" }
        },
        "gap": {
          "relationship": {
            "property": "space-between",
            "between": { "from": "control", "to": "label" }
          }
        },
        "pressDifference": {
          "when": {
            "states": ["down"]
          },
          "relationship": { "property": "component-size-difference" }
        },
        "pressWidthRatio": {
          "when": {
            "states": ["down"]
          },
          "relationship": { "property": "component-size-width-ratio" }
        },
        "pressMinPerspective": {
          "when": {
            "states": ["down"]
          },
          "relationship": { "property": "component-size-minimum-perspective" }
        }
      },
      "pressTarget": "box"
    },
    "box": {
      "kind": "box",
      "children": ["checkmark", "dash"],
      "props": {
        "width": {
          "relationship": { "property": "size" }
        },
        "height": {
          "relationship": { "property": "size" }
        },
        "cornerRadius": {
          "relationship": { "property": "corner-radius" }
        },
        "strokeWidth": [
          {
            "relationship": { "property": "border-width" }
          },
          {
            "when": {
              "options": {
                "isSelected": true
              }
            },
            "value": 0,
            "priority": 1
          },
          {
            "when": {
              "options": {
                "isIndeterminate": true
              }
            },
            "value": 0,
            "priority": 1
          }
        ],
        "fill": [
          {
            "relationship": { "property": "color", "contextRole": ["control"] }
          },
          {
            "when": {
              "options": {
                "isSelected": true
              }
            },
            "relationship": { "property": "background-color" }
          },
          {
            "when": {
              "options": {
                "isIndeterminate": true
              }
            },
            "relationship": { "property": "background-color" }
          }
        ],
        "stroke": {
          "relationship": {
            "property": "content-color",
            "contextRole": ["control"]
          }
        }
      }
    },
    "checkmark": {
      "kind": "icon",
      "icon": { "set": "ui", "name": "checkmark" },
      "visibleWhen": {
        "options": {
          "isSelected": true,
          "isIndeterminate": false
        }
      },
      "props": {
        "width": [
          {
            "when": {
              "options": {
                "size": "s"
              }
            },
            "value": 8
          },
          {
            "when": {
              "options": {
                "size": "m"
              }
            },
            "value": 10
          },
          {
            "when": {
              "options": {
                "size": "l"
              }
            },
            "value": 10
          },
          {
            "when": {
              "options": {
                "size": "xl"
              }
            },
            "value": 12
          }
        ],
        "height": [
          {
            "when": {
              "options": {
                "size": "s"
              }
            },
            "value": 8
          },
          {
            "when": {
              "options": {
                "size": "m"
              }
            },
            "value": 10
          },
          {
            "when": {
              "options": {
                "size": "l"
              }
            },
            "value": 10
          },
          {
            "when": {
              "options": {
                "size": "xl"
              }
            },
            "value": 12
          }
        ],
        "color": {
          "relationship": { "property": "color", "contextRole": ["control"] }
        }
      }
    },
    "dash": {
      "kind": "icon",
      "icon": { "set": "ui", "name": "dash" },
      "visibleWhen": {
        "options": {
          "isIndeterminate": true
        }
      },
      "props": {
        "width": [
          {
            "when": {
              "options": {
                "size": "s"
              }
            },
            "value": 8
          },
          {
            "when": {
              "options": {
                "size": "m"
              }
            },
            "value": 10
          },
          {
            "when": {
              "options": {
                "size": "l"
              }
            },
            "value": 10
          },
          {
            "when": {
              "options": {
                "size": "xl"
              }
            },
            "value": 12
          }
        ],
        "height": [
          {
            "when": {
              "options": {
                "size": "s"
              }
            },
            "value": 8
          },
          {
            "when": {
              "options": {
                "size": "m"
              }
            },
            "value": 10
          },
          {
            "when": {
              "options": {
                "size": "l"
              }
            },
            "value": 10
          },
          {
            "when": {
              "options": {
                "size": "xl"
              }
            },
            "value": 12
          }
        ],
        "color": {
          "relationship": { "property": "color", "contextRole": ["control"] }
        }
      }
    },
    "label": {
      "kind": "text",
      "visibleWhen": {
        "options": {
          "label": true
        }
      },
      "props": {
        "overflow": {
          "value": "wrap"
        },
        "fontSize": {
          "relationship": { "property": "font-size-{sizeIndex}" }
        },
        "lineHeight": {
          "relationship": { "property": "line-height-font-size-{sizeIndex}" }
        },
        "fontWeight": {
          "relationship": { "property": "font-weight" }
        },
        "color": {
          "relationship": { "property": "content-color", "part": "label" }
        }
      }
    },
    "focus-indicator": {
      "kind": "ring",
      "around": "box",
      "visibleWhen": {
        "states": ["keyboard-focus"]
      },
      "props": {
        "stroke": {
          "relationship": { "property": "color", "part": "focus-indicator" }
        },
        "strokeWidth": {
          "relationship": { "property": "thickness" }
        },
        "gapToParent": {
          "relationship": { "property": "gap" }
        }
      }
    }
  }
}
