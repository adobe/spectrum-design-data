{
  "$schema": "https://opensource.adobe.com/spectrum-design-data/schemas/v0/component-visual.schema.json",
  "specVersion": "1.0.0-draft",
  "component": "link",
  "root": "container",
  "sizeScale": {
    "m": 100
  },
  "parts": {
    "container": {
      "kind": "box",
      "children": ["text"],
      "props": {
        "direction": { "value": "row" },
        "align": { "value": "center" },
        "justify": { "value": "center" },
        "cornerRadius": {
          "relationship": {
            "property": "corner-radius",
            "part": "container"
          }
        }
      }
    },
    "text": {
      "kind": "text",
      "props": {
        "fontFamily": {
          "relationship": { "property": "font-family", "part": "text" }
        },
        "fontSize": {
          "relationship": { "property": "font-size", "part": "text" }
        },
        "fontWeight": {
          "relationship": { "property": "font-weight", "part": "text" }
        },
        "lineHeight": {
          "relationship": { "property": "line-height", "part": "text" }
        },
        "color": [
          {
            "relationship": { "property": "content-color", "part": "text" }
          },
          {
            "when": { "options": { "staticColor": "white" } },
            "relationship": {
              "property": "color",
              "part": "text"
            }
          },
          {
            "when": { "options": { "staticColor": "black" } },
            "relationship": {
              "property": "color",
              "part": "text"
            }
          }
        ],
        "textDecoration": [
          {
            "when": { "options": { "isStandalone": false } },
            "value": "underline"
          },
          {
            "when": { "options": { "isStandalone": true, "isQuiet": false } },
            "value": "underline"
          },
          {
            "when": {
              "options": {
                "isStandalone": true,
                "isQuiet": true
              },
              "facets": {
                "hovered": "true"
              }
            },
            "value": "underline"
          },
          {
            "when": {
              "options": {
                "isStandalone": true,
                "isQuiet": true
              },
              "facets": {
                "focusVisible": "true"
              }
            },
            "value": "underline"
          }
        ],
        "underlineThickness": {
          "relationship": {
            "property": "underline-thickness",
            "part": "text"
          }
        },
        "underlineOffset": {
          "relationship": {
            "property": "gap",
            "part": "text"
          }
        }
      }
    },
    "focus-indicator": {
      "kind": "ring",
      "props": {
        "stroke": [
          {
            "relationship": { "property": "color", "part": "focus-indicator" }
          },
          {
            "when": { "options": { "staticColor": "white" } },
            "relationship": {
              "property": "color",
              "part": "focus-indicator"
            }
          },
          {
            "when": { "options": { "staticColor": "black" } },
            "relationship": {
              "property": "color",
              "part": "focus-indicator"
            }
          }
        ],
        "strokeWidth": {
          "relationship": { "property": "thickness", "part": "focus-indicator" }
        },
        "gapToParent": {
          "relationship": { "property": "gap", "part": "focus-indicator" }
        }
      }
    }
  }
}
