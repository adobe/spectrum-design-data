{
  "$schema": "https://opensource.adobe.com/spectrum-design-data/schemas/v0/component-visual.schema.json",
  "specVersion": "1.0.0-draft",
  "component": "in-field-progress-circle",
  "root": "track",
  "sizeScale": {
    "s": 75,
    "m": 100,
    "l": 200,
    "xl": 300
  },
  "parts": {
    "track": {
      "kind": "box",
      "children": ["fill"],
      "props": {
        "width": {
          "relationship": {
            "property": "size",
            "part": "track"
          }
        },
        "height": {
          "relationship": {
            "property": "size",
            "part": "track"
          }
        },
        "cornerRadius": {
          "value": 0.5,
          "relativeTo": "height"
        },
        "stroke": {
          "relationship": {
            "property": "color",
            "part": "track"
          }
        },
        "strokeWidth": {
          "relationship": {
            "property": "thickness",
            "part": "track"
          }
        }
      }
    },
    "fill": {
      "kind": "progress",
      "props": {
        "width": {
          "relationship": {
            "property": "size",
            "part": "track"
          }
        },
        "height": {
          "relationship": {
            "property": "size",
            "part": "track"
          }
        },
        "strokeWidth": {
          "relationship": {
            "property": "thickness",
            "part": "track"
          }
        },
        "color": {
          "relationship": {
            "property": "content-color",
            "part": "fill"
          }
        }
      }
    }
  }
}
