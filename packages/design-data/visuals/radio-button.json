{
  "$schema": "https://opensource.adobe.com/spectrum-design-data/schemas/v0/component-visual.schema.json",
  "specVersion": "1.0.0-draft",
  "component": "radio-button",
  "root": "container",
  "sizeScale": {
    "s": 75,
    "m": 100,
    "l": 200,
    "xl": 300
  },
  "parts": {
    "container": {
      "kind": "box",
      "children": ["control", "label"],
      "pressTarget": "control",
      "props": {
        "direction": {
          "value": "row"
        },
        "align": {
          "value": "center"
        },
        "height": {
          "relationship": {
            "property": "component-height-{sizeIndex}",
            "context": "Minimum height"
          }
        },
        "gap": {
          "relationship": {
            "property": "space-between",
            "context": "Spacing (control to label)"
          }
        },
        "pressDifference": {
          "when": {
            "states": ["down"]
          },
          "relationship": {
            "property": "component-size-difference",
            "context": "Component size (down)"
          }
        },
        "pressWidthRatio": {
          "when": {
            "states": ["down"]
          },
          "relationship": {
            "property": "component-size-width-ratio",
            "context": "Component size (down)"
          }
        },
        "pressMinPerspective": {
          "when": {
            "states": ["down"]
          },
          "relationship": {
            "property": "component-size-minimum-perspective",
            "context": "Component size (down)"
          }
        }
      }
    },
    "control": {
      "kind": "box",
      "children": ["selection-indicator"],
      "props": {
        "width": {
          "relationship": {
            "property": "size",
            "context": "Control (size)"
          }
        },
        "height": {
          "relationship": {
            "property": "size",
            "context": "Control (size)"
          }
        },
        "cornerRadius": {
          "relationship": {
            "property": "corner-radius",
            "context": "Control (rounding)"
          },
          "relativeTo": "height"
        },
        "strokeWidth": [
          {
            "relationship": {
              "property": "border-width",
              "context": "Control (border)"
            }
          },
          {
            "when": {
              "options": {
                "isSelected": true
              }
            },
            "value": 0,
            "priority": 1
          }
        ],
        "fill": [
          {
            "relationship": {
              "property": "color",
              "context": "Control"
            }
          },
          {
            "when": {
              "options": {
                "isSelected": true
              }
            },
            "relationship": {
              "property": "content-color",
              "context": "Control (selected, non emphasized)"
            }
          },
          {
            "when": {
              "options": {
                "isSelected": true,
                "isEmphasized": true
              }
            },
            "relationship": {
              "property": "content-color",
              "context": "Control (selected, emphasized)"
            }
          },
          {
            "when": {
              "options": {
                "isSelected": true,
                "isDisabled": true
              }
            },
            "relationship": {
              "property": "content-color",
              "context": "Control (disabled)"
            },
            "priority": 10
          }
        ],
        "stroke": [
          {
            "relationship": {
              "property": "content-color",
              "context": "Control"
            }
          },
          {
            "when": {
              "options": {
                "isDisabled": true
              }
            },
            "relationship": {
              "property": "content-color",
              "context": "Control (disabled)"
            },
            "priority": 10
          }
        ]
      }
    },
    "selection-indicator": {
      "kind": "box",
      "visibleWhen": {
        "options": {
          "isSelected": true
        }
      },
      "props": {
        "width": {
          "relationship": {
            "property": "width",
            "context": "Selection indicator"
          }
        },
        "height": {
          "relationship": {
            "property": "width",
            "context": "Selection indicator"
          }
        },
        "cornerRadius": {
          "relationship": {
            "property": "corner-radius",
            "context": "Control (rounding)"
          },
          "relativeTo": "height"
        },
        "fill": {
          "relationship": {
            "property": "color",
            "context": "Control"
          }
        }
      }
    },
    "label": {
      "kind": "text",
      "visibleWhen": {
        "options": {
          "label": true
        }
      },
      "props": {
        "fontSize": {
          "relationship": {
            "property": "font-size-{sizeIndex}",
            "context": "Label"
          }
        },
        "fontWeight": {
          "relationship": {
            "property": "font-weight",
            "context": "Label"
          }
        },
        "color": [
          {
            "relationship": {
              "property": "content-color",
              "context": "Label"
            }
          },
          {
            "when": {
              "options": {
                "isDisabled": true
              }
            },
            "relationship": {
              "property": "content-color",
              "context": "Label (disabled)"
            },
            "priority": 10
          }
        ]
      }
    },
    "focus-indicator": {
      "kind": "ring",
      "around": "control",
      "visibleWhen": {
        "states": ["keyboard-focus"]
      },
      "props": {
        "stroke": {
          "relationship": {
            "property": "color",
            "context": "Focus ring"
          }
        },
        "strokeWidth": {
          "relationship": {
            "property": "thickness",
            "context": "Focus ring"
          }
        },
        "gapToParent": {
          "relationship": {
            "property": "gap",
            "context": "Focus ring"
          }
        }
      }
    }
  }
}
