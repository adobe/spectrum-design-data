{
  "$schema": "https://opensource.adobe.com/spectrum-design-data/schemas/v0/component-visual.schema.json",
  "specVersion": "1.0.0-draft",
  "component": "radio-button",
  "root": "container",
  "sizeScale": {
    "s": 75,
    "m": 100,
    "l": 200,
    "xl": 300
  },
  "derived": [
    {
      "context": "Spacing (top edge to control)",
      "property": "space-between",
      "part": "control",
      "from": "(height - label.lineHeight) / 2"
    },
    {
      "context": "Spacing (top/bottom edge to label)",
      "property": "space-between",
      "part": "label",
      "from": "(height - label.lineHeight) / 2"
    },
    {
      "context": "Spacing (top/bottom edge to label)",
      "property": "space-between",
      "part": "label",
      "edge": "bottom",
      "from": "(height - label.lineHeight) / 2"
    }
  ],
  "parts": {
    "container": {
      "kind": "box",
      "children": ["control", "label"],
      "pressTarget": "control",
      "props": {
        "direction": {
          "value": "row"
        },
        "align": {
          "value": "center"
        },
        "justify": {
          "value": "start"
        },
        "minHeight": {
          "relationship": {
            "property": "minimum-height",
            "part": "container"
          }
        },
        "gap": {
          "relationship": {
            "property": "space-between",
            "between": {
              "from": "control",
              "to": "label"
            }
          }
        },
        "pressDifference": {
          "when": {
            "states": ["down"]
          },
          "relationship": {
            "property": "component-size-difference",
            "part": "container"
          }
        },
        "pressWidthRatio": {
          "when": {
            "states": ["down"]
          },
          "relationship": {
            "property": "component-size-width-ratio",
            "part": "container"
          }
        },
        "pressMinPerspective": {
          "when": {
            "states": ["down"]
          },
          "relationship": {
            "property": "component-size-minimum-perspective",
            "part": "container"
          }
        }
      }
    },
    "control": {
      "kind": "box",
      "children": ["selection-indicator"],
      "props": {
        "width": {
          "relationship": {
            "property": "size",
            "part": "control"
          }
        },
        "height": {
          "relationship": {
            "property": "size",
            "part": "control"
          }
        },
        "cornerRadius": {
          "relationship": {
            "property": "corner-radius",
            "part": "control"
          },
          "relativeTo": "height"
        },
        "strokeWidth": [
          {
            "relationship": {
              "property": "border-width",
              "part": "control"
            }
          },
          {
            "when": {
              "options": {
                "isSelected": true
              }
            },
            "value": 0,
            "priority": 1
          }
        ],
        "fill": [
          {
            "relationship": {
              "property": "color",
              "part": "control"
            }
          },
          {
            "when": {
              "options": {
                "isSelected": true
              }
            },
            "relationship": {
              "property": "background-color",
              "part": "control"
            }
          },
          {
            "when": {
              "options": {
                "isSelected": true,
                "isDisabled": true
              }
            },
            "relationship": {
              "property": "content-color",
              "part": "control"
            },
            "priority": 10
          }
        ],
        "stroke": [
          {
            "relationship": {
              "property": "content-color",
              "part": "control"
            }
          }
        ]
      }
    },
    "selection-indicator": {
      "kind": "box",
      "props": {
        "width": {
          "relationship": {
            "property": "width",
            "part": "selection-indicator"
          }
        },
        "height": {
          "relationship": {
            "property": "width",
            "part": "selection-indicator"
          }
        },
        "cornerRadius": {
          "relationship": {
            "property": "corner-radius",
            "part": "control"
          },
          "relativeTo": "height"
        },
        "fill": {
          "relationship": {
            "property": "color",
            "part": "control"
          }
        }
      }
    },
    "label": {
      "kind": "text",
      "props": {
        "overflow": {
          "value": "wrap"
        },
        "fontSize": {
          "relationship": {
            "property": "font-size",
            "part": "label"
          }
        },
        "lineHeight": {
          "relationship": {
            "property": "line-height",
            "part": "label"
          }
        },
        "fontWeight": {
          "relationship": {
            "property": "font-weight",
            "part": "label"
          }
        },
        "color": [
          {
            "relationship": {
              "property": "content-color",
              "part": "label"
            }
          }
        ]
      }
    },
    "focus-indicator": {
      "kind": "ring",
      "around": "control",
      "props": {
        "stroke": {
          "relationship": {
            "property": "color",
            "part": "focus-indicator"
          }
        },
        "strokeWidth": {
          "relationship": {
            "property": "thickness",
            "part": "focus-indicator"
          }
        },
        "gapToParent": {
          "relationship": {
            "property": "gap",
            "part": "focus-indicator"
          }
        }
      }
    }
  }
}
