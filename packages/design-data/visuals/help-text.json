{
  "$schema": "https://opensource.adobe.com/spectrum-design-data/schemas/v0/component-visual.schema.json",
  "specVersion": "1.0.0-draft",
  "component": "help-text",
  "root": "container",
  "sizeScale": { "s": 75, "m": 100, "l": 200, "xl": 300 },
  "parts": {
    "container": {
      "kind": "box",
      "children": ["icon", "text"],
      "props": {
        "direction": { "value": "row" },
        "align": { "value": "start" },
        "gap": {
          "relationship": {
            "property": "space-between",
            "between": { "from": "icon", "to": "text" }
          }
        }
      }
    },
    "icon": {
      "kind": "icon",
      "icon": {
        "set": "workflow",
        "name": "alert-triangle"
      },
      "props": {
        "width": { "relationship": { "property": "size", "part": "icon" } },
        "height": { "relationship": { "property": "size", "part": "icon" } },
        "color": [
          {
            "relationship": {
              "property": "content-color",
              "part": "icon"
            }
          },
          {
            "when": { "options": { "isDisabled": true } },
            "relationship": {
              "property": "content-color",
              "part": "container"
            }
          }
        ]
      }
    },
    "text": {
      "kind": "text",
      "props": {
        "typeStyle": {
          "relationship": { "property": "type-style", "part": "text" }
        },
        "lineHeight": {
          "relationship": { "property": "line-height", "part": "text" }
        },
        "color": [
          {
            "relationship": { "property": "content-color", "part": "text" }
          },
          {
            "when": { "options": { "variant": "negative" } },
            "relationship": {
              "property": "content-color",
              "part": "icon"
            }
          },
          {
            "when": { "options": { "isDisabled": true } },
            "relationship": {
              "property": "content-color",
              "part": "container"
            }
          }
        ]
      },
      "text": { "option": "text" }
    }
  }
}
