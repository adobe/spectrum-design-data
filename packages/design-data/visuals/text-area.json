{
  "$schema": "https://opensource.adobe.com/spectrum-design-data/schemas/v0/component-visual.schema.json",
  "specVersion": "1.0.0-draft",
  "component": "text-area",
  "root": "container",
  "sizeScale": {
    "s": 75,
    "m": 100,
    "l": 200,
    "xl": 300
  },
  "notVisual": [
    "labelPosition",
    "hasCharacterCount",
    "errorMessage",
    "hideDragIcon",
    "inputType",
    "width"
  ],
  "parts": {
    "container": {
      "kind": "box",
      "children": ["field-label", "field", "help-text"],
      "props": {
        "direction": {
          "value": "column"
        },
        "align": {
          "value": "start"
        },
        "gap": {
          "value": 0
        },
        "width": {
          "relationship": {
            "property": "width",
            "part": "container"
          }
        }
      }
    },
    "field-label": {
      "kind": "component",
      "sizeMap": {
        "s": "s",
        "m": "m",
        "l": "l",
        "xl": "xl"
      },
      "with": {
        "isRequired": {
          "option": "isRequired"
        },
        "necessityIndicator": {
          "option": "necessityIndicator"
        },
        "isDisabled": {
          "option": "isDisabled"
        },
        "label": {
          "option": "label"
        }
      }
    },
    "field": {
      "kind": "box",
      "children": ["value", "validation-marker"],
      "props": {
        "direction": {
          "value": "row"
        },
        "align": {
          "value": "start"
        },
        "paddingInlineStart": {
          "relationship": {
            "property": "space-between",
            "part": "field",
            "between": {
              "from": "start-edge",
              "to": "value"
            }
          }
        },
        "paddingInlineEnd": [
          {
            "relationship": {
              "property": "space-between",
              "part": "field",
              "between": {
                "from": "value",
                "to": "end-edge"
              }
            }
          },
          {
            "when": {
              "options": {
                "showValidIcon": true,
                "isError": false
              }
            },
            "relationship": {
              "property": "space-between",
              "part": "field",
              "between": {
                "from": "validation-marker",
                "to": "end-edge"
              }
            }
          }
        ],
        "cornerRadius": {
          "relationship": {
            "property": "corner-radius",
            "part": "field"
          }
        },
        "fill": {
          "relationship": {
            "property": "color",
            "attribute": "background",
            "part": "field"
          }
        },
        "stroke": {
          "relationship": {
            "property": "color",
            "attribute": "border",
            "part": "field"
          }
        },
        "strokeWidth": {
          "relationship": {
            "property": "border-width",
            "part": "field"
          }
        },
        "height": [
          {
            "dimension": "height"
          },
          {
            "when": {
              "options": {
                "size": "l"
              }
            },
            "relationship": {
              "property": "minimum-height",
              "part": "field"
            }
          }
        ],
        "paddingBlockStart": [
          {
            "when": {
              "options": {
                "size": ["m", "l", "xl"]
              }
            },
            "relationship": {
              "property": "space-between",
              "part": "field",
              "between": {
                "from": "top-edge",
                "to": "value"
              }
            }
          }
        ],
        "paddingBlockEnd": [
          {
            "when": {
              "options": {
                "size": ["m", "l", "xl"]
              }
            },
            "relationship": {
              "property": "space-between",
              "part": "field",
              "between": {
                "from": "value",
                "to": "bottom-edge"
              }
            }
          }
        ]
      }
    },
    "value": {
      "kind": "text",
      "props": {
        "grow": {
          "value": true
        },
        "overflow": {
          "value": "truncate"
        },
        "typeStyle": {
          "relationship": {
            "property": "type-style",
            "part": "value"
          }
        },
        "color": [
          {
            "relationship": {
              "property": "content-color",
              "part": "value"
            }
          },
          {
            "when": {
              "options": {
                "isDisabled": true
              }
            },
            "priority": 10,
            "relationship": {
              "property": "content-color",
              "part": "field"
            }
          }
        ]
      },
      "text": {
        "option": "value"
      }
    },
    "validation-marker": {
      "kind": "icon",
      "icon": {
        "set": "ui",
        "name": "checkmark"
      },
      "props": {
        "color": {
          "relationship": {
            "property": "color",
            "part": "validation-marker"
          }
        }
      }
    },
    "focus-indicator": {
      "kind": "ring",
      "around": "field",
      "props": {
        "stroke": {
          "relationship": {
            "property": "color",
            "part": "focus-indicator"
          }
        },
        "strokeWidth": {
          "relationship": {
            "property": "thickness",
            "part": "focus-indicator"
          }
        }
      }
    },
    "help-text": {
      "kind": "component",
      "sizeMap": {
        "s": "s",
        "m": "m",
        "l": "l",
        "xl": "xl"
      },
      "with": {
        "text": {
          "option": "helpText"
        },
        "isDisabled": {
          "option": "isDisabled"
        },
        "variant": {
          "option": "isError",
          "map": { "true": "negative", "false": "neutral" }
        }
      }
    }
  }
}
