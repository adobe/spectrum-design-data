{
  "$schema": "https://opensource.adobe.com/spectrum-design-data/schemas/v0/component-visual.schema.json",
  "specVersion": "1.0.0-draft",
  "component": "progress-bar",
  "root": "container",
  "sizeScale": {
    "s": 75,
    "m": 100,
    "l": 200,
    "xl": 300
  },
  "notVisual": ["width", "labelPosition"],
  "parts": {
    "container": {
      "kind": "box",
      "children": ["header", "track"],
      "props": {
        "direction": {
          "value": "column"
        },
        "align": {
          "value": "center"
        },
        "minWidth": {
          "relationship": {
            "property": "minimum-width",
            "part": "container"
          }
        },
        "gap": {
          "relationship": {
            "property": "gap",
            "part": "container"
          }
        }
      }
    },
    "header": {
      "kind": "box",
      "children": ["label", "value"],
      "props": {
        "direction": {
          "value": "row"
        },
        "align": {
          "value": "center"
        },
        "gap": {
          "relationship": {
            "property": "spacing",
            "part": "header"
          }
        }
      }
    },
    "label": {
      "kind": "text",
      "props": {
        "fontSize": {
          "relationship": {
            "property": "font-size",
            "part": "label"
          }
        },
        "lineHeight": {
          "relationship": {
            "property": "line-height",
            "part": "label"
          }
        },
        "fontWeight": {
          "relationship": {
            "property": "font-weight",
            "part": "label"
          }
        },
        "color": {
          "relationship": {
            "property": "content-color",
            "part": "label"
          }
        },
        "grow": {
          "value": true
        }
      }
    },
    "value": {
      "kind": "text",
      "props": {
        "fontSize": {
          "relationship": {
            "property": "font-size",
            "part": "label"
          }
        },
        "lineHeight": {
          "relationship": {
            "property": "line-height",
            "part": "label"
          }
        },
        "fontWeight": {
          "relationship": {
            "property": "font-weight",
            "part": "label"
          }
        },
        "color": {
          "relationship": {
            "property": "content-color",
            "part": "label"
          }
        }
      },
      "text": {
        "option": "valueLabel",
        "fraction": {
          "value": "value",
          "min": "minValue",
          "max": "maxValue"
        }
      }
    },
    "track": {
      "kind": "box",
      "children": ["fill"],
      "props": {
        "height": {
          "relationship": {
            "property": "thickness",
            "part": "track"
          }
        },
        "grow": {
          "value": true
        },
        "cornerRadius": {
          "relationship": {
            "property": "corner-radius",
            "part": "track"
          },
          "relativeTo": "height"
        },
        "fill": {
          "relationship": {
            "property": "color",
            "part": "track"
          }
        }
      }
    },
    "fill": {
      "kind": "box",
      "props": {
        "width": [
          {
            "fraction": {
              "value": "value",
              "min": "minValue",
              "max": "maxValue"
            }
          },
          {
            "when": {
              "options": {
                "isIndeterminate": true
              }
            },
            "value": 0.75,
            "relativeTo": "parent"
          }
        ],
        "justify": [
          {
            "value": "start"
          },
          {
            "when": {
              "options": {
                "isIndeterminate": true
              }
            },
            "value": "end"
          }
        ],
        "cornerRadius": {
          "relationship": {
            "property": "corner-radius",
            "part": "track"
          },
          "relativeTo": "height"
        },
        "fill": {
          "relationship": {
            "property": "content-color",
            "part": "fill"
          }
        }
      }
    }
  }
}
