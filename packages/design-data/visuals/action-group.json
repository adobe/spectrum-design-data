{
  "$schema": "https://opensource.adobe.com/spectrum-design-data/schemas/v0/component-visual.schema.json",
  "specVersion": "1.0.0-draft",
  "component": "action-group",
  "root": "container",
  "sizeScale": {
    "s": 75,
    "m": 100,
    "l": 100,
    "xl": 100
  },
  "notVisual": [
    "isJustified",
    "enableSelection",
    "selectionMode",
    "allowsEmptySelection",
    "overflowMode"
  ],
  "parts": {
    "container": {
      "kind": "box",
      "children": ["action-buttons"],
      "props": {
        "direction": {
          "value": "row"
        }
      }
    },
    "action-buttons": {
      "kind": "slot",
      "sizeMap": {
        "s": "s",
        "m": "m",
        "l": "l",
        "xl": "xl"
      },
      "with": {
        "isQuiet": {
          "option": "isQuiet"
        },
        "isEmphasized": {
          "option": "isEmphasized"
        },
        "isDisabled": {
          "option": "isDisabled"
        }
      },
      "props": {
        "direction": [
          {
            "when": {
              "options": {
                "orientation": "vertical"
              }
            },
            "value": "column"
          },
          {
            "value": "row"
          }
        ],
        "gap": {
          "relationship": {
            "property": "space-between",
            "between": {
              "from": "action-button",
              "to": "action-button"
            }
          }
        }
      }
    }
  }
}
