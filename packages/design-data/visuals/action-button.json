{
  "$schema": "https://opensource.adobe.com/spectrum-design-data/schemas/v0/component-visual.schema.json",
  "specVersion": "1.0.0-draft",
  "component": "action-button",
  "root": "container",
  "sizeScale": {
    "xs": 50,
    "s": 75,
    "m": 100,
    "l": 200,
    "xl": 300
  },
  "notVisual": ["icon"],
  "derived": [
    {
      "context": "Spacing (top edge to icon)",
      "property": "space-between",
      "part": "icon",
      "from": "(height - label.lineHeight) / 2"
    },
    {
      "context": "Spacing (top edge to label)",
      "property": "space-between",
      "part": "label",
      "from": "(height - label.lineHeight) / 2"
    }
  ],
  "parts": {
    "container": {
      "kind": "box",
      "children": ["icon", "progress", "label", "hold-icon"],
      "props": {
        "direction": {
          "value": "row"
        },
        "align": {
          "value": "center"
        },
        "justify": {
          "value": "center"
        },
        "height": {
          "relationship": {
            "property": "height",
            "part": "container"
          }
        },
        "paddingInlineStart": [
          {
            "relationship": {
              "property": "space-between",
              "part": "container",
              "between": {
                "from": "start-edge",
                "to": "icon"
              }
            }
          },
          {
            "when": {
              "options": {
                "hideLabel": true
              }
            },
            "relationship": {
              "property": "space-between",
              "part": "container",
              "between": {
                "from": "start-edge",
                "to": "icon"
              }
            }
          }
        ],
        "paddingInlineEnd": [
          {
            "relationship": {
              "property": "space-between",
              "part": "container",
              "between": {
                "from": "start-edge",
                "to": "icon"
              }
            }
          },
          {
            "when": {
              "options": {
                "hideLabel": true
              }
            },
            "relationship": {
              "property": "space-between",
              "part": "container",
              "between": {
                "from": "start-edge",
                "to": "icon"
              }
            }
          }
        ],
        "gap": {
          "relationship": {
            "property": "space-between",
            "part": "container",
            "between": {
              "from": "icon",
              "to": "label"
            }
          }
        },
        "cornerRadius": {
          "relationship": {
            "property": "corner-radius",
            "part": "container"
          }
        },
        "fill": [
          {
            "when": {
              "options": {
                "isQuiet": true
              }
            },
            "value": "transparent"
          },
          {
            "when": {
              "options": {
                "isQuiet": true,
                "isDisabled": true
              }
            },
            "priority": 11,
            "value": "transparent"
          },
          {
            "when": {
              "options": {
                "isQuiet": false
              }
            },
            "relationship": {
              "property": "color",
              "attribute": "background",
              "part": "container"
            }
          },
          {
            "when": {
              "options": {
                "isDisabled": false,
                "staticColor": ["black", "white"]
              }
            },
            "relationship": {
              "property": "color",
              "attribute": "background",
              "part": "container"
            }
          },
          {
            "when": {
              "options": {
                "isDisabled": false,
                "isSelected": true
              }
            },
            "relationship": {
              "property": "color",
              "attribute": "background",
              "part": "container"
            }
          },
          {
            "when": {
              "options": {
                "isDisabled": false,
                "isPending": true
              }
            },
            "relationship": {
              "property": "color",
              "attribute": "background",
              "part": "container"
            }
          },
          {
            "when": {
              "options": {
                "isDisabled": false,
                "isPending": false,
                "isQuiet": true,
                "isSelected": false
              },
              "states": ["hover"]
            },
            "relationship": {
              "property": "color",
              "attribute": "background",
              "part": "container"
            }
          },
          {
            "when": {
              "options": {
                "isDisabled": false,
                "isPending": false,
                "isQuiet": true,
                "isSelected": false
              },
              "states": ["down"]
            },
            "relationship": {
              "property": "color",
              "attribute": "background",
              "part": "container"
            }
          }
        ],
        "pressDifference": {
          "when": {
            "states": ["down"]
          },
          "relationship": {
            "property": "component-size-difference",
            "part": "container"
          }
        },
        "pressWidthRatio": {
          "when": {
            "states": ["down"]
          },
          "relationship": {
            "property": "component-size-width-ratio",
            "part": "container"
          }
        },
        "pressMinPerspective": {
          "when": {
            "states": ["down"]
          },
          "relationship": {
            "property": "component-size-minimum-perspective",
            "part": "container"
          }
        },
        "pressMaxPerspective": {
          "when": {
            "states": ["down"]
          },
          "relationship": {
            "property": "component-size-maximum-perspective",
            "part": "container"
          }
        }
      }
    },
    "icon": {
      "kind": "icon",
      "icon": {
        "set": "workflow",
        "name": "add",
        "content": true,
        "optional": true
      },
      "props": {
        "width": {
          "relationship": {
            "property": "size",
            "part": "icon"
          }
        },
        "height": {
          "relationship": {
            "property": "size",
            "part": "icon"
          }
        },
        "color": [
          {
            "when": {
              "options": {
                "isPending": false
              }
            },
            "relationship": {
              "property": "color",
              "part": "icon"
            }
          }
        ]
      }
    },
    "label": {
      "kind": "text",
      "props": {
        "fontSize": {
          "relationship": {
            "property": "font-size",
            "part": "label"
          }
        },
        "lineHeight": {
          "relationship": {
            "property": "line-height",
            "part": "label"
          }
        },
        "fontWeight": {
          "relationship": {
            "property": "font-weight",
            "part": "label"
          }
        },
        "color": [
          {
            "when": {
              "options": {
                "hideLabel": false,
                "isPending": false
              }
            },
            "relationship": {
              "property": "color",
              "part": "label"
            }
          }
        ]
      }
    },
    "hold-icon": {
      "kind": "icon",
      "icon": {
        "set": "ui",
        "name": "corner-triangle"
      },
      "placement": {
        "anchor": "bottom-end",
        "inset": {
          "relationship": {
            "property": "space-between",
            "part": "container",
            "between": {
              "from": "bottom-edge",
              "to": "hold-icon"
            }
          }
        }
      },
      "props": {
        "color": [
          {
            "when": {
              "options": {
                "hasHoldIcon": true,
                "isPending": false
              }
            },
            "relationship": {
              "property": "color",
              "part": "hold-icon"
            }
          }
        ]
      }
    },
    "focus-indicator": {
      "kind": "ring",
      "props": {
        "stroke": {
          "relationship": {
            "property": "color",
            "part": "focus-indicator"
          }
        },
        "strokeWidth": {
          "relationship": {
            "property": "thickness",
            "part": "focus-indicator"
          }
        },
        "gapToParent": {
          "relationship": {
            "property": "gap",
            "part": "focus-indicator"
          }
        }
      }
    },
    "progress": {
      "kind": "progress",
      "props": {
        "width": {
          "relationship": {
            "property": "size",
            "part": "icon"
          }
        },
        "height": {
          "relationship": {
            "property": "size",
            "part": "icon"
          }
        },
        "trackColor": {
          "relationship": {
            "property": "color",
            "part": "progress"
          }
        },
        "color": {
          "relationship": {
            "property": "content-color",
            "part": "progress"
          }
        }
      }
    }
  }
}
