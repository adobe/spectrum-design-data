{
  "$schema": "https://opensource.adobe.com/spectrum-design-data/schemas/v0/component-visual.schema.json",
  "specVersion": "1.0.0-draft",
  "component": "action-button",
  "root": "container",
  "sizeScale": {
    "xs": 50,
    "s": 75,
    "m": 100,
    "l": 200,
    "xl": 300
  },
  "notVisual": ["icon"],
  "derived": [
    {
      "context": "Spacing (top edge to icon)",
      "property": "component-top-to-workflow-icon-{sizeIndex}",
      "part": "icon",
      "from": "(height - label.lineHeight) / 2"
    },
    {
      "context": "Spacing (top edge to label)",
      "property": "component-top-to-text-{sizeIndex}",
      "part": "label",
      "from": "(height - label.lineHeight) / 2"
    }
  ],
  "parts": {
    "container": {
      "kind": "box",
      "children": ["icon", "progress", "label", "hold-icon"],
      "props": {
        "direction": {
          "value": "row"
        },
        "align": {
          "value": "center"
        },
        "justify": {
          "value": "center"
        },
        "height": {
          "relationship": {
            "property": "component-height-{sizeIndex}",
            "context": "Height"
          }
        },
        "paddingInlineStart": [
          {
            "relationship": {
              "property": "component-edge-to-visual-{sizeIndex}",
              "context": "Spacing (start/end edges)"
            }
          },
          {
            "when": {
              "options": {
                "hideLabel": true
              }
            },
            "relationship": {
              "property": "component-edge-to-visual-only-{sizeIndex}",
              "context": "Spacing (start/end edges, icon only)"
            }
          }
        ],
        "paddingInlineEnd": [
          {
            "relationship": {
              "property": "component-edge-to-visual-{sizeIndex}",
              "context": "Spacing (start/end edges)"
            }
          },
          {
            "when": {
              "options": {
                "hideLabel": true
              }
            },
            "relationship": {
              "property": "component-edge-to-visual-only-{sizeIndex}",
              "context": "Spacing (start/end edges, icon only)"
            }
          }
        ],
        "gap": {
          "relationship": {
            "property": "space-between",
            "context": "Spacing (icon to label)"
          }
        },
        "cornerRadius": {
          "relationship": {
            "property": "corner-radius",
            "context": "Rounding"
          }
        },
        "fill": [
          {
            "when": {
              "options": {
                "isQuiet": true
              }
            },
            "value": "transparent"
          },
          {
            "when": {
              "options": {
                "isQuiet": true
              },
              "facets": {
                "disabled": "true"
              }
            },
            "priority": 11,
            "value": "transparent"
          },
          {
            "when": {
              "options": {
                "isQuiet": false
              }
            },
            "relationship": {
              "property": "color",
              "context": "Background"
            }
          },
          {
            "when": {
              "options": {
                "staticColor": ["black", "white"]
              },
              "facets": {
                "disabled": "false"
              }
            },
            "relationship": {
              "property": "color",
              "context": "Background"
            }
          },
          {
            "when": {
              "facets": {
                "disabled": "false",
                "selected": "selected"
              }
            },
            "relationship": {
              "property": "color",
              "context": "Background"
            }
          },
          {
            "when": {
              "facets": {
                "disabled": "false",
                "pending": "true"
              }
            },
            "relationship": {
              "property": "color",
              "context": "Background"
            }
          },
          {
            "when": {
              "options": {
                "isQuiet": true
              },
              "facets": {
                "disabled": "false",
                "selected": "unselected",
                "pending": "false",
                "hovered": "true"
              }
            },
            "relationship": {
              "property": "color",
              "context": "Background"
            }
          },
          {
            "when": {
              "options": {
                "isQuiet": true
              },
              "facets": {
                "disabled": "false",
                "selected": "unselected",
                "pending": "false",
                "pressed": "true"
              }
            },
            "relationship": {
              "property": "color",
              "context": "Background"
            }
          }
        ],
        "pressDifference": {
          "when": {
            "facets": {
              "pressed": "true"
            }
          },
          "relationship": {
            "property": "component-size-difference",
            "context": "Component size (down)"
          }
        },
        "pressWidthRatio": {
          "when": {
            "facets": {
              "pressed": "true"
            }
          },
          "relationship": {
            "property": "component-size-width-ratio",
            "context": "Component size (down)"
          }
        },
        "pressMinPerspective": {
          "when": {
            "facets": {
              "pressed": "true"
            }
          },
          "relationship": {
            "property": "component-size-minimum-perspective",
            "context": "Component size (down)"
          }
        },
        "pressMaxPerspective": {
          "when": {
            "facets": {
              "pressed": "true"
            }
          },
          "relationship": {
            "property": "component-size-maximum-perspective",
            "context": "Component size (down)"
          }
        }
      }
    },
    "icon": {
      "kind": "icon",
      "icon": {
        "set": "workflow",
        "name": "add",
        "content": true,
        "optional": true
      },
      "props": {
        "width": {
          "relationship": {
            "property": "workflow-icon-size-{sizeIndex}",
            "context": "Icon"
          }
        },
        "height": {
          "relationship": {
            "property": "workflow-icon-size-{sizeIndex}",
            "context": "Icon"
          }
        },
        "color": [
          {
            "when": {
              "facets": {
                "pending": "false"
              }
            },
            "relationship": {
              "property": "color",
              "context": "Icon"
            }
          }
        ]
      }
    },
    "label": {
      "kind": "text",
      "props": {
        "fontSize": {
          "relationship": {
            "property": "font-size-{sizeIndex}",
            "context": "Label"
          }
        },
        "lineHeight": {
          "relationship": {
            "property": "line-height-font-size-{sizeIndex}",
            "context": "Label"
          }
        },
        "fontWeight": {
          "relationship": {
            "property": "font-weight",
            "context": "Label"
          }
        },
        "color": [
          {
            "when": {
              "options": {
                "hideLabel": false
              },
              "facets": {
                "pending": "false"
              }
            },
            "relationship": {
              "property": "color",
              "context": "Label"
            }
          }
        ]
      }
    },
    "hold-icon": {
      "kind": "icon",
      "icon": {
        "set": "ui",
        "name": "corner-triangle"
      },
      "placement": {
        "anchor": "bottom-end",
        "inset": {
          "relationship": {
            "property": "space-between",
            "context": "Spacing (edge to hold icon)"
          }
        }
      },
      "props": {
        "color": [
          {
            "when": {
              "options": {
                "hasHoldIcon": true
              },
              "facets": {
                "pending": "false"
              }
            },
            "relationship": {
              "property": "color",
              "context": "Hold icon"
            }
          }
        ]
      }
    },
    "focus-indicator": {
      "kind": "ring",
      "props": {
        "stroke": {
          "relationship": {
            "property": "color",
            "context": "Focus ring"
          }
        },
        "strokeWidth": {
          "relationship": {
            "property": "thickness",
            "context": "Focus ring"
          }
        },
        "gapToParent": {
          "relationship": {
            "property": "gap",
            "context": "Focus ring"
          }
        }
      }
    },
    "progress": {
      "kind": "progress",
      "props": {
        "width": {
          "relationship": {
            "property": "workflow-icon-size-{sizeIndex}",
            "context": "Icon"
          }
        },
        "height": {
          "relationship": {
            "property": "workflow-icon-size-{sizeIndex}",
            "context": "Icon"
          }
        },
        "trackColor": {
          "relationship": {
            "property": "color",
            "context": "Progress track"
          }
        },
        "color": {
          "relationship": {
            "property": "color",
            "context": "Progress"
          }
        }
      }
    }
  }
}
