{
  "$schema": "https://opensource.adobe.com/spectrum-design-data/schemas/v0/component-visual.schema.json",
  "specVersion": "1.0.0-draft",
  "component": "switch",
  "root": "container",
  "sizeScale": { "s": 75, "m": 100, "l": 200, "xl": 300 },
  "notVisual": ["isReadOnly"],
  "derived": [
    {
      "context": "Spacing (top edge to control)",
      "property": "space-between",
      "part": "track",
      "from": "(height - label.lineHeight) / 2"
    },
    {
      "context": "Spacing (top/bottom edge to label)",
      "property": "component-top-to-text-{sizeIndex}",
      "part": "label",
      "from": "(height - label.lineHeight) / 2"
    },
    {
      "context": "Spacing (top/bottom edge to label)",
      "property": "component-bottom-to-text-{sizeIndex}",
      "part": "label",
      "edge": "bottom",
      "from": "(height - label.lineHeight) / 2"
    }
  ],
  "parts": {
    "container": {
      "kind": "box",
      "children": ["track", "label"],
      "pressTarget": "handle",
      "props": {
        "direction": { "value": "row" },
        "align": { "value": "center" },
        "justify": { "value": "start" },
        "minHeight": {
          "relationship": {
            "property": "component-height-{sizeIndex}",
            "contextRole": ["height"]
          }
        },
        "gap": {
          "relationship": {
            "property": "space-between",
            "contextRole": ["spacing"],
            "contextQualifier": "control to label",
            "between": { "from": "control", "to": "label" }
          }
        },
        "pressDifference": {
          "when": { "states": ["down"] },
          "relationship": {
            "property": "component-size-difference",
            "contextRole": ["size"],
            "contextQualifier": "down"
          }
        },
        "pressWidthRatio": {
          "when": { "states": ["down"] },
          "relationship": {
            "property": "component-size-width-ratio",
            "contextRole": ["size"],
            "contextQualifier": "down"
          }
        },
        "pressMinPerspective": {
          "when": { "states": ["down"] },
          "relationship": {
            "property": "component-size-minimum-perspective",
            "contextRole": ["size"],
            "contextQualifier": "down"
          }
        }
      }
    },
    "track": {
      "kind": "box",
      "children": ["handle"],
      "props": {
        "width": {
          "relationship": {
            "property": "width",
            "contextRole": ["track"],
            "contextQualifier": "size",
            "part": "track"
          }
        },
        "height": {
          "relationship": {
            "property": "height",
            "contextRole": ["track"],
            "contextQualifier": "size",
            "part": "track"
          }
        },
        "cornerRadius": {
          "relationship": {
            "property": "corner-radius",
            "contextRole": ["rounding"]
          },
          "relativeTo": "height"
        },
        "strokeWidth": {
          "relationship": {
            "property": "border-width",
            "contextRole": ["track"],
            "contextQualifier": "border",
            "part": "track"
          }
        },
        "fill": [
          {
            "relationship": { "property": "color", "contextRole": ["control"] }
          },
          {
            "when": { "options": { "isSelected": true } },
            "relationship": {
              "property": "background-color",
              "contextRole": ["track"],
              "part": "track"
            }
          },
          {
            "when": { "options": { "isSelected": true, "isEmphasized": true } },
            "relationship": {
              "property": "content-color",
              "contextRole": ["control"]
            }
          },
          {
            "when": { "options": { "isSelected": true, "isDisabled": true } },
            "relationship": {
              "property": "background-color",
              "contextRole": ["track"],
              "part": "track"
            },
            "priority": 10
          }
        ],
        "stroke": [
          {
            "relationship": {
              "property": "border-color",
              "contextRole": ["control"],
              "part": "track"
            }
          },
          {
            "when": { "options": { "isSelected": true } },
            "relationship": {
              "property": "background-color",
              "contextRole": ["track"],
              "part": "track"
            }
          },
          {
            "when": { "options": { "isSelected": true, "isEmphasized": true } },
            "relationship": {
              "property": "content-color",
              "contextRole": ["control"]
            }
          },
          {
            "when": { "options": { "isSelected": true, "isDisabled": true } },
            "relationship": {
              "property": "background-color",
              "contextRole": ["track"],
              "part": "track"
            },
            "priority": 11
          }
        ]
      }
    },
    "handle": {
      "kind": "box",
      "props": {
        "width": [
          {
            "relationship": {
              "property": "size",
              "contextRole": ["control"],
              "contextQualifier": "size",
              "part": "handle"
            }
          }
        ],
        "height": [
          {
            "relationship": {
              "property": "size",
              "contextRole": ["control"],
              "contextQualifier": "size",
              "part": "handle"
            }
          }
        ],
        "cornerRadius": {
          "relationship": {
            "property": "corner-radius",
            "contextRole": ["rounding"]
          },
          "relativeTo": "height"
        },
        "justify": [
          { "value": "start" },
          { "when": { "options": { "isSelected": true } }, "value": "end" }
        ],
        "fill": [
          {
            "relationship": {
              "property": "background-color",
              "contextRole": ["control"],
              "part": "handle"
            }
          },
          {
            "when": { "options": { "isSelected": true } },
            "relationship": { "property": "color", "contextRole": ["control"] }
          },
          {
            "when": { "options": { "isSelected": true, "isDisabled": true } },
            "relationship": { "property": "color", "contextRole": ["control"] },
            "priority": 11
          }
        ]
      }
    },
    "label": {
      "kind": "text",
      "visibleWhen": { "options": { "hideLabel": false } },
      "props": {
        "overflow": {
          "value": "wrap"
        },
        "fontSize": {
          "relationship": {
            "property": "font-size-{sizeIndex}",
            "contextRole": ["size"]
          }
        },
        "lineHeight": {
          "relationship": {
            "property": "line-height-font-size-{sizeIndex}",
            "contextRole": ["label"]
          }
        },
        "fontWeight": {
          "relationship": { "property": "font-weight", "contextRole": ["size"] }
        },
        "color": [
          {
            "relationship": {
              "property": "content-color",
              "contextRole": ["label"]
            }
          }
        ]
      }
    },
    "focus-indicator": {
      "kind": "ring",
      "around": "track",
      "visibleWhen": { "states": ["keyboard-focus"] },
      "props": {
        "stroke": {
          "relationship": { "property": "color", "contextRole": ["focus"] }
        },
        "strokeWidth": {
          "relationship": { "property": "thickness", "contextRole": ["focus"] }
        },
        "gapToParent": {
          "relationship": { "property": "gap", "contextRole": ["focus"] }
        }
      }
    }
  }
}
