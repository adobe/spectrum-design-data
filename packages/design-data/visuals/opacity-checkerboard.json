{
  "$schema": "https://opensource.adobe.com/spectrum-design-data/schemas/v0/component-visual.schema.json",
  "specVersion": "1.0.0-draft",
  "component": "opacity-checkerboard",
  "root": "container",
  "sizeScale": {
    "s": 1,
    "m": 2
  },
  "parts": {
    "container": {
      "kind": "box",
      "props": {
        "width": {
          "dimension": "horizontalSize"
        },
        "height": {
          "dimension": "verticalSize"
        },
        "fill": {
          "relationship": {
            "property": "color",
            "part": "light-tile",
            "context": "Square"
          }
        },
        "patternFill": {
          "relationship": {
            "property": "color",
            "part": "dark-tile",
            "context": "Square"
          }
        },
        "patternSize": {
          "relationship": {
            "property": "size",
            "context": "Square size"
          }
        }
      }
    }
  }
}
