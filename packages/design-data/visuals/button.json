{
  "$schema": "https://opensource.adobe.com/spectrum-design-data/schemas/v0/component-visual.schema.json",
  "specVersion": "1.0.0-draft",
  "component": "button",
  "root": "container",
  "sizeScale": {
    "xs": 50,
    "s": 75,
    "m": 100,
    "l": 200,
    "xl": 300
  },
  "parts": {
    "container": {
      "kind": "box",
      "children": ["icon", "progress", "label"],
      "props": {
        "direction": {
          "value": "row"
        },
        "align": {
          "value": "center"
        },
        "justify": {
          "value": "center"
        },
        "height": {
          "relationship": {
            "property": "component-height-{sizeIndex}",
            "context": "Minimum height"
          }
        },
        "paddingInlineStart": [
          {
            "token": {
              "structure": "base",
              "property": "padding-horizontal",
              "size": "{size}"
            }
          },
          {
            "when": {
              "options": {
                "isLabelHidden": true
              }
            },
            "token": {
              "structure": "base",
              "property": "padding-vertical",
              "size": "{size}"
            }
          }
        ],
        "paddingInlineEnd": [
          {
            "token": {
              "structure": "base",
              "property": "padding-horizontal",
              "size": "{size}"
            }
          },
          {
            "when": {
              "options": {
                "isLabelHidden": true
              }
            },
            "token": {
              "structure": "base",
              "property": "padding-vertical",
              "size": "{size}"
            }
          }
        ],
        "gap": {
          "relationship": {
            "property": "space-between",
            "context": "Spacing (icon to label)"
          }
        },
        "cornerRadius": {
          "relationship": {
            "property": "corner-radius",
            "context": "Rounding"
          },
          "relativeTo": "height"
        },
        "fill": [
          {
            "when": {
              "options": {
                "variant": "primary",
                "style": "fill"
              }
            },
            "token": {
              "colorFamily": "gray",
              "scaleIndex": 800,
              "property": "color"
            }
          },
          {
            "when": {
              "options": {
                "variant": "primary",
                "style": "fill"
              },
              "states": ["hover"]
            },
            "token": {
              "colorFamily": "gray",
              "scaleIndex": 900,
              "property": "color"
            }
          },
          {
            "when": {
              "options": {
                "variant": "primary",
                "style": "fill"
              },
              "states": ["down"]
            },
            "token": {
              "colorFamily": "gray",
              "scaleIndex": 900,
              "property": "color"
            }
          },
          {
            "when": {
              "options": {
                "variant": "primary",
                "style": "outline"
              }
            },
            "value": "transparent"
          },
          {
            "when": {
              "options": {
                "variant": "primary",
                "style": "outline"
              },
              "states": ["hover"]
            },
            "token": {
              "colorFamily": "gray",
              "scaleIndex": 100,
              "property": "color"
            }
          },
          {
            "when": {
              "options": {
                "variant": "primary",
                "style": "outline"
              },
              "states": ["down"]
            },
            "token": {
              "colorFamily": "gray",
              "scaleIndex": 200,
              "property": "color"
            }
          },
          {
            "when": {
              "options": {
                "variant": "secondary",
                "style": "fill"
              }
            },
            "token": {
              "colorFamily": "gray",
              "scaleIndex": 100,
              "property": "color"
            }
          },
          {
            "when": {
              "options": {
                "variant": "secondary",
                "style": "fill"
              },
              "states": ["hover"]
            },
            "token": {
              "colorFamily": "gray",
              "scaleIndex": 200,
              "property": "color"
            }
          },
          {
            "when": {
              "options": {
                "variant": "secondary",
                "style": "fill"
              },
              "states": ["down"]
            },
            "token": {
              "colorFamily": "gray",
              "scaleIndex": 200,
              "property": "color"
            }
          },
          {
            "when": {
              "options": {
                "variant": "secondary",
                "style": "outline"
              }
            },
            "value": "transparent"
          },
          {
            "when": {
              "options": {
                "variant": "secondary",
                "style": "outline"
              },
              "states": ["hover"]
            },
            "token": {
              "colorFamily": "gray",
              "scaleIndex": 100,
              "property": "color"
            }
          },
          {
            "when": {
              "options": {
                "variant": "secondary",
                "style": "outline"
              },
              "states": ["down"]
            },
            "token": {
              "colorFamily": "gray",
              "scaleIndex": 200,
              "property": "color"
            }
          },
          {
            "when": {
              "options": {
                "variant": "accent"
