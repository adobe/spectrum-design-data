          {
            "when": {
              "options": {
                "variant": "accent"
              },
              "states": ["down"]
            },
            "token": {
              "legacyKey": "accent-background-color-down"
            }
          },
          {
            "when": {
              "options": {
                "variant": "negative"
              }
            },
            "token": {
              "legacyKey": "negative-background-color-default"
            }
          },
          {
            "when": {
              "options": {
                "variant": "negative"
              },
              "states": ["hover"]
            },
            "token": {
              "legacyKey": "negative-background-color-hover"
            }
          },
          {
            "when": {
              "options": {
                "variant": "negative"
              },
              "states": ["down"]
            },
            "token": {
              "legacyKey": "negative-background-color-down"
            }
          },
