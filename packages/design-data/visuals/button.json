            "token": {
              "colorFamily": "gray",
              "scaleIndex": 900,
              "property": "color"
            }
          },
          {
            "when": {
              "states": ["down"]
            },
            "token": {
              "colorFamily": "gray",
              "scaleIndex": 900,
