{
  "$schema": "https://opensource.adobe.com/spectrum-design-data/schemas/v0/component-visual.schema.json",
  "specVersion": "1.0.0-draft",
  "component": "button",
  "root": "container",
  "sizeScale": {
    "s": 75,
    "m": 100,
    "l": 200,
    "xl": 300
  },
  "notVisual": ["icon"],
  "derived": [
    {
      "context": "Spacing (top edge to icon)",
      "property": "component-top-to-workflow-icon-{sizeIndex}",
      "part": "icon",
      "from": "(height - label.lineHeight) / 2"
    },
    {
      "context": "Spacing (top/bottom edge to label)",
      "property": "component-top-to-text-{sizeIndex}",
      "part": "label",
      "from": "(height - label.lineHeight) / 2"
    },
    {
      "context": "Spacing (top/bottom edge to label)",
      "property": "component-bottom-to-text-{sizeIndex}",
      "part": "label",
      "edge": "bottom",
      "from": "(height - label.lineHeight) / 2"
    }
  ],
  "parts": {
    "container": {
      "kind": "box",
      "children": ["icon", "progress", "label"],
      "props": {
        "direction": {
          "value": "row"
        },
        "align": {
          "value": "center"
        },
        "justify": {
          "value": "center"
        },
        "minHeight": {
          "relationship": {
            "property": "component-height-{sizeIndex}",
            "context": "Minimum height"
          }
        },
        "minWidth": {
          "when": {
            "options": {
              "isLabelHidden": false
            }
          },
          "relationship": {
            "property": "minimum-width-multiplier",
            "context": "Minimum width (with label)"
          },
          "relativeTo": "height"
        },
        "paddingInlineStart": [
          {
            "relationship": {
              "property": "component-pill-edge-to-visual-{sizeIndex}",
              "context": "Spacing (start/end edges)"
            }
          },
          {
            "when": {
              "options": {
                "isLabelHidden": true
              }
            },
            "relationship": {
              "property": "component-pill-edge-to-visual-only-{sizeIndex}",
              "context": "Spacing (start/end edges, icon only)"
            }
          }
        ],
        "paddingInlineEnd": [
          {
            "relationship": {
              "property": "component-pill-edge-to-visual-{sizeIndex}",
              "context": "Spacing (start/end edges)"
            }
          },
          {
            "when": {
              "options": {
                "isLabelHidden": true
              }
            },
            "relationship": {
              "property": "component-pill-edge-to-visual-only-{sizeIndex}",
              "context": "Spacing (start/end edges, icon only)"
            }
          }
        ],
        "gap": {
          "relationship": {
            "property": "space-between",
            "context": "Spacing (icon to label)"
          }
        },
        "cornerRadius": {
          "relationship": {
            "property": "corner-radius",
            "context": "Rounding"
          },
          "relativeTo": "height"
        },
        "fill": [
          {
            "when": {
              "options": {
                "variant": "primary",
                "style": "outline"
              }
            },
            "value": "transparent"
          },
          {
            "when": {
              "options": {
                "variant": "secondary",
                "style": "outline"
              }
            },
            "value": "transparent"
          },
          {
            "when": {
              "options": {
                "isDisabled": true,
                "style": "outline"
              }
            },
            "value": "transparent",
            "priority": 10
          },
          {
            "when": {
              "options": {
                "style": "fill"
              }
            },
            "relationship": {
              "property": "color",
              "context": "Background"
            }
          },
          {
            "when": {
              "options": {
                "isDisabled": false,
                "style": "outline",
                "variant": ["primary", "secondary"]
              },
              "states": ["hover"]
            },
            "relationship": {
              "property": "color",
              "context": "Background"
            }
          },
          {
            "when": {
              "options": {
                "isDisabled": false,
                "style": "outline",
                "variant": ["primary", "secondary"]
              },
              "states": ["down"]
            },
            "relationship": {
              "property": "color",
              "context": "Background"
            }
          }
        ],
        "stroke": [
          {
            "value": "transparent"
          },
          {
            "when": {
              "options": {
                "style": "outline",
                "variant": ["primary", "secondary"]
              }
            },
            "relationship": {
              "property": "color",
              "context": "Border"
            }
          },
          {
            "when": {
              "options": {
                "isDisabled": true,
                "style": "outline"
              }
            },
            "relationship": {
              "property": "color",
              "context": "Border"
            }
          }
        ],
        "strokeWidth": [
          {
            "value": 0
          },
          {
            "when": {
              "options": {
                "style": "outline"
              }
            },
            "relationship": {
              "property": "border-width",
              "context": "Border"
            }
          }
        ],
        "pressDifference": {
          "when": {
            "states": ["down"]
          },
          "relationship": {
            "property": "component-size-difference",
            "context": "Component size (down)"
          }
        },
        "pressWidthRatio": {
          "when": {
            "states": ["down"]
          },
          "relationship": {
            "property": "component-size-width-ratio",
            "context": "Component size (down)"
          }
        },
        "pressMinPerspective": {
          "when": {
            "states": ["down"]
          },
          "relationship": {
            "property": "component-size-minimum-perspective",
            "context": "Component size (down)"
          }
        },
        "pressMaxPerspective": {
          "when": {
            "states": ["down"]
          },
          "relationship": {
            "property": "component-size-maximum-perspective",
            "context": "Component size (down)"
          }
        }
      }
    },
    "icon": {
      "kind": "icon",
      "icon": {
        "set": "workflow",
        "name": "add",
        "content": true,
        "optional": true
      },
      "visibleWhen": {
        "options": {
          "isPending": false
        }
      },
      "props": {
        "width": {
          "relationship": {
            "property": "workflow-icon-size-{sizeIndex}",
            "context": "Icon"
          }
        },
        "height": {
          "relationship": {
            "property": "workflow-icon-size-{sizeIndex}",
            "context": "Icon"
          }
        },
        "color": [
          {
            "when": {
              "options": {
                "isPending": false
              }
            },
            "relationship": {
              "property": "color",
              "context": "Icon"
            }
          }
        ]
      }
    },
    "label": {
      "kind": "text",
      "visibleWhen": {
        "options": {
          "isLabelHidden": false,
          "isPending": false
        }
      },
      "props": {
        "overflow": {
          "value": "wrap"
        },
        "fontSize": {
          "relationship": {
            "property": "font-size-{sizeIndex}",
            "context": "Label"
          }
        },
        "fontWeight": {
          "relationship": {
            "property": "font-weight",
            "context": "Label"
          }
        },
        "lineHeight": {
          "relationship": {
            "property": "line-height-font-size-{sizeIndex}",
            "context": "Label"
          }
        },
        "color": [
          {
            "when": {
              "options": {
                "isLabelHidden": false,
                "isPending": false
              }
            },
            "relationship": {
              "property": "color",
              "context": "Label"
            }
          }
        ]
      }
    },
    "progress": {
      "kind": "progress",
      "visibleWhen": {
        "options": {
          "isPending": true
        }
      },
      "props": {
        "width": {
          "relationship": {
            "property": "workflow-icon-size-{sizeIndex}",
            "context": "Icon"
          }
        },
        "height": {
          "relationship": {
            "property": "workflow-icon-size-{sizeIndex}",
            "context": "Icon"
          }
        },
        "trackColor": {
          "relationship": {
            "property": "color",
            "context": "Progress track"
          }
        },
        "color": {
          "relationship": {
            "property": "color",
            "context": "Progress"
          }
        }
      }
    },
    "focus-indicator": {
      "kind": "ring",
      "visibleWhen": {
        "states": ["keyboard-focus"]
      },
      "props": {
        "stroke": [
          {
            "relationship": {
              "property": "color",
              "context": "Focus indicator"
            }
          },
          {
            "when": {
              "options": {
                "staticColor": "white",
                "variant": ["primary", "secondary"]
              }
            },
            "relationship": {
              "property": "color",
              "context": "Static white – Focus indicator"
            }
          },
          {
            "when": {
              "options": {
                "staticColor": "black",
                "variant": ["primary", "secondary"]
              }
            },
            "relationship": {
              "property": "color",
              "context": "Static black – Focus indicator"
            }
          }
        ],
        "strokeWidth": {
          "relationship": {
            "property": "thickness",
            "context": "Focus indicator"
          }
        },
        "gapToParent": {
          "relationship": {
            "property": "gap",
            "context": "Focus indicator"
          }
        }
      }
    }
  }
}
