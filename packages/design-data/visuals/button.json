          },
          {
            "when": {
              "options": {
                "isDisabled": true,
                "style": "fill"
              }
            },
            "token": {
              "colorFamily": "gray",
              "scaleIndex": 100,
              "property": "color"
            },
            "priority": 10
          },
          {
            "when": {
              "options": {
                "isDisabled": true,
                "style": "outline"
              }
            },
            "value": "transparent",
            "priority": 10
          }
