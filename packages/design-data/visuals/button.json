            "token": {
              "colorFamily": "transparent-white",
              "scaleIndex": 100,
              "property": "color"
            }
          },
          {
            "when": {
              "options": {
                "staticColor": "black",
                "variant": "primary",
                "style": "fill"
              }
            },
            "token": {
              "colorFamily": "transparent-black",
              "scaleIndex": 800,
              "property": "color"
