          },
          {
            "when": {
              "options": {
                "variant": "secondary",
                "style": "outline"
              }
            },
            "token": {
              "colorFamily": "gray",
              "scaleIndex": 300,
              "property": "color"
            }
          },
          {
            "when": {
              "options": {
                "variant": "secondary",
                "style": "outline"
              },
              "states": ["hover"]
            },
            "token": {
              "colorFamily": "gray",
              "scaleIndex": 400,
              "property": "color"
            }
          },
          {
            "when": {
              "options": {
                "variant": "secondary",
                "style": "outline"
              },
              "states": ["down"]
            },
            "token": {
              "colorFamily": "gray",
              "scaleIndex": 400,
              "property": "color"
            }
          },
          {
            "when": {
              "options": {
                "staticColor": "white",
                "style": "outline"
              }
