{
  "$schema": "https://opensource.adobe.com/spectrum-design-data/schemas/v0/component-visual.schema.json",
  "specVersion": "1.0.0-draft",
  "component": "button",
  "root": "container",
  "sizeScale": {
    "s": 75,
    "m": 100,
    "l": 200,
    "xl": 300
  },
  "notVisual": ["icon"],
  "derived": [
    {
      "context": "Spacing (top edge to icon)",
      "property": "space-between",
      "part": "icon",
      "from": "(height - label.lineHeight) / 2"
    },
    {
      "context": "Spacing (top/bottom edge to label)",
      "property": "space-between",
      "part": "label",
      "from": "(height - label.lineHeight) / 2"
    },
    {
      "context": "Spacing (top/bottom edge to label)",
      "property": "space-between",
      "part": "label",
      "edge": "bottom",
      "from": "(height - label.lineHeight) / 2"
    }
  ],
  "parts": {
    "container": {
      "kind": "box",
      "children": ["icon", "progress", "label"],
      "props": {
        "direction": {
          "value": "row"
        },
        "align": {
          "value": "center"
        },
        "justify": {
          "value": "center"
        },
        "minHeight": {
          "relationship": {
            "property": "minimum-height",
            "part": "container"
          }
        },
        "minWidth": {
          "when": {
            "options": {
              "isLabelHidden": false
            }
          },
          "relationship": {
            "property": "minimum-width-multiplier",
            "part": "container"
          },
          "relativeTo": "height"
        },
        "paddingInlineStart": [
          {
            "relationship": {
              "property": "space-between",
              "part": "container",
              "between": {
                "from": "start-edge",
                "to": "icon"
              }
            }
          },
          {
            "when": {
              "options": {
                "isLabelHidden": true
              }
            },
            "relationship": {
              "property": "space-between",
              "part": "container",
              "between": {
                "from": "start-edge",
                "to": "icon"
              }
            }
          }
        ],
        "paddingInlineEnd": [
          {
            "relationship": {
              "property": "space-between",
              "part": "container",
              "between": {
                "from": "start-edge",
                "to": "icon"
              }
            }
          },
          {
            "when": {
              "options": {
                "isLabelHidden": true
              }
            },
            "relationship": {
              "property": "space-between",
              "part": "container",
              "between": {
                "from": "start-edge",
                "to": "icon"
              }
            }
          }
        ],
        "gap": {
          "relationship": {
            "property": "space-between",
            "part": "container",
            "between": {
              "from": "icon",
              "to": "label"
            }
          }
        },
        "cornerRadius": {
          "relationship": {
            "property": "corner-radius",
            "part": "container"
          },
          "relativeTo": "height"
        },
        "fill": [
          {
            "when": {
              "options": {
                "variant": "primary",
                "style": "outline"
              }
            },
            "value": "transparent"
          },
          {
            "when": {
              "options": {
                "variant": "secondary",
                "style": "outline"
              }
            },
            "value": "transparent"
          },
          {
            "when": {
              "options": {
                "style": "outline"
              },
              "facets": {
                "disabled": "true"
              }
            },
            "value": "transparent",
            "priority": 10
          },
          {
            "when": {
              "options": {
                "style": "fill"
              }
            },
            "relationship": {
              "property": "color",
              "attribute": "background",
              "part": "container"
            }
          },
          {
            "when": {
              "options": {
                "style": "outline",
                "variant": ["primary", "secondary"]
              },
              "facets": {
                "disabled": "false",
                "hovered": "true"
              }
            },
            "relationship": {
              "property": "color",
              "attribute": "background",
              "part": "container"
            }
          },
          {
            "when": {
              "options": {
                "style": "outline",
                "variant": ["primary", "secondary"]
              },
              "facets": {
                "disabled": "false",
                "pressed": "true"
              }
            },
            "relationship": {
              "property": "color",
              "attribute": "background",
              "part": "container"
            }
          },
          {
            "when": {
              "options": {
                "style": "outline",
                "variant": ["primary", "secondary"]
              },
              "facets": {
                "disabled": "false",
                "focusVisible": "true"
              }
            },
            "relationship": {
              "property": "color",
              "attribute": "background",
              "part": "container"
            }
          }
        ],
        "stroke": [
          {
            "value": "transparent"
          },
          {
            "when": {
              "options": {
                "style": "outline",
                "variant": ["primary", "secondary"]
              }
            },
            "relationship": {
              "property": "color",
              "attribute": "border",
              "part": "container"
            }
          },
          {
            "when": {
              "options": {
                "style": "outline"
              },
              "facets": {
                "disabled": "true"
              }
            },
            "relationship": {
              "property": "color",
              "attribute": "border",
              "part": "container"
            }
          }
        ],
        "strokeWidth": [
          {
            "value": 0
          },
          {
            "when": {
              "options": {
                "style": "outline"
              }
            },
            "relationship": {
              "property": "border-width",
              "part": "container"
            }
          }
        ],
        "pressDifference": {
          "when": {
            "facets": {
              "pressed": "true"
            }
          },
          "relationship": {
            "property": "component-size-difference",
            "part": "container"
          }
        },
        "pressWidthRatio": {
          "when": {
            "facets": {
              "pressed": "true"
            }
          },
          "relationship": {
            "property": "component-size-width-ratio",
            "part": "container"
          }
        },
        "pressMinPerspective": {
          "when": {
            "facets": {
              "pressed": "true"
            }
          },
          "relationship": {
            "property": "component-size-minimum-perspective",
            "part": "container"
          }
        },
        "pressMaxPerspective": {
          "when": {
            "facets": {
              "pressed": "true"
            }
          },
          "relationship": {
            "property": "component-size-maximum-perspective",
            "part": "container"
          }
        }
      }
    },
    "icon": {
      "kind": "icon",
      "icon": {
        "set": "workflow",
        "name": "add",
        "content": true,
        "optional": true
      },
      "props": {
        "width": {
          "relationship": {
            "property": "size",
            "part": "icon"
          }
        },
        "height": {
          "relationship": {
            "property": "size",
            "part": "icon"
          }
        },
        "color": [
          {
            "when": {
              "facets": {
                "pending": "false"
              }
            },
            "relationship": {
              "property": "color",
              "part": "icon"
            }
          }
        ]
      }
    },
    "label": {
      "kind": "text",
      "props": {
        "overflow": {
          "value": "wrap"
        },
        "fontSize": {
          "relationship": {
            "property": "font-size",
            "part": "label"
          }
        },
        "fontWeight": {
          "relationship": {
            "property": "font-weight",
            "part": "label"
          }
        },
        "lineHeight": {
          "relationship": {
            "property": "line-height",
            "part": "label"
          }
        },
        "color": [
          {
            "when": {
              "options": {
                "isLabelHidden": false
              },
              "facets": {
                "pending": "false"
              }
            },
            "relationship": {
              "property": "color",
              "part": "label"
            }
          }
        ]
      }
    },
    "progress": {
      "kind": "progress",
      "props": {
        "width": {
          "relationship": {
            "property": "size",
            "part": "icon"
          }
        },
        "height": {
          "relationship": {
            "property": "size",
            "part": "icon"
          }
        },
        "trackColor": {
          "relationship": {
            "property": "color",
            "part": "progress"
          }
        },
        "color": {
          "relationship": {
            "property": "content-color",
            "part": "progress"
          }
        }
      }
    },
    "focus-indicator": {
      "kind": "ring",
      "props": {
        "stroke": [
          {
            "relationship": {
              "property": "color",
              "part": "focus-indicator"
            }
          },
          {
            "when": {
              "options": {
                "staticColor": "white",
                "variant": ["primary", "secondary"]
              }
            },
            "relationship": {
              "property": "color",
              "part": "focus-indicator"
            }
          },
          {
            "when": {
              "options": {
                "staticColor": "black",
                "variant": ["primary", "secondary"]
              }
            },
            "relationship": {
              "property": "color",
              "part": "focus-indicator"
            }
          }
        ],
        "strokeWidth": {
          "relationship": {
            "property": "thickness",
            "part": "focus-indicator"
          }
        },
        "gapToParent": {
          "relationship": {
            "property": "gap",
            "part": "focus-indicator"
          }
        }
      }
    }
  }
}
