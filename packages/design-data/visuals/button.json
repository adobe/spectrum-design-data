              "options": {
                "staticColor": "white",
                "variant": "primary",
                "style": "fill"
              }
            },
            "token": {
              "colorFamily": "transparent-white",
              "scaleIndex": 800,
              "property": "color"
            }
          },
          {
            "when": {
              "options": {
                "staticColor": "white",
