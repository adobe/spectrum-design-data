              "property": "color"
            }
          },
          {
            "when": {
              "options": {
                "isDisabled": true,
                "style": "outline"
              }
            },
            "token": {
              "colorFamily": "gray",
              "scaleIndex": 300,
              "property": "color"
            },
            "priority": 10
          }
        ],
        "strokeWidth": [
          {
            "value": 0
          },
          {
            "when": {
              "options": {
                "style": "outline"
              }
            },
            "token": {
              "property": "border-width",
              "scaleIndex": 200
            }
          }
        ],
        "pressDifference": {
          "when": {
            "states": ["down"]
          },
          "relationship": {
            "property": "component-size-difference",
            "context": "Component size (down)"
          }
        },
        "pressWidthRatio": {
          "when": {
            "states": ["down"]
          },
          "relationship": {
            "property": "component-size-width-ratio",
            "context": "Component size (down)"
          }
        },
        "pressMinPerspective": {
          "when": {
            "states": ["down"]
          },
          "relationship": {
            "property": "component-size-minimum-perspective",
            "context": "Component size (down)"
          }
        },
        "pressMaxPerspective": {
          "when": {
            "states": ["down"]
          },
          "token": {
            "property": "component-size-maximum-perspective",
            "state": "down"
          }
        }
      }
    },
