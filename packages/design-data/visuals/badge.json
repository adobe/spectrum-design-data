{
  "$schema": "https://opensource.adobe.com/spectrum-design-data/schemas/v0/component-visual.schema.json",
  "specVersion": "1.0.0-draft",
  "component": "badge",
  "root": "container",
  "sizeScale": {
    "s": 75,
    "m": 100,
    "l": 200,
    "xl": 300
  },
  "derived": [
    {
      "context": "Spacing (top edge to icon)",
      "property": "space-between",
      "part": "icon",
      "from": "(height - label.lineHeight) / 2"
    },
    {
      "context": "Spacing (top/bottom edge to label)",
      "property": "space-between",
      "part": "label",
      "from": "(height - label.lineHeight) / 2"
    },
    {
      "context": "Spacing (top/bottom edge to label)",
      "property": "space-between",
      "part": "label",
      "edge": "bottom",
      "from": "(height - label.lineHeight) / 2"
    }
  ],
  "parts": {
    "container": {
      "kind": "box",
      "children": ["icon", "label"],
      "props": {
        "direction": {
          "value": "row"
        },
        "align": {
          "value": "center"
        },
        "justify": {
          "value": "center"
        },
        "minHeight": {
          "relationship": {
            "property": "minimum-height",
            "part": "container"
          }
        },
        "paddingInlineStart": [
          {
            "relationship": {
              "property": "space-between",
              "part": "container",
              "between": {
                "from": "start-edge",
                "to": "label"
              }
            }
          },
          {
            "when": {
              "options": {
                "label": false
              }
            },
            "relationship": {
              "property": "space-between",
              "part": "container",
              "between": {
                "from": "start-edge",
                "to": "icon"
              }
            }
          }
        ],
        "paddingInlineEnd": [
          {
            "relationship": {
              "property": "space-between",
              "part": "container",
              "between": {
                "from": "start-edge",
                "to": "label"
              }
            }
          },
          {
            "when": {
              "options": {
                "label": false
              }
            },
            "relationship": {
              "property": "space-between",
              "part": "container",
              "between": {
                "from": "start-edge",
                "to": "icon"
              }
            }
          }
        ],
        "gap": {
          "relationship": {
            "property": "space-between",
            "part": "container",
            "between": {
              "from": "icon",
              "to": "label"
            }
          }
        },
        "cornerRadius": {
          "relationship": {
            "property": "corner-radius",
            "part": "container"
          }
        },
        "fill": [
          {
            "relationship": {
              "property": "color",
              "attribute": "background",
              "part": "container"
            }
          },
          {
            "when": {
              "options": {
                "variant": [
                  "neutral",
                  "informative",
                  "positive",
                  "negative",
                  "accent",
                  "notice"
                ]
              }
            },
            "relationship": {
              "property": "color",
              "attribute": "background",
              "part": "container"
            }
          }
        ],
        "stroke": [
          {
            "value": "transparent"
          },
          {
            "when": {
              "options": {
                "variant": [
                  "neutral",
                  "informative",
                  "positive",
                  "negative",
                  "accent",
                  "notice"
                ],
                "style": ["outline"]
              }
            },
            "relationship": {
              "property": "color",
              "attribute": "border",
              "part": "container"
            }
          }
        ],
        "strokeWidth": [
          {
            "value": 0
          },
          {
            "when": {
              "options": {
                "variant": [
                  "neutral",
                  "informative",
                  "positive",
                  "negative",
                  "accent",
                  "notice"
                ],
                "style": ["outline"]
              }
            },
            "relationship": {
              "property": "border-width",
              "part": "container"
            }
          }
        ]
      }
    },
    "icon": {
      "kind": "icon",
      "icon": {
        "set": "workflow",
        "name": "add",
        "content": true,
        "optional": true
      },
      "props": {
        "width": {
          "relationship": {
            "property": "size",
            "part": "icon"
          }
        },
        "height": {
          "relationship": {
            "property": "size",
            "part": "icon"
          }
        },
        "color": {
          "relationship": {
            "property": "content-color",
            "part": "container"
          }
        }
      }
    },
    "label": {
      "kind": "text",
      "props": {
        "overflow": {
          "value": "wrap"
        },
        "fontSize": {
          "relationship": {
            "property": "font-size",
            "part": "label"
          }
        },
        "lineHeight": {
          "relationship": {
            "property": "line-height",
            "part": "label"
          }
        },
        "fontWeight": {
          "relationship": {
            "property": "font-weight",
            "part": "label"
          }
        },
        "color": {
          "relationship": {
            "property": "content-color",
            "part": "container"
          }
        }
      }
    }
  }
}
