{
  "$schema": "https://opensource.adobe.com/spectrum-design-data/schemas/v0/component-visual.schema.json",
  "specVersion": "1.0.0-draft",
  "component": "close-button",
  "root": "container",
  "sizeScale": {
    "s": 75,
    "m": 100,
    "l": 200,
    "xl": 300
  },
  "parts": {
    "container": {
      "kind": "box",
      "children": ["icon"],
      "props": {
        "direction": {
          "value": "row"
        },
        "align": {
          "value": "center"
        },
        "justify": {
          "value": "center"
        },
        "width": {
          "relationship": {
            "property": "height",
            "context": "Button size"
          }
        },
        "height": {
          "relationship": {
            "property": "height",
            "context": "Button size"
          }
        },
        "cornerRadius": {
          "value": 0.5,
          "relativeTo": "height"
        },
        "fill": [
          {
            "when": {
              "states": ["hover"],
              "options": {
                "isDisabled": false
              }
            },
            "relationship": {
              "property": "color",
              "context": "Background"
            }
          },
          {
            "when": {
              "states": ["hover"],
              "options": {
                "isDisabled": false,
                "staticColor": "white"
              }
            },
            "relationship": {
              "property": "color",
              "context": "Background"
            }
          },
          {
            "when": {
              "states": ["hover"],
              "options": {
                "isDisabled": false,
                "staticColor": "black"
              }
            },
            "relationship": {
              "property": "color",
              "context": "Background"
            }
          },
          {
            "when": {
              "states": ["down"],
              "options": {
                "isDisabled": false
              }
            },
            "relationship": {
              "property": "color",
              "context": "Background"
            }
          },
          {
            "when": {
              "states": ["down"],
              "options": {
                "isDisabled": false,
                "staticColor": "white"
              }
            },
            "relationship": {
              "property": "color",
              "context": "Background"
            }
          },
          {
            "when": {
              "states": ["down"],
              "options": {
                "isDisabled": false,
                "staticColor": "black"
              }
            },
            "relationship": {
              "property": "color",
              "context": "Background"
            }
          },
          {
            "when": {
              "states": ["keyboard-focus"],
              "options": {
                "isDisabled": false
              }
            },
            "relationship": {
              "property": "color",
              "context": "Background"
            }
          },
          {
            "when": {
              "states": ["keyboard-focus"],
              "options": {
                "isDisabled": false,
                "staticColor": "white"
              }
            },
            "relationship": {
              "property": "color",
              "context": "Background"
            }
          },
          {
            "when": {
              "states": ["keyboard-focus"],
              "options": {
                "isDisabled": false,
                "staticColor": "black"
              }
            },
            "relationship": {
              "property": "color",
              "context": "Background"
            }
          }
        ],
        "pressDifference": {
          "when": {
            "states": ["down"]
          },
          "relationship": {
            "property": "component-size-difference",
            "context": "Button size (down)"
          }
        },
        "pressWidthRatio": {
          "when": {
            "states": ["down"]
          },
          "relationship": {
            "property": "component-size-width-ratio",
            "context": "Button size (down)"
          }
        },
        "pressMinPerspective": {
          "when": {
            "states": ["down"]
          },
          "relationship": {
            "property": "component-size-minimum-perspective",
            "context": "Button size (down)"
          }
        }
      }
    },
    "icon": {
      "kind": "icon",
      "icon": {
        "set": "ui",
        "name": "cross"
      },
      "props": {
        "width": [
          {
            "when": {
              "options": {
                "size": "s"
              }
            },
            "relationship": {
              "property": "size",
              "context": "Cross icon size"
            }
          },
          {
            "when": {
              "options": {
                "size": "m"
              }
            },
            "relationship": {
              "property": "size",
              "context": "Cross icon size"
            }
          },
          {
            "when": {
              "options": {
                "size": "l"
              }
            },
            "relationship": {
              "property": "size",
              "context": "Cross icon size"
            }
          },
          {
            "when": {
              "options": {
                "size": "xl"
              }
            },
            "relationship": {
              "property": "size",
              "context": "Cross icon size"
            }
          }
        ],
        "height": [
          {
            "when": {
              "options": {
                "size": "s"
              }
            },
            "relationship": {
              "property": "size",
              "context": "Cross icon size"
            }
          },
          {
            "when": {
              "options": {
                "size": "m"
              }
            },
            "relationship": {
              "property": "size",
              "context": "Cross icon size"
            }
          },
          {
            "when": {
              "options": {
                "size": "l"
              }
            },
            "relationship": {
              "property": "size",
              "context": "Cross icon size"
            }
          },
          {
            "when": {
              "options": {
                "size": "xl"
              }
            },
            "relationship": {
              "property": "size",
              "context": "Cross icon size"
            }
          }
        ],
        "color": [
          {
            "relationship": {
              "property": "content-color",
              "context": "Cross icon"
            }
          },
          {
            "when": {
              "options": {
                "staticColor": "white"
              }
            },
            "relationship": {
              "property": "color",
              "context": "Cross icon"
            }
          },
          {
            "when": {
              "options": {
                "staticColor": "black"
              }
            },
            "relationship": {
              "property": "color",
              "context": "Cross icon"
            }
          }
        ]
      }
    },
    "focus-indicator": {
      "kind": "ring",
      "visibleWhen": {
        "states": ["keyboard-focus"]
      },
      "props": {
        "stroke": [
          {
            "relationship": {
              "property": "color",
              "context": "Focus ring"
            }
          },
          {
            "when": {
              "options": {
                "staticColor": "white"
              }
            },
            "relationship": {
              "property": "color",
              "context": "Focus ring"
            }
          },
          {
            "when": {
              "options": {
                "staticColor": "black"
              }
            },
            "relationship": {
              "property": "color",
              "context": "Focus ring"
            }
          }
        ],
        "strokeWidth": {
          "relationship": {
            "property": "thickness",
            "context": "Focus ring"
          }
        },
        "gapToParent": {
          "relationship": {
            "property": "gap",
            "context": "Focus ring"
          }
        }
      }
    }
  }
}
