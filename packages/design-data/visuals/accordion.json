{
  "$schema": "https://opensource.adobe.com/spectrum-design-data/schemas/v0/component-visual.schema.json",
  "specVersion": "1.0.0-draft",
  "component": "accordion",
  "root": "container",
  "sizeScale": { "s": 100, "m": 200, "l": 300, "xl": 400 },
  "notVisual": ["isMultiple", "down", "headingLevel"],
  "parts": {
    "container": {
      "kind": "box",
      "children": ["container-divider", "accordion-item"],
      "repeat": {
        "slot": "default",
        "label": "label",
        "with": {
          "content": "content",
          "isOpen": "isExpanded"
        }
      },
      "props": {
        "direction": { "value": "column" },
        "width": [
          {
            "when": {
              "options": { "size": "m" },
              "modes": { "scale": "desktop" }
            },
            "token": {
              "anatomy": "field",
              "property": "width",
              "size": "l",
              "scale": "desktop"
            }
          },
          {
            "when": {
              "options": { "size": "m" },
              "modes": { "scale": "mobile" }
            },
            "token": {
              "anatomy": "field",
              "property": "width",
              "size": "l",
              "scale": "mobile"
            }
          },
          {
            "when": { "options": { "size": ["l", "xl"] } },
            "relationship": {
              "property": "width",
              "part": "container"
            }
          }
        ]
      }
    },
    "container-divider": {
      "kind": "component",
      "sizeMap": { "s": "s", "m": "s", "l": "s", "xl": "s" },
      "inherit": ["width"]
    },
    "accordion-item": {
      "kind": "box",
      "children": ["header", "content", "divider"],
      "props": {
        "direction": { "value": "column" },
        "align": { "value": "start" },
        "fill": [
          {
            "when": { "states": ["hover"] },
            "token": {
              "property": "color",
              "colorFamily": "transparent-static-black",
              "scaleIndex": 150
            }
          }
        ]
      }
    },
    "header": {
      "kind": "box",
      "children": ["disclosure-icon", "title", "actions"],
      "props": {
        "direction": { "value": "row" },
        "align": { "value": "center" },
        "paddingInlineStart": {
          "relationship": {
            "property": "padding-horizontal",
            "part": "header"
          }
        },
        "paddingInlineEnd": {
          "relationship": {
            "property": "padding-horizontal",
            "part": "header"
          }
        },
        "paddingBlockStart": {
          "when": { "options": { "density": ["regular", "spacious"] } },
          "relationship": {
            "property": "padding-vertical",
            "part": "header"
          }
        },
        "paddingBlockEnd": {
          "when": { "options": { "density": ["regular", "spacious"] } },
          "relationship": {
            "property": "padding-vertical",
            "part": "header"
          }
        }
      }
    },
    "actions": {
      "kind": "slot",
      "sizeMap": { "s": "s", "m": "m", "l": "l", "xl": "xl" },
      "with": {
        "hideLabel": true,
        "hasHoldIcon": true,
        "isDisabled": { "option": "isDisabled" }
      },
      "props": {
        "direction": { "value": "row" },
        "align": { "value": "center" },
        "gap": {
          "relationship": {
            "property": "spacing",
            "between": {
              "from": "title",
              "to": "actions"
            }
          }
        }
      }
    },
    "disclosure-icon": {
      "kind": "icon",
      "icon": { "set": "ui", "name": "chevron" },
      "props": {
        "width": [
          {
            "when": { "options": { "size": "s" } },
            "token": { "icon": "chevron", "property": "size", "scaleIndex": 75 }
          },
          {
            "when": { "options": { "size": "m" } },
            "token": {
              "icon": "chevron",
              "property": "size",
              "scaleIndex": 100
            }
          },
          {
            "when": { "options": { "size": "l" } },
            "token": {
              "icon": "chevron",
              "property": "size",
              "scaleIndex": 200
            }
          },
          {
            "when": { "options": { "size": "xl" } },
            "token": {
              "icon": "chevron",
              "property": "size",
              "scaleIndex": 300
            }
          }
        ],
        "height": [
          {
            "when": { "options": { "size": "s" } },
            "token": { "icon": "chevron", "property": "size", "scaleIndex": 75 }
          },
          {
            "when": { "options": { "size": "m" } },
            "token": {
              "icon": "chevron",
              "property": "size",
              "scaleIndex": 100
            }
          },
          {
            "when": { "options": { "size": "l" } },
            "token": {
              "icon": "chevron",
              "property": "size",
              "scaleIndex": 200
            }
          },
          {
            "when": { "options": { "size": "xl" } },
            "token": {
              "icon": "chevron",
              "property": "size",
              "scaleIndex": 300
            }
          }
        ],
        "rotation": [
          { "when": { "options": { "isOpen": true } }, "value": 90 }
        ],
        "color": [
          {
            "relationship": {
              "property": "color",
              "part": "title"
            }
          },
          {
            "when": { "options": { "isDisabled": true } },
            "relationship": {
              "property": "color",
              "part": "accordion-item"
            },
            "priority": 10
          }
        ]
      }
    },
    "title": {
      "kind": "text",
      "props": {
        "grow": { "value": true },
        "paddingInlineStart": {
          "relationship": {
            "property": "padding-horizontal",
            "part": "title"
          }
        },
        "paddingInlineEnd": {
          "relationship": {
            "property": "padding-horizontal",
            "part": "title"
          }
        },
        "paddingBlockStart": {
          "relationship": {
            "property": "padding-vertical",
            "part": "title"
          }
        },
        "paddingBlockEnd": {
          "relationship": {
            "property": "padding-vertical",
            "part": "title"
          }
        },
        "fontFamily": {
          "relationship": { "property": "font-family", "part": "title" }
        },
        "fontSize": {
          "relationship": {
            "property": "font-size",
            "part": "title"
          }
        },
        "fontWeight": {
          "relationship": { "property": "font-weight", "part": "title" }
        },
        "lineHeight": {
          "token": {
            "property": "line-height",
            "referenceScaleIndex": "{sizeIndex}"
          }
        },
        "color": [
          {
            "relationship": {
              "property": "color",
              "part": "title"
            }
          },
          {
            "when": { "options": { "isDisabled": true } },
            "relationship": {
              "property": "color",
              "part": "accordion-item"
            },
            "priority": 10
          }
        ]
      }
    },
    "content": {
      "kind": "text",
      "text": { "option": "content" },
      "props": {
        "paddingInlineStart": {
          "relationship": {
            "property": "padding-horizontal",
            "part": "content"
          }
        },
        "paddingInlineEnd": {
          "relationship": {
            "property": "padding-horizontal",
            "part": "content"
          }
        },
        "paddingBlockStart": {
          "relationship": { "property": "padding-top", "part": "content" }
        },
        "paddingBlockEnd": {
          "relationship": { "property": "padding-bottom", "part": "content" }
        },
        "fontFamily": {
          "relationship": { "property": "font-family", "part": "title" }
        },
        "fontSize": {
          "relationship": {
            "property": "font-size",
            "part": "title"
          }
        },
        "fontWeight": {
          "relationship": { "property": "font-weight", "part": "title" }
        },
        "lineHeight": {
          "token": {
            "property": "line-height",
            "referenceScaleIndex": "{sizeIndex}"
          }
        },
        "color": [
          { "relationship": { "property": "color", "part": "title" } },
          {
            "when": { "options": { "isDisabled": true } },
            "relationship": { "property": "color", "part": "accordion-item" },
            "priority": 10
          }
        ]
      }
    },
    "divider": {
      "kind": "component",
      "sizeMap": { "s": "s", "m": "s", "l": "s", "xl": "s" },
      "inherit": ["width"]
    }
  }
}
