{
  "$schema": "https://opensource.adobe.com/spectrum-design-data/schemas/v0/component-visual.schema.json",
  "specVersion": "1.0.0-draft",
  "component": "accordion",
  "root": "item",
  "sizeScale": { "s": 100, "m": 200, "l": 300, "xl": 400 },
  "notVisual": ["items", "isMultiple", "down"],
  "parts": {
    "item": {
      "kind": "box",
      "children": ["header", "content", "divider"],
      "props": {
        "direction": { "value": "column" },
        "align": { "value": "start" },
        "width": [
          {
            "when": { "options": { "size": "m" } },
            "token": { "anatomy": "field", "property": "width", "size": "l" }
          },
          {
            "when": { "options": { "size": ["l", "xl"] } },
            "relationship": {
              "property": "width",
              "context": "Width (default)"
            }
          }
        ],
        "fill": [
          {
            "when": { "states": ["hover"] },
            "token": {
              "property": "color",
              "colorFamily": "transparent-static-black",
              "scaleIndex": 150
            }
          }
        ]
      }
    },
    "header": {
      "kind": "box",
      "children": ["disclosure-icon", "title", "direct-actions"],
      "props": {
        "direction": { "value": "row" },
        "align": { "value": "center" },
        "paddingInlineStart": {
          "relationship": {
            "property": "padding-horizontal",
            "context": "Content (horizontal)"
          }
        },
        "paddingInlineEnd": {
          "relationship": {
            "property": "padding-horizontal",
            "context": "Content (horizontal)"
          }
        },
        "paddingBlockStart": {
          "when": { "options": { "density": ["regular", "spacious"] } },
          "relationship": {
            "property": "padding-vertical",
            "context": "Header (vertical)"
          }
        },
        "paddingBlockEnd": {
          "when": { "options": { "density": ["regular", "spacious"] } },
          "relationship": {
            "property": "padding-vertical",
            "context": "Header (vertical)"
          }
        }
      }
    },
    "direct-actions": {
      "kind": "box",
      "children": ["action-button", "switch"],
      "props": {
        "direction": { "value": "row" },
        "align": { "value": "center" },
        "gap": {
          "relationship": {
            "property": "spacing",
            "context": "Spacing (section title to action area)"
          }
        }
      }
    },
    "action-button": {
      "kind": "component",
      "component": "action-button",
      "sizeMap": { "s": "s", "m": "m", "l": "l", "xl": "xl" },
      "visibleWhen": { "options": { "hasActionButton": true } },
      "with": {
        "hideLabel": true,
        "hasHoldIcon": true,
        "isDisabled": { "option": "isDisabled" }
      }
    },
    "switch": {
      "kind": "component",
      "component": "switch",
      "sizeMap": { "s": "s", "m": "m", "l": "l", "xl": "xl" },
      "visibleWhen": { "options": { "hasSwitch": true } },
      "with": { "hideLabel": true, "isDisabled": { "option": "isDisabled" } }
    },
    "disclosure-icon": {
      "kind": "icon",
      "icon": { "set": "ui", "name": "chevron" },
      "props": {
        "width": [
          {
            "when": { "options": { "size": "s" } },
            "token": { "icon": "chevron", "property": "size", "scaleIndex": 75 }
          },
          {
            "when": { "options": { "size": "m" } },
            "token": {
              "icon": "chevron",
              "property": "size",
              "scaleIndex": 100
            }
          },
          {
            "when": { "options": { "size": "l" } },
            "token": {
              "icon": "chevron",
              "property": "size",
              "scaleIndex": 200
            }
          },
          {
            "when": { "options": { "size": "xl" } },
            "token": {
              "icon": "chevron",
              "property": "size",
              "scaleIndex": 300
            }
          }
        ],
        "height": [
          {
            "when": { "options": { "size": "s" } },
            "token": { "icon": "chevron", "property": "size", "scaleIndex": 75 }
          },
          {
            "when": { "options": { "size": "m" } },
            "token": {
              "icon": "chevron",
              "property": "size",
              "scaleIndex": 100
            }
          },
          {
            "when": { "options": { "size": "l" } },
            "token": {
              "icon": "chevron",
              "property": "size",
              "scaleIndex": 200
            }
          },
          {
            "when": { "options": { "size": "xl" } },
            "token": {
              "icon": "chevron",
              "property": "size",
              "scaleIndex": 300
            }
          }
        ],
        "rotation": [
          { "when": { "options": { "isOpen": true } }, "value": 90 }
        ],
        "color": [
          {
            "relationship": {
              "property": "content-color",
              "context": "Section title and chevron"
            }
          },
          {
            "when": { "options": { "isDisabled": true } },
            "relationship": {
              "property": "content-color",
              "context": "Disabled"
            },
            "priority": 10
          }
        ]
      }
    },
    "title": {
      "kind": "text",
      "props": {
        "grow": { "value": true },
        "paddingInlineStart": {
          "relationship": {
            "property": "padding-horizontal",
            "context": "Title (horizontal)"
          }
        },
        "paddingInlineEnd": {
          "relationship": {
            "property": "padding-horizontal",
            "context": "Title (horizontal)"
          }
        },
        "paddingBlockStart": {
          "relationship": {
            "property": "padding-vertical",
            "context": "Title (vertical)"
          }
        },
        "paddingBlockEnd": {
          "relationship": {
            "property": "padding-vertical",
            "context": "Title (vertical)"
          }
        },
        "fontFamily": {
          "relationship": { "property": "font-family", "context": "Value" }
        },
        "fontSize": {
          "relationship": {
            "property": "font-size-{sizeIndex}",
            "context": "Value"
          }
        },
        "fontWeight": {
          "relationship": { "property": "font-weight", "context": "Value" }
        },
        "lineHeight": {
          "token": {
            "property": "line-height",
            "referenceScaleIndex": "{sizeIndex}"
          }
        },
        "color": [
          {
            "relationship": {
              "property": "content-color",
              "context": "Section title and chevron"
            }
          },
          {
            "when": { "options": { "isDisabled": true } },
            "relationship": {
              "property": "content-color",
              "context": "Disabled"
            },
            "priority": 10
          }
        ]
      }
    },
    "content": {
      "kind": "box",
      "visibleWhen": { "options": { "isOpen": true } },
      "props": {
        "paddingBlockStart": {
          "relationship": {
            "property": "padding-top",
            "context": "Content (top)"
          }
        },
        "paddingBlockEnd": {
          "relationship": {
            "property": "padding-bottom",
            "context": "Content (bottom)"
          }
        }
      }
    },
    "divider": {
      "kind": "box",
      "visibleWhen": { "options": { "isQuiet": false } },
      "props": {
        "height": { "value": 1 },
        "fill": {
          "token": {
            "property": "color",
            "colorFamily": "gray",
            "scaleIndex": 200
          }
        }
      }
    }
  }
}
