{
  "$schema": "https://opensource.adobe.com/spectrum-design-data/schemas/v0/component-visual.schema.json",
  "specVersion": "1.0.0-draft",
  "component": "field-label",
  "root": "container",
  "sizeScale": { "s": 75, "m": 100, "l": 200, "xl": 300 },
  "notVisual": ["labelPosition", "staticColor"],
  "parts": {
    "container": {
      "kind": "box",
      "children": ["label", "necessity-indicator"],
      "props": {
        "direction": { "value": "row" },
        "align": { "value": "start" },
        "minHeight": {
          "relationship": { "property": "minimum-height", "part": "container" }
        },
        "gap": [
          {
            "relationship": {
              "property": "space-between",
              "between": { "from": "label", "to": "necessity-indicator" }
            }
          }
        ]
      }
    },
    "label": {
      "kind": "text",
      "text": { "option": "label" },
      "props": {
        "overflow": { "value": "wrap" },
        "typeStyle": {
          "relationship": { "property": "type-style", "part": "label" }
        },
        "lineHeight": {
          "relationship": { "property": "line-height", "part": "label" }
        },
        "color": {
          "relationship": {
            "property": "content-color",
            "context": "Label and asterisk icon"
          }
        }
      }
    },
    "necessity-indicator": {
      "kind": "icon",
      "icon": {
        "set": "ui",
        "name": "asterisk"
      },
      "props": {
        "width": [
          {
            "relationship": {
              "property": "size",
              "context": "Asterisk UI icon asset"
            }
          }
        ],
        "height": [
          {
            "relationship": {
              "property": "size",
              "context": "Asterisk UI icon asset"
            }
          }
        ],
        "color": {
          "relationship": {
            "property": "content-color",
            "context": "Label and asterisk icon"
          }
        }
      }
    }
  }
}
