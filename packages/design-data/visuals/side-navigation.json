{
  "$schema": "https://opensource.adobe.com/spectrum-design-data/schemas/v0/component-visual.schema.json",
  "specVersion": "1.0.0-draft",
  "component": "side-navigation",
  "root": "container",
  "sizeScale": {
    "m": 100
  },
  "notVisual": ["selectionMode"],
  "parts": {
    "container": {
      "kind": "box",
      "children": ["section-header", "item"],
      "repeat": {
        "slot": "default",
        "label": "label",
        "with": {
          "isSelected": "isSelected",
          "isDisabled": "isDisabled"
        }
      },
      "props": {
        "direction": {
          "value": "column"
        },
        "align": {
          "value": "start"
        },
        "width": {
          "relationship": {
            "property": "width",
            "part": "container"
          }
        },
        "gap": {
          "relationship": {
            "property": "space-between",
            "part": "container",
            "between": {
              "from": "item",
              "to": "item"
            }
          }
        }
      }
    },
    "section-header": {
      "kind": "text",
      "text": {
        "option": "sectionTitle"
      },
      "props": {
        "fontFamily": {
          "relationship": {
            "property": "font-family",
            "part": "label"
          }
        },
        "fontSize": {
          "relationship": {
            "property": "font-size",
            "part": "section-header"
          }
        },
        "fontWeight": {
          "relationship": {
            "property": "font-weight",
            "part": "section-header"
          }
        },
        "lineHeight": {
          "relationship": {
            "property": "line-height",
            "part": "label"
          }
        },
        "color": {
          "relationship": {
            "property": "color",
            "part": "section-header"
          }
        }
      }
    },
    "item": {
      "kind": "box",
      "children": ["row", "selection-indicator"],
      "props": {
        "direction": {
          "value": "stack"
        },
        "align": {
          "value": "center"
        },
        "minHeight": {
          "relationship": {
            "property": "minimum-height",
            "part": "item"
          }
        },
        "justify": {
          "value": "start"
        }
      }
    },
    "row": {
      "kind": "box",
      "children": ["icon", "label"],
      "props": {
        "direction": {
          "value": "row"
        },
        "align": {
          "value": "center"
        },
        "paddingInlineStart": {
          "relationship": {
            "property": "space-between",
            "part": "item",
            "between": {
              "from": "start-edge",
              "to": "label"
            }
          }
        },
        "paddingInlineEnd": {
          "relationship": {
            "property": "space-between",
            "part": "item",
            "between": {
              "from": "end-edge",
              "to": "label"
            }
          }
        },
        "gap": {
          "relationship": {
            "property": "space-between",
            "part": "item",
            "between": {
              "from": "icon",
              "to": "label"
            }
          }
        }
      }
    },
    "icon": {
      "kind": "icon",
      "icon": {
        "set": "workflow",
        "name": "add",
        "content": true,
        "optional": true
      },
      "props": {
        "width": {
          "relationship": {
            "property": "size",
            "part": "icon"
          }
        },
        "height": {
          "relationship": {
            "property": "size",
            "part": "icon"
          }
        },
        "color": [
          {
            "relationship": {
              "property": "content-color",
              "part": "item"
            }
          }
        ]
      }
    },
    "label": {
      "kind": "text",
      "props": {
        "fontFamily": {
          "relationship": {
            "property": "font-family",
            "part": "label"
          }
        },
        "fontSize": {
          "relationship": {
            "property": "font-size",
            "part": "label"
          }
        },
        "fontWeight": {
          "relationship": {
            "property": "font-weight",
            "part": "label"
          }
        },
        "lineHeight": {
          "relationship": {
            "property": "line-height",
            "part": "label"
          }
        },
        "color": [
          {
            "relationship": {
              "property": "content-color",
              "part": "item"
            }
          }
        ]
      }
    },
    "selection-indicator": {
      "kind": "box",
      "props": {
        "width": {
          "relationship": {
            "property": "thickness",
            "part": "selection-indicator"
          }
        },
        "height": {
          "relationship": {
            "property": "height",
            "part": "selection-indicator"
          }
        },
        "fill": {
          "relationship": {
            "property": "color",
            "part": "selection-indicator",
            "attribute": "background"
          }
        }
      }
    }
  }
}
