{
  "$schema": "https://opensource.adobe.com/spectrum-design-data/schemas/v0/component.schema.json",
  "$id": "https://opensource.adobe.com/spectrum-design-data/schemas/v0/components/body.json",
  "specVersion": "1.0.0-draft",
  "name": "body",
  "displayName": "Body",
  "description": "Body is a typography component primarily used within Spectrum components and for blocks of text.",
  "meta": {
    "category": "typography",
    "documentationUrl": "https://spectrum.adobe.com/page/body/"
  },
  "options": {
    "script": {
      "$ref": "https://opensource.adobe.com/spectrum-design-data/schemas/types/typography-script.json"
    },
    "classification": {
      "$ref": "https://opensource.adobe.com/spectrum-design-data/schemas/types/typography-classification.json"
    },
    "size": {
      "type": "string",
      "pattern": "^(x{0,2}s|m|x{0,3}l)$",
      "default": "m",
      "values": [
        {
          "value": "xxs"
        },
        {
          "value": "xs"
        },
        {
          "value": "s"
        },
        {
          "value": "m"
        },
        {
          "value": "l"
        },
        {
          "value": "xl"
        },
        {
          "value": "xxl"
        },
        {
          "value": "xxxl"
        }
      ]
    }
  },
  "anatomy": [
    {
      "name": "text",
      "description": "Text run styled by the typography token set.",
      "required": true
    }
  ],
  "anatomyReview": {
    "status": "reviewed",
    "reviewedIn": "1.0.0-draft",
    "notes": "No Figma component; the style exists only as text styles (Figma), a font macro value (React Spectrum) and one Typography stylesheet (SWC). One explicit root part, text; margins are properties of it. Owner decision D1 (2026-11-19): keep five components."
  },
  "lifecycle": {
    "introduced": "1.0.0-draft"
  },
  "accessibility": {
    "focusable": false
  }
}
