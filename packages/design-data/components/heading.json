{
  "$schema": "https://opensource.adobe.com/spectrum-design-data/schemas/v0/component.schema.json",
  "$id": "https://opensource.adobe.com/spectrum-design-data/schemas/v0/components/heading.json",
  "specVersion": "1.0.0-draft",
  "name": "heading",
  "displayName": "Heading",
  "description": "Heading is a typography component used to create various levels of hierarchies between text.",
  "meta": {
    "category": "typography",
    "documentationUrl": "https://spectrum.adobe.com/page/heading/"
  },
  "options": {
    "script": {
      "$ref": "https://opensource.adobe.com/spectrum-design-data/schemas/types/typography-script.json"
    },
    "classification": {
      "$ref": "https://opensource.adobe.com/spectrum-design-data/schemas/types/typography-classification.json"
    },
    "weight": {
      "type": "string",
      "default": "default",
      "values": [
        {
          "value": "light"
        },
        {
          "value": "default"
        },
        {
          "value": "heavy"
        }
      ]
    },
    "size": {
      "type": "string",
      "default": "m",
      "values": [
        {
          "value": "xxs",
          "lifecycle": {
            "deprecatedIn": "13.0.0"
          }
        },
        {
          "value": "xs"
        },
        {
          "value": "s"
        },
        {
          "value": "m"
        },
        {
          "value": "l"
        },
        {
          "value": "xl"
        },
        {
          "value": "xxl"
        },
        {
          "value": "xxxl"
        },
        {
          "value": "xxxxl"
        }
      ]
    },
    "emphasis": {
      "type": "string",
      "description": "Emphasis of the text run: emphasized is italic, strong is bolder, and the two combine. Unset is the regular style.",
      "values": [
        {
          "value": "emphasized"
        },
        {
          "value": "heavy"
        },
        {
          "value": "heavy-emphasized"
        },
        {
          "value": "heavy-strong"
        },
        {
          "value": "heavy-strong-emphasized"
        },
        {
          "value": "light",
          "lifecycle": {
            "deprecatedIn": "13.0.0"
          }
        },
        {
          "value": "light-emphasized",
          "lifecycle": {
            "deprecatedIn": "13.0.0"
          }
        },
        {
          "value": "light-strong",
          "lifecycle": {
            "deprecatedIn": "13.0.0"
          }
        },
        {
          "value": "light-strong-emphasized",
          "lifecycle": {
            "deprecatedIn": "13.0.0"
          }
        },
        {
          "value": "strong"
        },
        {
          "value": "strong-emphasized"
        }
      ]
    },
    "family": {
      "type": "string",
      "default": "sans-serif",
      "description": "Typeface family of the text run.",
      "values": [
        {
          "value": "sans-serif"
        },
        {
          "value": "serif"
        }
      ]
    }
  },
  "anatomy": [
    {
      "name": "container",
      "description": "Root of the component: the block that holds the text run.",
      "required": true,
      "contains": ["text"]
    },
    {
      "name": "text",
      "description": "Text run styled by the typography token set.",
      "required": true
    }
  ],
  "anatomyReview": {
    "status": "reviewed",
    "reviewedIn": "1.0.0-draft",
    "notes": "No Figma component; the style exists only as text styles (Figma), a font macro value (React Spectrum) and one Typography stylesheet (SWC). Keep five components, one family. The text part holds the type style; margins are properties of it. The container part is a recipe-drawing root: the engine needs a box root and a root text part draws nothing, so the part owns only recipe alignment values; a spec change to allow a recipe-only root is tracked separately."
  },
  "lifecycle": {
    "introduced": "1.0.0-draft"
  },
  "accessibility": {
    "focusable": false
  }
}
